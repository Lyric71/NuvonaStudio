---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Footer from '../components/Footer.astro';
import { getAlternateUrl, pageLangs, useTranslations, type Lang, type UiKey } from '../i18n/index';
import { articleMetaFromPath, articleSchemaFromPath } from '../i18n/schemas';

interface Props {
  title?: string;
  description?: string;
  abstract?: string;
  lang?: Lang;
  preloadHero?: string;
  // Responsive variants of preloadHero; must match the <img> srcset/sizes.
  preloadHeroSrcset?: string;
  preloadHeroSizes?: string;
  ogImage?: string;
  schemas?: Record<string, unknown>[];
  robots?: string;
  // 404 page: noindex, and no canonical, hreflang or breadcrumbs.
  notFound?: boolean;
}

const {
  title = 'Nuvora Studio | LinkedIn Marketing Agency for B2B',
  description = 'Specialist LinkedIn-only consultancy for B2B companies. We build presences that generate pipeline, attract decision-makers, and establish lasting authority. One platform. Absolute focus.',
  abstract,
  lang = 'en',
  preloadHero,
  preloadHeroSrcset,
  preloadHeroSizes,
  ogImage: ogImageProp,
  schemas = [],
  robots: robotsProp = 'index, follow',
  notFound = false,
} = Astro.props;
const robots = notFound ? 'noindex, follow' : robotsProp;

const SITE = 'https://www.nuvora.studio';
const currentPath = Astro.url.pathname;
const articleMeta = notFound ? null : articleMetaFromPath(currentPath);
// Share images live in public/og/ as 1200x630 JPEGs (skipped by the WebP
// optimizer, since social platforms don't all accept WebP).
const ogImage = ogImageProp ?? articleMeta?.image ?? '/og/default.jpg';
const heroType = preloadHero?.endsWith('.svg') ? 'image/svg+xml' : 'image/webp';
// No-trailing-slash policy site-wide (matches astro.config trailingSlash: 'never'
// and the sitemap serialize). The bare root keeps its slash, as in the sitemap.
const canonicalUrl = `${SITE}${currentPath.replace(/\/$/, '') || '/'}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE}${ogImage}`;

const ogLocaleMap: Record<Lang, string> = {
  en: 'en_US',
  fr: 'fr_FR',
  de: 'de_DE',
  es: 'es_ES',
  zh: 'zh_CN',
};

const homeLabel: Record<Lang, string> = {
  en: 'Home',
  fr: 'Accueil',
  de: 'Startseite',
  es: 'Inicio',
  zh: '首页',
};

// The languages this page exists in (every one, but for the help center).
const pageLanguages = pageLangs(currentPath);
const alternateLangs = pageLanguages.map((l) => ({
  lang: l,
  href: `${SITE}${getAlternateUrl(currentPath, l)}`,
}));

const otherLocales = pageLanguages
  .filter((l) => l !== lang)
  .map((l) => ogLocaleMap[l]);

// ── BreadcrumbList ────────────────────────────────────────────────────────────
// Section crumbs reuse the nav/footer labels; the leaf of an article or case
// study falls back to the page title without the brand suffix.
const t = useTranslations(lang);
const crumbLabelKeys: Record<string, UiKey> = {
  services: 'nav.services',
  'services/content': 'nav.content',
  'services/advertising': 'nav.advertising',
  'services/consulting': 'nav.consulting',
  pricing: 'nav.pricing',
  work: 'nav.work',
  insights: 'nav.insights',
  about: 'nav.about',
  'linkedin-optimizer': 'nav.optimizer',
  contact: 'footer.contact',
  privacy: 'footer.privacy',
  terms: 'footer.terms',
  cookies: 'footer.cookies',
};
// The help center exists in English, French and Chinese only (no UI key).
const helpCrumb: Partial<Record<Lang, string>> = { en: 'Help center', fr: 'Centre d’aide', zh: '帮助中心' };
const pageName = title.replace(/\s*[|｜]\s*(?:Nuvora Studio|Nuvora Help|Aide Nuvora|Nuvora 帮助中心)\s*$/, '');
const segments = currentPath.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const breadcrumbItems: Record<string, unknown>[] = [
  {
    '@type': 'ListItem',
    position: 1,
    name: homeLabel[lang],
    item: `${SITE}${lang === 'en' ? '/' : '/' + lang}`,
  },
];
{
  let acc = lang === 'en' ? '' : '/' + lang;
  // If first segment is the lang prefix, skip it (already covered by Home)
  const crumbSegs = segments[0] === lang ? segments.slice(1) : segments;
  crumbSegs.forEach((seg, i) => {
    acc += '/' + seg;
    const canonical = getAlternateUrl(acc, 'en').replace(/^\//, '');
    const key = crumbLabelKeys[canonical];
    const helpHome = canonical === 'help' ? helpCrumb[lang] : undefined;
    const isLeaf = i === crumbSegs.length - 1;
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: breadcrumbItems.length + 1,
      name: key ? t(key) : helpHome ?? (isLeaf ? pageName : decodeURIComponent(seg).replace(/-/g, ' ')),
      item: `${SITE}${acc}`,
    });
  });
}

// ── Schema @graph ─────────────────────────────────────────────────────────────
const organizationNode = {
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: 'Nuvora Studio',
  url: SITE,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE}/images/nuvora-logo-large.webp`,
    width: 850,
    height: 306,
  },
  image: `${SITE}/og/default.jpg`,
  description:
    'Specialist LinkedIn-only B2B marketing agency. Strategy, content, ads, and executive branding for B2B teams that want pipeline.',
  founder: {
    '@type': 'Person',
    '@id': `${SITE}/about#cyril-drouin`,
    name: 'Cyril Drouin',
  },
  sameAs: ['https://www.linkedin.com/company/nuvorastudio'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    url: `${SITE}/contact`,
    availableLanguage: ['English', 'French', 'German', 'Spanish', 'Chinese'],
  },
  parentOrganization: {
    '@type': 'Organization',
    name: 'Beyond Border Group',
    url: 'https://www.beyondbordergroup.org',
  },
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: SITE,
  name: 'Nuvora Studio',
  publisher: { '@id': `${SITE}/#organization` },
  inLanguage: ['en', 'fr', 'de', 'es', 'zh-CN'],
};

const breadcrumbNode =
  !notFound && breadcrumbItems.length > 1
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonicalUrl}#breadcrumbs`,
        itemListElement: breadcrumbItems,
      }
    : null;

const articleNode = articleSchemaFromPath(currentPath, title, description, lang, ogImage);

const graph: Record<string, unknown>[] = [organizationNode, websiteNode];
if (breadcrumbNode) graph.push(breadcrumbNode);
if (articleNode) graph.push(articleNode);
if (schemas.length) graph.push(...schemas);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': graph,
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0a1633" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Nuvora Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={articleMeta ? 'article' : 'website'} />
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.datePublished} />
        <meta property="article:modified_time" content={articleMeta.dateModified ?? articleMeta.datePublished} />
      </>
    )}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocaleMap[lang]} />
    {otherLocales.map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />

    {!notFound && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        {alternateLangs.map(({ lang: l, href }) => (
          <link rel="alternate" hreflang={l === 'zh' ? 'zh-CN' : l} href={href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={`${SITE}${getAlternateUrl(currentPath, 'en')}`} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preload critical fonts (self-hosted, no external requests) -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-700-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Preload LCP hero image so the browser discovers it immediately */}
    {preloadHero && <link rel="preload" href={preloadHero} as="image" type={heroType} fetchpriority="high" imagesrcset={preloadHeroSrcset} imagesizes={preloadHeroSizes} />}

    {abstract && <meta name="abstract" content={abstract} />}

    <!-- Structured data -->
    <script is:inline type="application/ld+json" set:html={jsonLd} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <Footer lang={lang} />
    <Analytics />

    <!-- Scroll-reveal observer -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -60px 0px' }
      );

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
