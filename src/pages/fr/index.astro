---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import FAQ from '../../components/FAQ.astro';
import Testimonials from '../../components/Testimonials.astro';

const painPoints = [
  {
    stat: '3 %',
    label: 'des entreprises B2B postent régulièrement sur LinkedIn',
    detail: 'Les autres publient une fois, lèvent le pied, puis s\'étonnent du silence radio.',
  },
  {
    stat: '0',
    label: 'dirigeant avec une vraie présence',
    detail: 'La plupart des profils de direction ressemblent à des CV. Forcément, ça ne donne envie à personne d\'engager la conversation.',
  },
  {
    stat: '72 %',
    label: 'du budget pub LinkedIn part à la poubelle',
    detail: 'Mauvais ciblage, mauvais format, mauvais tunnel. Sans structure, l\'enveloppe fond à vue d\'œil.',
  },
];

const services = [
  {
    title: 'Contenu',
    tag: 'Organique',
    body: 'On pilote votre page, on décline tous les formats que LinkedIn propose et on publie au rythme qu\'il faut pour que votre marque reste visible. Pendant ce temps, vos équipes gardent la tête dans leur métier.',
    href: '/fr/services/contenu',
    subs: [
      'Pilotage de la page entreprise',
      'Production éditoriale et ligne directrice',
      'Newsletter LinkedIn',
      'Événements LinkedIn',
    ],
  },
  {
    title: 'Publicité',
    tag: 'Payant',
    body: 'Du contenu sponsorisé aux formulaires de captation, on conçoit et pilote des campagnes qui parlent aux bons décideurs et les font basculer en prospects. C\'est la partie de LinkedIn que la plupart des entreprises laissent dormir.',
    href: '/fr/services/publicite',
    subs: [
      'Architecture de campagne',
      'Ciblage d\'audience',
      'Création publicitaire et rédaction',
      'Reporting branché à votre CRM',
    ],
  },
  {
    title: 'Conseil',
    tag: 'Stratégie',
    body: 'Formation, visibilité du dirigeant et programmes d\'employés ambassadeurs : on transforme vos équipes en premier relais commercial sur LinkedIn.',
    href: '/fr/services/conseil',
    subs: [
      'Employés ambassadeurs',
      'Visibilité du dirigeant',
      'Ateliers de formation',
      'Audit de stratégie LinkedIn',
    ],
  },
];

const steps = [
  {
    title: 'Audit et stratégie',
    body: 'On passe au crible votre présence LinkedIn, votre concurrence et vos cibles. Vous repartez avec une feuille de route claire et des actions à mettre en œuvre. Pas un document générique à mettre dans un tiroir.',
    detail: 'Semaine 1-2',
  },
  {
    title: 'Mise en place et lancement',
    body: 'On retravaille les profils, on installe la machine éditoriale et on déclenche les premières campagnes. Rien ne part en ligne sans votre feu vert.',
    detail: 'Semaine 3-4',
  },
  {
    title: 'Croissance et suivi',
    body: 'Reporting mensuel sur les indicateurs définis ensemble. On accélère ce qui rapporte, on coupe ce qui ne sert à rien. Pas de chiffres décoratifs.',
    detail: 'En continu',
  },
];

const pillars = [
  {
    title: 'Spécialistes, pas touche-à-tout',
    body: 'Tout ce qu\'on fait tourne autour de LinkedIn. L\'algorithme, les formats, le ciblage, le ton qui accroche : c\'est notre terrain de jeu unique.',
    metric: '100 %',
    metricLabel: 'consacré à LinkedIn',
  },
  {
    title: 'Du contenu qui retient l\'attention',
    body: 'On écrit pour vos acheteurs, pas pour vous faire plaisir. Des publications B2B claires, directes, qui se lisent et qui poussent à passer à l\'action.',
    metric: '3,2x',
    metricLabel: 'd\'engagement en moyenne',
  },
  {
    title: 'La transparence par défaut',
    body: 'Pas de reporting flou, pas de marge cachée. Vous savez ce qu\'on fait, ce que ça coûte et pourquoi on a fait ce choix.',
    metric: '0',
    metricLabel: 'frais cachés',
  },
  {
    title: 'L\'IA en coulisses, l\'humain aux commandes',
    body: 'On s\'appuie sur l\'IA pour aller plus vite et produire davantage. Mais aucun contenu ne quitte le studio sans repasser entre nos mains.',
    metric: '100 %',
    metricLabel: 'validé par un humain',
  },
];

const industries = [
  { label: 'Tech et SaaS' },
  { label: 'Industrie et fabrication' },
  { label: 'Services professionnels' },
  { label: 'Santé et sciences du vivant' },
  { label: 'Services financiers' },
  { label: 'Logistique et supply chain' },
];

const posts = [
  {
    category: 'Stratégie LinkedIn',
    tags: ['Algorithme', 'Portée'],
    title: "Pourquoi votre portée a fondu de moitié en 2026 (et le contenu n'y est pour rien)",
    excerpt: "LinkedIn a remplacé tout son moteur de classement par 360Brew. La portée a chuté de 50 %, les pages entreprise ont perdu 60 %. Le problème n'est pas ce que vous publiez : c'est le système qui a changé de logique.",
    date: '2026-03-29',
    slug: 'pourquoi-votre-portee-a-chute',
    image: '/blog/hero-reach-dropped.svg',
  },
  {
    category: 'Stratégie LinkedIn',
    tags: ['Contenu', 'Prospects'],
    title: "Faire de votre contenu LinkedIn un canal de prospects (et plus seulement de vues)",
    excerpt: "Faire des vues sans générer le moindre prospect, c'est de l'énergie qui part en fumée. L'inbound convertit à 14,6 %, l'outbound à 1,7 %. Voilà comment remettre votre stratégie dans le bon sens.",
    date: '2026-03-29',
    slug: 'du-contenu-aux-prospects-entrants',
    image: '/blog/hero-ads-vs-organic.svg',
  },
  {
    category: 'Publicité LinkedIn',
    tags: ['Publicité', 'Mesure'],
    title: "Pourquoi vos pubs LinkedIn ont l'air d'un gouffre (c'est la mesure, pas la campagne)",
    excerpt: "LinkedIn affiche 121 % de ROAS en B2B. Sauf que le cycle d'achat moyen dure 272 jours. Quand on mesure à 30 jours, le tableau de bord raconte n'importe quoi.",
    date: '2026-03-29',
    slug: 'probleme-mesure-roi-publicite-linkedin',
    image: '/blog/hero-ads-cost.svg',
  },
];

const faqs = [
  { q: "Où sont vos clients ?", a: "Un peu partout. Europe, Amérique du Nord, Asie, parfois plus loin. LinkedIn est une plateforme mondiale, on travaille à l'avenant." },
  { q: "Vraiment rien d'autre que LinkedIn ?", a: "Vraiment. Pas de SEO, pas d'Instagram, pas de formule « agence à tout faire ». LinkedIn point. C'est cette spécialisation qui fait la différence sur les résultats." },
  { q: "Combien faut-il prévoir pour démarrer ?", a: "Notre formule Foundation démarre à 1 500 €/mois. Stratégie, contenu et reporting compris. La plupart des clients commencent là, puis montent en gamme.", link: { text: 'Voir tous les tarifs →', href: '/fr/tarifs' } },
  { q: "C'est réservé aux grands comptes ?", a: "Non. À 1 500 €/mois, vous avez une présence LinkedIn pilotée de bout en bout : c'est à la portée d'une PME comme d'une scale-up. Et si l'accompagnement complet est trop tôt, on propose aussi de la formation et du pilotage publicitaire à la carte." },
  { q: "La publicité est-elle incluse ?", a: "Non, c'est toujours une ligne à part. Certains clients ne font que du contenu organique, d'autres uniquement de la pub, la plupart combinent les deux. Le budget média part directement sur votre compte LinkedIn, jamais par notre intermédiaire." },
  { q: "Comment mesurez-vous les résultats ?", a: "Au démarrage, on définit les indicateurs ensemble : prospects générés, croissance de l'audience, coût par prospect, contribution au pipeline. Chaque mois, vous recevez un reporting clair sur ces points. Pas une liste de vues et de likes qui ne veulent rien dire." },
];

---

<Layout
  lang="fr"
  title="Nuvora Studio | L'agence B2B 100 % LinkedIn"
  description="Agence LinkedIn dédiée au B2B. Contenu, publicité, visibilité des dirigeants et formation. Une seule plateforme, un seul métier."
  abstract="L'agence B2B spécialisée LinkedIn. On bâtit des présences qui génèrent des prospects et qui installent une vraie crédibilité. Une seule plateforme."
  preloadHero="/images/hero-notification.webp"
  preloadHeroSrcset="/images/hero-notification-640.webp 640w, /images/hero-notification-1024.webp 1024w, /images/hero-notification.webp 1408w"
  preloadHeroSizes="100vw"
>
  <NavBar lang="fr" />
  <main id="main-content">

    <!-- ═══════════════════════════ 1. HERO ═══════════════════════════ -->
    <section class="hero" aria-labelledby="hero-heading">
      <img src="/images/hero-notification.webp" srcset="/images/hero-notification-640.webp 640w, /images/hero-notification-1024.webp 1024w, /images/hero-notification.webp 1408w" sizes="100vw" alt="" aria-hidden="true" class="hero__bg" fetchpriority="high" decoding="async" width="1408" height="768" />
      <div class="hero__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="hero__content">
          <p class="eyebrow eyebrow--light hero__anim">L'agence B2B 100 % LinkedIn</p>
          <h1 id="hero-heading" class="hero__h1 hero__anim hero__anim--1">
            On fait de LinkedIn votre <span class="text-gradient">premier canal de prospection.</span>
          </h1>
          <p class="hero__sub hero__anim hero__anim--2">
            Stratégie, contenu et publicité. Uniquement sur LinkedIn.
            On aide les entreprises B2B à exister, à installer leur crédibilité et à générer des prospects qualifiés.
          </p>
          <div class="hero__actions hero__anim hero__anim--3">
            <a href="/fr/contact?intent=call" class="btn btn--primary btn--lg">Réserver un appel stratégique</a>
            <a href="/fr/services" class="btn btn--outline-white btn--lg">Voir nos services</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════ 2. PROBLEM STATEMENT ═══════════════════════════ -->
    <section class="section problem" aria-labelledby="problem-heading">
      <div class="container">

        <div class="problem__hero reveal">
          <div class="problem__head">
            <p class="eyebrow eyebrow--light">Le problème</p>
            <h2 id="problem-heading">
              La plupart des entreprises B2B<br />sont invisibles sur LinkedIn.
            </h2>
            <p class="problem__sub">
              Elles postent quand elles y pensent. Leur page entreprise est figée depuis deux ans. Leurs dirigeants n'ont aucune présence.
              Leurs pubs s'adressent aux mauvaises personnes. LinkedIn récompense la régularité et l'expertise. Sans ces deux ingrédients,
              vous laissez passer le meilleur canal B2B disponible aujourd'hui.
            </p>
          </div>

          <div class="problem__visual">
            <img
              src="/images/problem-linkedin.webp"
              alt="Comparaison côte à côte de deux écrans : à gauche des notifications LinkedIn vides avec zéro impression et des statistiques plates, à droite un flux de demandes de connexion, de nouveaux prospects et 12 400 de portée"
              class="problem__img"
              width="760"
              height="760"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="problem__grid">
          {painPoints.map((p, i) => (
            <div class="problem__card reveal" style={`transition-delay: ${i * 0.1}s`}>
              <p class="problem__stat">{p.stat}</p>
              <p class="problem__label">{p.label}</p>
              <p class="problem__detail">{p.detail}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════ 3. SERVICES GRID ═══════════════════════════ -->
    <section id="services" class="section" style="background: var(--off-white);" aria-labelledby="services-heading">
      <div class="container">

        <div class="services__head reveal">
          <div>
            <p class="eyebrow">Ce qu'on fait</p>
            <h2 id="services-heading">Tout ce qu'il faut<br />pour exister sur LinkedIn.</h2>
          </div>
          <p class="services__intro">
            En toute transparence. La stratégie, l'audit et le suivi sont compris dans chaque mission, jamais facturés en supplément.
          </p>
        </div>

        <div class="services__grid">
          {services.map((s, i) => (
            <a href={s.href} class="services__card reveal" style={`transition-delay: ${i * 0.08}s`}>
              <div class="services__card-top">
                <span class="tag tag--cyan">{s.tag}</span>
                <span class="services__arrow" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M4.5 15.5L15.5 4.5M15.5 4.5H7.5M15.5 4.5V12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
              {s.title === 'Contenu' ? (
                <div class="services__vis services__vis--content" aria-hidden="true">
                  <img src="/images/content-calendar-v2.webp" alt="" width="480" height="270" loading="lazy" />
                </div>
              ) : s.title === 'Publicité' ? (
                <div class="services__vis services__vis--content" aria-hidden="true">
                  <img src="/images/ad-creative-stack.webp" alt="" width="480" height="270" loading="lazy" />
                </div>
              ) : s.title === 'Conseil' ? (
                <div class="services__vis services__vis--content" aria-hidden="true">
                  <img src="/images/consulting-workshop.webp" alt="" width="480" height="270" loading="lazy" />
                </div>
              ) : (
                <div class="vis-placeholder services__vis" aria-hidden="true">
                  <span>Visuel provisoire</span>
                </div>
              )}
              <h3 class="services__card-title">{s.title}</h3>
              <p class="services__card-desc">{s.body}</p>
              <ul class="services__subs">
                {s.subs.map(sub => (
                  <li class="services__sub">{sub}</li>
                ))}
              </ul>
            </a>
          ))}
        </div>

        <div class="services__foot reveal">
          <a href="/fr/services" class="btn btn--outline btn--lg">Voir tous les services</a>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════ 4. HOW WE WORK ═══════════════════════════ -->
    <section class="section" style="background: var(--deep-navy);" aria-labelledby="process-heading">
      <div class="container">

        <div class="process__head reveal">
          <p class="eyebrow eyebrow--light">Comment ça se passe</p>
          <h2 id="process-heading" style="color: var(--white);">
            De l'audit aux prospects,<br /><em style="color: rgba(255,255,255,0.35); font-weight: 300;">en trois étapes.</em>
          </h2>
        </div>

        <div class="process__grid">
          {steps.map((s, i) => (
            <div class="process__step reveal" style={`transition-delay: ${i * 0.1}s`}>
              <div class="process__line-horizontal" aria-hidden="true"></div>
              <div class="process__content">
                <span class="process__detail">{s.detail}</span>
                <h3 class="process__title">{s.title}</h3>
                <p class="process__body">{s.body}</p>
              </div>
              {s.title === 'Audit & Stratégie' ? (
                <div class="process__vis process__vis--img" aria-hidden="true">
                  <img src="/images/audit-strategy.webp" alt="" width="600" height="375" loading="lazy" />
                </div>
              ) : s.title === 'Construction & Lancement' ? (
                <div class="process__vis process__vis--img" aria-hidden="true">
                  <img src="/images/build-launch.webp" alt="" width="600" height="375" loading="lazy" />
                </div>
              ) : s.title === 'Croissance & Suivi' ? (
                <div class="process__vis process__vis--img" aria-hidden="true">
                  <img src="/images/grow-report.webp" alt="" width="600" height="375" loading="lazy" />
                </div>
              ) : (
                <div class="vis-placeholder process__vis" aria-hidden="true">
                  <span>Visuel provisoire</span>
                </div>
              )}
            </div>
          ))}
        </div>

        <div class="process__cta reveal" style="transition-delay: 0.3s">
          <a href="/fr/tarifs" class="btn btn--outline-white btn--lg">Voir les tarifs</a>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════ 5. WHAT SETS US APART ═══════════════════════════ -->
    <section class="section" aria-labelledby="apart-heading">
      <div class="container">
        <div class="apart__layout">

          <div class="apart__left">
            <div class="apart__head reveal">
              <p class="eyebrow">Pourquoi nous</p>
              <h2 id="apart-heading">On fait une seule chose.<br />LinkedIn.</h2>
              <div class="accent-bar"></div>
              <p class="apart__lead">
                On n'est pas une agence digitale généraliste qui propose « aussi » du LinkedIn.
                LinkedIn, c'est tout ce qu'on fait. Et c'est précisément ce qui change tout.
              </p>
            </div>

            <!-- Visual: comparison graphic -->
            <div class="apart__visual reveal reveal-delay-1" aria-hidden="true">
              <div class="apart__visual-inner">
                <div class="apart__vis-compare">
                  <div class="apart__vis-col apart__vis-col--them">
                    <span class="apart__vis-label">Agences généralistes</span>
                    <div class="apart__vis-bars">
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 30%"></div></div>
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 25%"></div></div>
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 20%"></div></div>
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 35%"></div></div>
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 15%"></div></div>
                    </div>
                  </div>
                  <div class="apart__vis-divider"></div>
                  <div class="apart__vis-col apart__vis-col--us">
                    <span class="apart__vis-label">Nuvora Studio</span>
                    <div class="apart__vis-bars">
                      <div class="apart__vis-item"><span class="apart__vis-dot"></span><div class="apart__vis-bar" style="width: 100%"></div></div>
                    </div>
                    <span class="apart__vis-tag">100 % LinkedIn</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="apart__right">
            <div class="apart__grid">
              {pillars.map((p, i) => (
                <div class="apart__card reveal" style={`transition-delay: ${i * 0.08}s`}>
                  <div class="apart__card-metric">
                    <span class="apart__metric-value">{p.metric}</span>
                    <span class="apart__metric-label">{p.metricLabel}</span>
                  </div>
                  <div class="apart__card-body">
                    <div class="apart__card-header">
                      <h3 class="apart__title">{p.title}</h3>
                    </div>
                    <p class="apart__body">{p.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════ 6. TESTIMONIALS ═══════════════════════════ -->
    <Testimonials
      eyebrow="Ils nous font confiance"
      heading="Ce qu'en disent nos clients"
      sub="Des collaborations orientées résultats, aux côtés d'équipes B2B de tous secteurs."
      items={[
        { text: "Nuvora a complètement changé notre présence LinkedIn. En six mois, 40 % de nos prospects venaient du canal. Avant, on le laissait dormir.", image: "https://randomuser.me/api/portraits/women/32.jpg", name: "Sophie Laurent", role: "Directrice marketing, éditeur SaaS" },
        { text: "Ils ne se contentent pas de publier. Ils ont compris nos cycles d'achat B2B. Les profils de nos dirigeants sont passés de dormants à générateurs de conversations entrantes.", image: "https://randomuser.me/api/portraits/men/45.jpg", name: "Marcus Webb", role: "Directeur commercial, industrie tech" },
        { text: "La transparence, voilà ce qui change tout. Chaque mois, on sait exactement ce qui fonctionne, ce qui cale et où passe le budget. Aucune autre agence ne nous avait donné ce niveau de lecture.", image: "https://randomuser.me/api/portraits/women/28.jpg", name: "Priya Sharma", role: "Responsable marketing, fintech" },
        { text: "On a essayé trois agences avant Nuvora. La différence ? Ils maîtrisent vraiment l'algorithme LinkedIn et la façon dont les décideurs B2B se comportent sur la plateforme.", image: "https://randomuser.me/api/portraits/men/22.jpg", name: "David Chen", role: "PDG, cabinet de conseil" },
        { text: "Notre budget pub LinkedIn est passé du gouffre à des prospects qualifiés à moitié prix. L'architecture de campagne qu'ils ont posée est d'une efficacité redoutable.", image: "https://randomuser.me/api/portraits/women/44.jpg", name: "Emma Bergström", role: "Responsable digital, industrie" },
        { text: "Ce qui les distingue, c'est la qualité du contenu. Chaque publication a notre voix, pas celle d'une agence. C'est rare quand on externalise du contenu B2B.", image: "https://randomuser.me/api/portraits/men/36.jpg", name: "James Okafor", role: "Fondateur, services professionnels" },
        { text: "De la stratégie à l'exécution, ils prennent tout en main. On est passés d'une publication par mois à une vraie présence : page entreprise, profils dirigeants, publicité. Et tout l'écosystème tient debout.", image: "https://randomuser.me/api/portraits/women/51.jpg", name: "Ana Rodriguez", role: "Directrice marketing, santé" },
        { text: "Nuvora nous a aidés à monter un programme d'employés ambassadeurs qui a transformé nos commerciaux en voix de référence. L'effet sur la prospection a été net et mesurable.", image: "https://randomuser.me/api/portraits/men/53.jpg", name: "Ravi Patel", role: "Directeur de la croissance, éditeur logiciel" },
        { text: "Ce qui m'a le plus impressionnée, c'est le pilotage. De vrais indicateurs commerciaux, des chiffres de prospection. Pas une liste de vues et de mentions j'aime. On sait enfin ce que LinkedIn apporte au business.", image: "https://randomuser.me/api/portraits/women/19.jpg", name: "Laura Koenig", role: "Directrice des opérations, logistique" },
      ]}
    />

    <!-- ═══════════════════════════ 7. INDUSTRIES ═══════════════════════════ -->
    <section class="section" aria-labelledby="industries-heading">
      <div class="container">
        <div class="industries__layout">

          <div class="industries__text reveal">
            <p class="eyebrow">Avec qui on travaille</p>
            <h2 id="industries-heading">Pensé pour le B2B,<br /><em>tous secteurs confondus.</em></h2>
            <div class="accent-bar"></div>
            <p class="industries__body">
              On accompagne des entreprises de toutes tailles, du grand groupe installé à la PME en pleine accélération, sur des marchés et des géographies très différents.
            </p>
            <p class="industries__body">
              Si vos acheteurs sont sur LinkedIn et que vous n'arrivez pas à les capter, on devrait en discuter.
            </p>
            <a href="/fr/contact" class="btn btn--primary" style="margin-top: var(--sp-6);">
              Échangeons
            </a>
          </div>

          <div class="industries__right reveal reveal-delay-2">
            <div class="industries__visual" aria-hidden="true">
              <img src="/images/global-connections.webp" alt="" width="480" height="270" loading="lazy" />
            </div>
            <div class="industries__grid" aria-label="Secteurs que nous servons">
              {industries.map(ind => (
                <div class="industries__item">
                  <span class="industries__dot" aria-hidden="true"></span>
                  <span class="industries__label">{ind.label}</span>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════ 8. INSIGHTS PREVIEW ═══════════════════════════ -->
    <section class="section" style="background: var(--off-white);" aria-labelledby="insights-heading">
      <div class="container">

        <div class="insights__head reveal">
          <div>
            <p class="eyebrow">Sur le blog</p>
            <h2 id="insights-heading">L'intelligence LinkedIn,<br /><em>noir sur blanc.</em></h2>
          </div>
          <p class="insights__sub">
            Des analyses de fond sur la stratégie LinkedIn, le contenu B2B, la publicité et l'évolution de la plateforme.
            Écrites par des praticiens, pas par une usine à articles.
          </p>
        </div>

        <div class="insights__grid">
          {posts.map((post, i) => (
            <article class="insights__card reveal" style={`transition-delay: ${i * 0.08}s`}>
              {post.image ? (
                <div class="insights__thumb insights__thumb--img" style={`background-image: url('${post.image}')`} aria-hidden="true"></div>
              ) : (
                <div class="vis-placeholder insights__thumb" aria-hidden="true">
                  <span>Visuel provisoire</span>
                </div>
              )}
              <div class="insights__card-top">
                <div class="insights__tags">
                  {post.tags.map(t => <span class="insights__tag">{t}</span>)}
                </div>
              </div>
              <h3 class="insights__title">
                <a href={`/fr/publications/${post.slug}`}>{post.title}</a>
              </h3>
              <p class="insights__excerpt">{post.excerpt}</p>
              <a href={`/fr/publications/${post.slug}`} class="insights__read">
                Lire la suite
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </article>
          ))}
        </div>

        <div class="text-center reveal" style="margin-top: var(--sp-10);">
          <a href="/fr/publications" class="btn btn--outline btn--lg">Tous les articles</a>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════ 9. FAQ ═══════════════════════════ -->
    <FAQ heading="Les questions qui reviennent." faqs={faqs} footer="Une autre question ?" footerLink={{ text: 'Écrivez-nous', href: '/fr/contact' }} id="faq-fr" />

    <!-- ═══════════════════════════ 10. CONTACT CTA ═══════════════════════════ -->
    <section class="section cta" aria-labelledby="cta-heading" style="background: var(--deep-navy);">
      <div class="container">
        <div class="cta__layout">

          <div class="cta__left reveal">
            <p class="eyebrow eyebrow--light">Par où commencer</p>
            <h2 id="cta-heading" class="cta__headline">
              Posons les bases<br />
              <em>de votre présence LinkedIn.</em>
            </h2>
          </div>

          <div class="cta__right reveal reveal-delay-2">
            <p class="cta__sub">
              Que vous partiez d'une page blanche ou que vous vouliez faire décoller ce qui existe déjà, on commence toujours par comprendre votre contexte. Pas de pitch commercial, pas de slides. Une conversation, c'est tout.
            </p>
            <div class="cta__actions">
              <a href="/fr/contact?intent=call" class="btn btn--primary btn--lg">Caler un appel de 30 minutes</a>
              <a href="/fr/contact" class="btn btn--outline-white btn--lg">Nous écrire</a>
            </div>
            <p class="cta__note">30 minutes. Zéro baratin. Des réponses directes.</p>
          </div>

        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--sp-32) var(--sp-24);
    min-height: 520px;
    display: flex;
    align-items: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(15,23,42, 0.88) 0%,
      rgba(15,23,42, 0.55) 50%,
      rgba(15,23,42, 0.20) 100%
    );
    z-index: 1;
  }

  .hero__content {
    max-width: 680px;
  }

  .hero__h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.10;
    letter-spacing: -0.02em;
    margin-block: var(--sp-5) var(--sp-6);
  }
  .hero__h1 .text-gradient {
    background: linear-gradient(135deg, var(--cyan) 0%, var(--sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__sub {
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.68);
    max-width: 520px;
    line-height: 1.75;
    margin-bottom: var(--sp-10);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero__anim { animation: heroFadeUp 0.7s var(--ease, ease) both; }
  .hero__anim--1 { animation-delay: 0.06s; }
  .hero__anim--2 { animation-delay: 0.14s; }
  .hero__anim--3 { animation-delay: 0.22s; }
  /* The h1 is the LCP text: slide it in without starting invisible. */
  @keyframes heroRise {
    from { transform: translateY(20px); }
    to   { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__h1.hero__anim { animation-name: heroRise; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__anim { animation: none; opacity: 1; transform: none; }
  }

  @media (max-width: 640px) {
    .hero { padding-block: var(--sp-16) var(--sp-12); }
  }

  /* ═══════════════════════════════════════════════════════════
     PROBLEM STATEMENT
     ═══════════════════════════════════════════════════════════ */
  .problem {
    background: var(--deep-navy);
  }

  /* ── Hero row ── */
  .problem__hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-12);
    align-items: center;
    margin-bottom: var(--sp-16);
  }

  .problem__head {
    max-width: 540px;
  }

  .problem__head :global(.eyebrow) {
    color: var(--cyan);
  }

  .problem__head :global(h2) {
    color: var(--white);
    margin-bottom: var(--sp-6);
  }

  .problem__sub {
    font-size: var(--fs-md);
    color: var(--navy-text-2);
    line-height: 1.75;
  }

  /* ── Visual ── */
  .problem__visual {
    border-radius: var(--r-xl);
    overflow: hidden;
  }

  .problem__img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Stat cards ── */
  .problem__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-6);
  }

  .problem__card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--r-xl);
    padding: var(--sp-8);
    transition: all var(--t-base);
  }

  .problem__card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateY(-3px);
  }

  .problem__stat {
    font-family: var(--font-display);
    font-size: var(--fs-5xl);
    font-weight: 700;
    line-height: 1;
    color: var(--cyan);
    margin-bottom: var(--sp-4);
    letter-spacing: -0.03em;
  }

  .problem__label {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--white);
    line-height: 1.3;
    margin-bottom: var(--sp-4);
    letter-spacing: -0.01em;
  }

  .problem__detail {
    font-size: var(--fs-sm);
    color: var(--navy-text-2);
    line-height: 1.7;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .problem__hero {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .problem__head { max-width: 660px; margin-inline: auto; }
    .problem__visual { max-width: 480px; margin-inline: auto; }
    .problem__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .problem__grid { grid-template-columns: 1fr; }
    .problem__stat { font-size: var(--fs-4xl); }
  }

  /* ═══════════════════════════════════════════════════════════
     SERVICES GRID
     ═══════════════════════════════════════════════════════════ */
  .services__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-12);
    align-items: end;
    margin-bottom: var(--sp-12);
  }

  .services__intro {
    font-size: var(--fs-md);
    color: var(--text-2);
    line-height: 1.7;
    max-width: 400px;
    align-self: flex-end;
    padding-bottom: 6px;
  }

  /* ── Card grid ── */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-6);
    margin-bottom: var(--sp-12);
  }

  /* ── Card ── */
  .services__card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: var(--sp-8);
    transition: all var(--t-base);
    text-decoration: none;
    color: inherit;
  }

  .services__card:hover {
    border-color: var(--border-2);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .services__card:hover .services__arrow {
    background: var(--deep-navy);
    color: var(--white);
    border-color: var(--deep-navy);
  }

  .services__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-6);
  }

  .services__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-3);
    transition: all var(--t-base);
    flex-shrink: 0;
  }

  /* ── Visual ── */
  .services__vis {
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 120px;
    margin-bottom: var(--sp-6);
    border-radius: var(--r-lg);
    background: var(--off-white);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .services__vis--content {
    background: none;
    border: none;
    padding: 0;
  }

  .services__vis--content img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-lg);
  }

  .services__vis span {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .services__card-title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: var(--sp-4);
  }

  .services__card-desc {
    font-size: var(--fs-sm);
    color: var(--text-2);
    line-height: 1.75;
    margin-bottom: var(--sp-6);
  }

  /* ── Sub-services list ── */
  .services__subs {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: auto;
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
  }

  .services__sub {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-2);
    letter-spacing: 0.02em;
    padding-left: var(--sp-4);
    position: relative;
  }

  .services__sub::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cyan);
  }

  .services__foot { text-align: center; }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .services__head { grid-template-columns: 1fr; gap: var(--sp-6); }
    .services__intro { max-width: 100%; }
    .services__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .services__grid { grid-template-columns: 1fr; }
  }

  /* ═══════════════════════════════════════════════════════════
     HOW WE WORK
     ═══════════════════════════════════════════════════════════ */
  .process__head {
    text-align: center;
    max-width: 580px;
    margin-inline: auto;
    margin-bottom: var(--sp-16);
  }

  .process__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-8);
    margin-bottom: var(--sp-12);
    align-items: start;
  }

  .process__step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .process__line-horizontal {
    height: 1px;
    background: linear-gradient(to right, rgba(6, 182, 212, 0.25), transparent);
    margin-bottom: var(--sp-2);
  }

  .process__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    flex: 1;
  }

  .process__detail {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .process__title {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--white);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .process__body {
    font-size: var(--fs-sm);
    color: var(--navy-text-2);
    line-height: 1.75;
  }

  .process__vis {
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 100px;
    margin-top: auto;
    border-radius: var(--r-lg);
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .process__vis--img {
    background: none;
    border: none;
    padding: 0;
  }

  .process__vis--img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-lg);
  }

  .process__vis span {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.12);
  }

  .process__cta { text-align: center; }

  @media (max-width: 768px) {
    .process__grid { grid-template-columns: 1fr; gap: var(--sp-10); }
    .process__line-horizontal { display: none; }
  }

  /* ═══════════════════════════════════════════════════════════
     WHAT SETS US APART
     ═══════════════════════════════════════════════════════════ */
  .apart__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-12);
    align-items: start;
  }

  .apart__left {
    position: sticky;
    top: calc(var(--sp-24));
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .apart__lead {
    font-size: var(--fs-md);
    color: var(--text-2);
    line-height: 1.75;
  }

  /* ── Comparison visual ── */
  .apart__visual {
    background: var(--off-white);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    overflow: hidden;
  }

  .apart__visual-inner {
    padding: var(--sp-8);
  }

  .apart__vis-compare {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .apart__vis-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .apart__vis-label {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .apart__vis-col--us .apart__vis-label {
    color: var(--sky);
  }

  .apart__vis-bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .apart__vis-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apart__vis-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--cyan);
    flex-shrink: 0;
  }
  .apart__vis-dot--muted {
    background: var(--border-2);
  }

  .apart__vis-bar {
    height: 6px;
    background: var(--gradient-accent);
    border-radius: 3px;
  }
  .apart__vis-bar--muted {
    background: var(--border);
    opacity: 0.6;
  }

  .apart__vis-divider {
    height: 1px;
    background: var(--border);
  }

  .apart__vis-tag {
    display: inline-block;
    width: fit-content;
    padding: 3px 10px;
    border-radius: var(--r-full);
    background: rgba(14,165,233,0.08);
    color: var(--sky);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  /* ── Cards grid ── */
  .apart__grid {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .apart__card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    overflow: hidden;
    transition: all var(--t-base);
  }

  .apart__card:hover {
    border-color: var(--border-2);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .apart__card-metric {
    background: var(--off-white);
    padding: var(--sp-5) var(--sp-8);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .apart__metric-value {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 700;
    color: var(--sky);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .apart__metric-label {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .apart__card-body {
    padding: var(--sp-5) var(--sp-8) var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .apart__card-header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .apart__title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .apart__body {
    font-size: var(--fs-sm);
    color: var(--text-2);
    line-height: 1.75;
  }

  @media (max-width: 1024px) {
    .apart__layout { grid-template-columns: 1fr; }
    .apart__left { position: static; }
  }

  /* ═══════════════════════════════════════════════════════════
     INDUSTRIES
     ═══════════════════════════════════════════════════════════ */
  .industries__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    align-items: center;
  }

  .industries__body {
    font-size: var(--fs-md);
    color: var(--text-2);
    line-height: 1.75;
    margin-bottom: var(--sp-4);
  }

  .industries__right { display: flex; flex-direction: column; gap: var(--sp-6); }

  .industries__visual {
    width: 100%;
    flex-shrink: 0;
    border-radius: var(--r-xl);
    overflow: hidden;
  }

  .industries__visual img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--r-xl);
  }

  .industries__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
  }

  .industries__item {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-5);
    background: var(--off-white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    transition: all var(--t-base);
  }
  .industries__item:hover {
    border-color: var(--border-2);
    background: var(--white);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .industries__item:hover .industries__dot { background: var(--sky); }

  .industries__dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    flex-shrink: 0;
    transition: background var(--t-fast);
  }

  .industries__label {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text);
    letter-spacing: 0.01em;
  }

  @media (max-width: 1024px) {
    .industries__layout { grid-template-columns: 1fr; gap: var(--sp-10); }
  }
  @media (max-width: 480px) {
    .industries__grid { grid-template-columns: 1fr; }
  }

  /* ═══════════════════════════════════════════════════════════
