---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Pricing1 from '../../components/ui/Pricing.astro';
import FAQ from '../../components/FAQ.astro';

/* ── Formules d'accompagnement ── */
const plans = [
  { name: 'Foundation', popular: false, price: '1 500 €', href: '/fr/contact?intent=retainer&tier=foundation' },
  { name: 'Growth', popular: true, price: '3 000 €', href: '/fr/contact?intent=retainer&tier=growth' },
  { name: 'Scale', popular: false, price: '5 250 €', href: '/fr/contact?intent=retainer&tier=scale' },
];

const features = [
  { label: 'Tarif mensuel',                foundation: '1 500 €', growth: '3 000 €', scale: '5 250 €' },
  { label: 'Audit et mise en route',       foundation: '✓', growth: '✓', scale: '✓' },
  { label: 'Stratégie éditoriale',         foundation: '✓', growth: '✓', scale: '✓' },
  { label: 'Publications par mois',        foundation: '4', growth: '8', scale: '16' },
  { label: 'Visuels générés par IA',       foundation: '✓', growth: '✓', scale: '✓' },
  { label: 'Animation de la communauté',   foundation: '✓', growth: '✓', scale: '✓' },
  { label: 'Pilotage des publicités LinkedIn', foundation: '-', growth: '✓', scale: '✓' },
  { label: 'Persona acheteur et ciblage',  foundation: '-', growth: '✓', scale: '✓' },
  { label: 'Veille concurrentielle',       foundation: '-', growth: '✓', scale: '✓' },
  { label: 'Reporting de performance',     foundation: '✓', growth: '✓', scale: '✓' },
  { label: 'Point stratégique hebdomadaire', foundation: '✓', growth: '✓', scale: '✓' },
  { label: 'Interlocuteur dédié',          foundation: 'Chef de projet', growth: 'Chef de projet', scale: 'Référent senior' },
  { label: 'Support par messagerie L-V',   foundation: '✓', growth: '✓', scale: '✓' },
];

/* ── Comparatif Ads ── */
const adsFeatures = [
  { label: 'Honoraires mensuels',                    foundation: '1 300 €/mois', growth: '6 à 10 % du budget' },
  { label: 'Stratégie publicitaire complète',        foundation: '✓', growth: '✓' },
  { label: 'Campagnes et annonces illimitées',       foundation: '✓', growth: '✓' },
  { label: 'Accompagnement expert sans limite',      foundation: '✓', growth: '✓' },
  { label: 'Reporting personnalisé',                 foundation: '✓', growth: '✓' },
  { label: 'Recommandations de création publicitaire', foundation: '✓', growth: '✓' },
  { label: 'Points hebdomadaires',                   foundation: '-', growth: '✓' },
  { label: 'Analyse de performance',                 foundation: '-', growth: '✓' },
  { label: 'Micro-ciblage avancé',                   foundation: '-', growth: '✓' },
  { label: 'Remises sur volume',                     foundation: '-', growth: '✓' },
];

/* ── Tableaux simples ── */
const execServices = [
  { service: 'Optimisation du profil dirigeant (prestation ponctuelle)', price: '450 € par profil' },
  { service: 'Plume du dirigeant (4 publications/mois + maintien du profil)', price: '1 050 €/mois et par dirigeant' },
];

const contentServices = [
  { service: 'Vidéo générée par IA (5 à 30 secondes)', price: 'De 180 € à 4 500 € par vidéo' },
  { service: 'Tournage vidéo professionnel', price: 'Devis sur mesure' },
  { service: 'Contenu multilingue', price: 'Devis par langue' },
];

const trainingServices = [
  { service: 'Atelier LinkedIn (2 heures)', price: '2 200 € la session' },
  { service: 'Parcours de formation équipe (4 sessions)', price: '7 000 € forfaitaires' },
  { service: 'Programme employés ambassadeurs', price: '2 200 €/mois' },
];

const bonusServices = [
  { model: 'Prime sur objectif de prospection', percent: '+15 %', structure: 'du forfait mensuel quand les objectifs de prospection sont atteints. Suppose un budget publicitaire LinkedIn actif.' },
  { model: 'Prime sur croissance d\'audience', percent: '+10 %', structure: 'du forfait mensuel si les objectifs trimestriels de croissance d\'audience sont dépassés. Un budget publicitaire LinkedIn actif est requis.' },
];

/* ── FAQ ── */
const faqs = [
  {
    q: "Qu'est-ce qui est compris dans le tarif ?",
    a: "Tout ce qui est listé dans votre formule : stratégie, contenu, visuels, animation de communauté, reporting, point hebdomadaire, interlocuteur dédié. Le seul coût en sus, c'est le budget pub LinkedIn, débité directement sur votre compte, pas le nôtre.",
  },
  {
    q: 'Pourquoi un engagement de 3 mois ?',
    a: "LinkedIn ne donne aucun résultat du jour au lendemain. Il faut le temps d'auditer votre page, de poser une stratégie, de publier sans accroc et de laisser l'algorithme faire son travail. Trois mois, c'est le strict minimum pour voir un vrai mouvement.",
  },
  {
    q: 'Peut-on changer de formule en cours de route ?',
    a: "Oui, sans problème. Une fois les 3 premiers mois passés, vous pouvez monter ou descendre d'une formule à chaque nouveau cycle de facturation.",
  },
  {
    q: 'Garantissez-vous un nombre précis de prospects ?',
    a: "Non. Et franchement, méfiez-vous de quiconque le promet. On s'engage à faire le travail proprement : stratégie, contenu, ciblage, semaine après semaine. Avec l'option prime de performance, on ne gagne davantage que si les objectifs fixés ensemble sont atteints.",
  },
  {
    q: 'Que recouvre la ligne « persona acheteur et ciblage » ?',
    a: "C'est le portrait-robot de votre acheteur idéal. On identifie vos meilleurs prospects (poste, secteur, taille d'entreprise, géographie) et on bâtit contenu et campagnes autour de ce profil. Inclus dans Growth et Scale.",
  },
  {
    q: 'Comment se facture le budget publicitaire ?',
    a: "Vous payez LinkedIn directement depuis votre propre compte publicitaire. Nous, on pilote les campagnes. Votre argent ne transite jamais par nous, c'est aussi simple que ça.",
  },
  {
    q: 'Peut-on prendre la prestation « plume du dirigeant » sans formule mensuelle ?',
    a: "Oui. C'est une prestation indépendante : optimisation du profil, rédaction des publications, ou les deux. Aucune formule à souscrire à côté.",
  },
  {
    q: 'Combien coûte la prime de performance si l\'objectif n\'est pas atteint ?',
    a: "Rien. La prime ne se déclenche que quand on atteint ou dépasse les objectifs définis ensemble. En dessous, vous payez votre forfait, point final.",
  },
  {
    q: "Quelle est la vraie différence entre Foundation et Growth ?",
    a: "Foundation vous installe une présence : contenu régulier et animation de communauté. Growth, c'est le palier où la prospection démarre vraiment : publicité, ciblage, veille concurrentielle et deux fois plus de contenu. Pour générer des prospects, c'est par Growth qu'il faut commencer.",
  },
  {
    q: 'Que se passe-t-il après les 3 mois ?',
    a: "Vous basculez au mois par mois. Vous restez, vous changez de formule ou vous résiliez avec 30 jours de préavis. Aucune pénalité.",
  },
];
---

<Layout
  lang="fr"
  title="Tarifs LinkedIn pour entreprises B2B | Nuvora Studio"
  description="Nos tarifs LinkedIn en clair. Trois formules d'accompagnement, pilotage publicitaire, visibilité du dirigeant et formation. Des offres conçues pour générer davantage de prospects."
  abstract="Tarifs LinkedIn pour le B2B. Trois formules de 1 500 € à 5 250 €/mois. Publicité LinkedIn, visibilité du dirigeant et formation en complément."
>
  <NavBar lang="fr" />
  <main id="main-content">

    <!-- ═══ HERO ═══ -->
    <section class="pricing-hero" aria-labelledby="pricing-heading">
      <div class="pricing-hero__bg" aria-hidden="true"></div>
      <div class="pricing-hero__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="pricing-hero__content">
          <p class="eyebrow eyebrow--light reveal">Tarifs</p>
          <h1 id="pricing-heading" class="pricing-hero__title reveal reveal-delay-1">
            Un seul cap : vous apporter davantage de <span class="text-gradient">prospects via LinkedIn.</span>
          </h1>
          <p class="pricing-hero__sub reveal reveal-delay-2">
            Choisissez la formule calée sur votre point de départ. La stratégie, le contenu,
            le reporting et un interlocuteur dédié sont compris dans chacune. Aucun frais caché.
            Aucun engagement au-delà des trois premiers mois.
          </p>
          <div class="pricing-hero__actions reveal reveal-delay-3">
            <a href="#retainer" class="btn btn--primary btn--lg">Voir les formules</a>
            <a href="/fr/contact?intent=call" class="btn btn--outline-white btn--lg">Caler un rendez-vous</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ FORMULES D'ACCOMPAGNEMENT ═══ -->
    <section class="section" id="retainer" aria-labelledby="retainer-heading">
      <div class="container">
        <div class="s-head reveal">
          <p class="eyebrow">Nos formules d'accompagnement</p>
          <h2 id="retainer-heading">Pilotage mensuel de votre présence LinkedIn</h2>
          <p class="s-head__sub">Toutes les formules démarrent par un engagement minimum de 3 mois.</p>
        </div>

        <div class="reveal reveal-delay-1">
          <Pricing1 plans={plans} features={features} ctaLabel="Caler un rendez-vous" popularLabel="La plus demandée" periodLabel="/mois" />
        </div>

        <div class="tier-cards reveal reveal-delay-2">
          <div class="tier-card">
            Avec <strong>Foundation</strong>, vous posez les fondations : une présence LinkedIn régulière, bien construite, prête à monter en puissance.
          </div>
          <div class="tier-card tier-card--pop">
            <strong>Growth</strong>, c'est là que la prospection démarre pour de bon. Publicité, ciblage, deux fois plus de contenu. Notre formule la plus demandée, et ce n'est pas un hasard.
          </div>
          <div class="tier-card">
            <strong>Scale</strong>, c'est pour les entreprises qui veulent y aller franchement : 16 publications par mois, un référent senior à demeure, et tous nos services synchronisés.
          </div>
        </div>

        <p class="s-footnote reveal">
          Vous hésitez entre les formules ? <a href="/fr/contact?intent=call">Prenez rendez-vous</a> et on en discute ensemble.
        </p>
      </div>
    </section>

    <!-- ═══ VISIBILITÉ DU DIRIGEANT ═══ -->
    <section class="section exec-section" aria-labelledby="exec-heading">
      <div class="exec-section__bg" aria-hidden="true"></div>
      <div class="exec-section__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="exec-split">
          <div class="exec-split__text reveal">
            <p class="eyebrow">En complément ou en autonomie</p>
            <h2 id="exec-heading">Visibilité du dirigeant</h2>
            <p class="s-head__sub">
              La page de votre entreprise raconte une histoire. Vos dirigeants en racontent une autre. Avant de vous contacter, les acheteurs lisent les deux.
            </p>
            <p class="s-head__note">
              C'est une prestation indépendante, pensée pour les dirigeants qui veulent bâtir leur propre voix sur LinkedIn.
              Elle fonctionne seule ou en complément de n'importe quelle formule.
            </p>
          </div>
          <div class="exec-split__cards reveal reveal-delay-1">
            {execServices.map(row => (
              <div class="exec-card">
                <p class="exec-card__label">{row.service}</p>
                <p class="exec-card__price">{row.price}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ GESTION DE LA PUBLICITÉ LINKEDIN ═══ -->
    <section class="section" aria-labelledby="ads-heading">
      <div class="container">
        <div class="s-head reveal">
          <p class="eyebrow">Offre indépendante</p>
          <h2 id="ads-heading">Pilotage des publicités LinkedIn</h2>
          <p class="s-head__sub">
            Pour les entreprises qui veulent un pilotage publicitaire expert sans souscrire à une formule complète.
            Le budget média est facturé séparément, directement sur votre compte LinkedIn.
          </p>
          <p class="s-head__note">Les deux niveaux supposent un engagement de 3 mois et des frais de mise en route de 1 300 €.</p>
        </div>

        <div class="ads-table reveal">
          <div class="ads-table__scroll">
            <table aria-label="Comparatif tarifs publicité LinkedIn">
              <thead>
                <tr>
                  <th class="ads-table__corner"></th>
                  <th class="ads-table__col-head">Budget média &lt; 13 000 €/mois</th>
                  <th class="ads-table__col-head">Budget média &gt; 13 000 €/mois</th>
                </tr>
              </thead>
              <tbody>
                {adsFeatures.map((row, i) => (
                  <tr class={i === 0 ? 'ads-table__row--price' : ''}>
                    <td class="ads-table__label">{row.label}</td>
                    <td class="ads-table__val">
                      {row.foundation === '✓' ? (
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-label="Inclus"><path d="M4 9.5l3.5 3.5L14 6" stroke="var(--blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      ) : row.foundation === '-' ? (
                        <span class="ads-table__dash">-</span>
                      ) : (
                        <strong>{row.foundation}</strong>
                      )}
                    </td>
                    <td class="ads-table__val">
                      {row.growth === '✓' ? (
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-label="Inclus"><path d="M4 9.5l3.5 3.5L14 6" stroke="var(--blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      ) : row.growth === '-' ? (
                        <span class="ads-table__dash">-</span>
                      ) : (
                        <strong>{row.growth}</strong>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ GRANDS COMPTES ═══ -->
    <section class="section section--dark enterprise" aria-labelledby="enterprise-heading">
      <div class="enterprise__bg" aria-hidden="true"></div>
      <div class="enterprise__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">

        <div class="ent-top reveal">
          <p class="eyebrow eyebrow--light">Sur mesure</p>
          <h2 id="enterprise-heading" class="ent-top__title">Grands comptes</h2>
          <p class="ent-top__lead">
            Pour les entreprises internationales qui ont besoin que LinkedIn tourne sur plusieurs marchés, équipes et langues.
          </p>
        </div>

        <div class="ent-intro reveal">
          <p>
            Nos formules standards couvrent l'immense majorité des entreprises B2B. Mais certaines organisations ont besoin d'aller plus loin. Plusieurs régions.
            Des dizaines de profils dirigeants. Du contenu en quatre langues. Des campagnes publicitaires lancées en parallèle
            sur l'Asie-Pacifique, l'Europe et les Amériques.
          </p>
          <p>L'offre Grands comptes est taillée pour ça.</p>
          <p>
            On bâtit un périmètre d'intervention calé sur votre organisation. Pas une offre type à laquelle on colle votre nom.
            Chaque mission démarre par un appel pour comprendre vos objectifs, vos marchés, qui fait quoi en interne
            et comment vous fonctionnez au quotidien.
          </p>
        </div>

        <div class="ent-grid">
          <!-- Ce dont les grands comptes ont généralement besoin -->
          <div class="ent-block reveal">
            <h3 class="ent-block__title">Ce dont les grands comptes ont besoin, en général</h3>
            <ul class="ent-list" role="list">
              <li>Stratégie LinkedIn multi-marchés couvrant plusieurs régions et langues</li>
              <li>Calendriers éditoriaux synchronisés entre pages entreprise et profils dirigeants</li>
              <li>Programmes employés ambassadeurs à grande échelle</li>
              <li>Un interlocuteur unique, stratège senior, qui chapeaute tout</li>
              <li>Pilotage des publicités LinkedIn sur plusieurs comptes et plusieurs devises</li>
              <li>Production de contenu multilingue, par des gens qui connaissent le marché, pas seulement la langue</li>
              <li>Tableaux de bord personnalisés calés sur vos indicateurs de performance</li>
              <li>Points trimestriels avec votre direction</li>
            </ul>
          </div>

          <!-- Fonctionnement des tarifs + À qui ça s'adresse -->
          <div class="ent-block reveal reveal-delay-1">
            <h3 class="ent-block__title">Le tarif, en pratique</h3>
            <div class="ent-block__text">
              <p>
                L'offre Grands comptes se construit au cas par cas. Pas de prix de catalogue, parce que deux programmes ne se ressemblent jamais.
                Le tarif dépend du nombre de marchés, de profils, du volume de contenu, des comptes publicitaires et des langues couvertes.
              </p>
              <p class="ent-price-range">
                La plupart des accompagnements Grands comptes démarrent entre <strong>9 000 € et 22 000 € par mois.</strong>
                Certains montent au-dessus. Dans tous les cas, vous recevez une proposition détaillée ligne à ligne avant de signer. Aucune surprise.
              </p>
            </div>

            <h3 class="ent-block__title" style="margin-top: var(--sp-10);">À qui ça s'adresse</h3>
            <ul class="ent-list" role="list">
              <li>Entreprises internationales présentes dans plusieurs pays</li>
              <li>Organisations en conquête de nouveaux marchés, tous secteurs confondus</li>
              <li>Entreprises pour lesquelles LinkedIn est un canal stratégique, pas un dossier secondaire</li>
            </ul>
          </div>
        </div>

        <div class="ent-cta reveal">
          <p class="ent-cta__text">Si la formule standard ne suffit plus, c'est le bon moment pour en parler.</p>
          <a href="/fr/contact?intent=enterprise" class="btn btn--primary btn--lg">Échanger sur un dossier Grands comptes</a>
        </div>

      </div>
    </section>

    <!-- ═══ CONTENU + FORMATION ═══ -->
    <section class="section" style="background: var(--off-white);" aria-labelledby="addons-heading">
      <div class="container">
        <div class="s-head reveal" style="text-align: center; max-width: 640px; margin-inline: auto;">
          <p class="eyebrow">Services complémentaires</p>
          <h2 id="addons-heading">Contenu, formation et programme ambassadeurs</h2>
          <p class="s-head__sub" style="margin-inline: auto;">
            Les publications rédigées, les visuels générés par IA et les supports graphiques sont compris dans toutes les formules.
            Ces services sont aussi disponibles à la carte.
          </p>
        </div>

        <div class="addon-grid">
          <!-- Production de contenu -->
          <div class="addon-col reveal">
            <h3 class="addon-col__title">Production de contenu</h3>
            {contentServices.map(row => (
              <div class="addon-item">
                <p class="addon-item__name">{row.service}</p>
                <p class="addon-item__price">{row.price}</p>
              </div>
            ))}
          </div>

          <!-- Séparateur -->
          <div class="addon-divider" aria-hidden="true"></div>

          <!-- Formation -->
          <div class="addon-col reveal reveal-delay-1">
            <h3 class="addon-col__title">Formation et employés ambassadeurs</h3>
            {trainingServices.map(row => (
              <div class="addon-item">
                <p class="addon-item__name">{row.service}</p>
                <p class="addon-item__price">{row.price}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ PRIME DE PERFORMANCE ═══ -->
    <section class="section section--dark" aria-labelledby="bonus-heading">
      <div class="container container--md">
        <div class="s-head reveal" style="text-align: center;">
          <p class="eyebrow eyebrow--light">En option</p>
          <h2 id="bonus-heading" style="color: var(--white);">Prime de performance</h2>
          <p class="s-head__sub" style="color: var(--navy-text-2); margin-inline: auto;">
            Disponible avec les formules Growth et Scale. On indexe une partie de nos honoraires sur les résultats.
            Si les objectifs convenus sont atteints, on touche une prime.
            Sinon, vous ne payez que votre forfait.
          </p>
        </div>

        <div class="bonus-grid">
          {bonusServices.map((b, i) => (
            <div class={`bonus-card reveal reveal-delay-${i + 1}`}>
              <span class="bonus-card__pct">{b.percent}</span>
              <p class="bonus-card__title">{b.model}</p>
              <p class="bonus-card__desc">{b.structure}</p>
              <span class="bonus-card__tag">Growth & Scale</span>
            </div>
          ))}
        </div>

        <p class="s-footnote reveal" style="color: var(--navy-text-3); text-align: center; margin-top: var(--sp-8);">
          Les objectifs se posent ensemble au lancement de la mission et se révisent à chaque trimestre.
        </p>
      </div>
    </section>

    <!-- ═══ MENTION LÉGALE ═══ -->
    <div style="padding: var(--sp-10) 0; background: var(--off-white);">
      <div class="container">
        <p class="s-disclaimer reveal">
          Tous les prix sont indiqués en euros HT. Le budget publicitaire LinkedIn est facturé séparément, directement sur votre compte.
          Des offres sur mesure existent pour les grands comptes.
        </p>
      </div>
    </div>

    <FAQ heading="Les questions qui reviennent sur les tarifs." faqs={faqs} id="pfaq" />

    <ContactCTA lang="fr" />

  </main>
</Layout>

<style>
  /* ═══════════ HERO ═══════════ */
  .pricing-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--sp-32) var(--sp-24);
    min-height: 520px;
    display: flex;
    align-items: center;
  }

  .pricing-hero__bg {
    position: absolute;
    inset: 0;
    background: url('/pricing/hero-pipeline.webp') center center / cover no-repeat;
    z-index: 0;
  }

  .pricing-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(15, 23, 42, 0.94) 0%,
      rgba(15, 23, 42, 0.78) 50%,
      rgba(15, 23, 42, 0.50) 100%
    );
    z-index: 1;
  }

  .pricing-hero__content {
    max-width: 680px;
  }

  .pricing-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.10;
    letter-spacing: -0.02em;
    margin-block: var(--sp-5) var(--sp-6);
  }
  .pricing-hero__title .text-gradient {
    background: linear-gradient(135deg, var(--cyan) 0%, var(--sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .pricing-hero__sub {
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.68);
    max-width: 520px;
    line-height: 1.75;
  }

  .pricing-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-10);
  }

  @media (max-width: 640px) {
    .pricing-hero { padding-block: var(--sp-16) var(--sp-12); }
  }

  /* ── Section visuals ── */
  .section-visual {
    width: 100%;
    height: auto;
    border-radius: var(--r-xl);
    object-fit: cover;
  }

  .section-visual--rounded {
    border-radius: var(--r-xl);
    margin-top: var(--sp-8);
  }

  .retainer-visual,
  .ads-visual,
  .addon-visual,
  .bonus-visual,
  .exec-visual {
    max-width: 820px;
    margin-inline: auto;
    margin-bottom: var(--sp-12);
  }

