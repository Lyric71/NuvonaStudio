---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Pricing1 from '../../components/ui/Pricing.astro';
import FAQ from '../../components/FAQ.astro';

/* ── 月度托管 ── */
const plans = [
  { name: 'Foundation', popular: false, price: '¥9,000', href: '/zh/contact?intent=retainer&tier=foundation' },
  { name: 'Growth', popular: true, price: '¥20,000', href: '/zh/contact?intent=retainer&tier=growth' },
  { name: 'Scale', popular: false, price: '¥30,000', href: '/zh/contact?intent=retainer&tier=scale' },
];

const features = [
  { label: '月度服务费',                  foundation: '¥9,000', growth: '¥20,000', scale: '¥30,000' },
  { label: '主页诊断 + 基础搭建',          foundation: '✓', growth: '✓', scale: '✓' },
  { label: '内容策略制定',                foundation: '✓', growth: '✓', scale: '✓' },
  { label: '每月发布内容数',              foundation: '4 条', growth: '8 条', scale: '16 条' },
  { label: 'AI 视觉素材',                foundation: '✓', growth: '✓', scale: '✓' },
  { label: '评论互动 / 社群运营',          foundation: '✓', growth: '✓', scale: '✓' },
  { label: 'LinkedIn 广告全程代投',        foundation: '·', growth: '✓', scale: '✓' },
  { label: '理想客户画像 + 精准定向',       foundation: '·', growth: '✓', scale: '✓' },
  { label: '竞品动态持续监测',             foundation: '·', growth: '✓', scale: '✓' },
  { label: '月度效果数据报告',             foundation: '✓', growth: '✓', scale: '✓' },
  { label: '每周策略通话',                foundation: '✓', growth: '✓', scale: '✓' },
  { label: '专属对接负责人',              foundation: '客户经理', growth: '客户经理', scale: '资深负责人' },
  { label: '工作日即时响应',              foundation: '✓', growth: '✓', scale: '✓' },
];

/* ── 广告单独托管 ── */
const adsFeatures = [
  { label: '月度服务费',                    foundation: '¥10,000／月（基础档）', growth: '月投放预算高于 $15K 时，按投放额的 6%–10% 收取' },
  { label: '全漏斗广告策略',                foundation: '✓', growth: '✓' },
  { label: '广告组与创意数量不限',            foundation: '✓', growth: '✓' },
  { label: '广告专家随时在线',               foundation: '✓', growth: '✓' },
  { label: '定制化数据报表',                foundation: '✓', growth: '✓' },
  { label: '素材方向给到位',                foundation: '✓', growth: '✓' },
  { label: '每周进度沟通',                  foundation: '·', growth: '✓' },
  { label: '投放效果深度复盘',              foundation: '·', growth: '✓' },
  { label: '细分人群分层策略',              foundation: '·', growth: '✓' },
  { label: '大额投放费率优惠',              foundation: '·', growth: '✓' },
];

/* ── 高管品牌 ── */
const execServices = [
  { service: '高管 LinkedIn 主页优化（一次性交付）', price: '¥3,500／人' },
  { service: '高管内容代笔（每月 4 条内容 + 账号日常维护）', price: '每位高管 $1,200／月' },
];

const contentServices = [
  { service: 'AI 短视频制作（5 秒至 30 秒）', price: '¥1,500–¥35,000／条' },
  { service: '真人团队视频拍摄', price: '按项目单独报价' },
  { service: '多语种内容创作', price: '按语种另行报价' },
];

const trainingServices = [
  { service: 'LinkedIn 实战工作坊（2 小时）', price: '¥17,500／场' },
  { service: '团队专题培训（4 次课）', price: '¥55,000 一口价' },
  { service: '员工影响力计划', price: '¥17,500／月' },
];

const bonusServices = [
  { model: '线索达成奖励', percent: '+15%', structure: '当月跑到约定的线索目标，我们额外收取月服务费的 15%。' },
  { model: '粉丝增长奖励', percent: '+10%', structure: '季度粉丝增长超额完成时，我们额外收取月服务费的 10%。' },
];

/* ── 常见问题 ── */
const faqs = [
  {
    q: '服务费里到底包含什么？',
    a: '你选的那一档方案里写到的，全部都包——策略、内容、视觉设计、账号日常运营、数据报告、每周沟通，外加一位专属对接人。需要额外掏的，就只有 LinkedIn 广告费——那笔钱从你自己的 LinkedIn 账户直接扣，跟我们这边没关系。',
  },
  {
    q: '为什么最少要签 3 个月？',
    a: 'LinkedIn 不是个能立刻见效的渠道。账号梳理、策略制定、内容持续发布——这些都需要时间。3 个月差不多是看到变化的最短周期，再短真就来不及做出名堂。',
  },
  {
    q: '合作开始后还能换方案吗？',
    a: '能。前三个月走完之后，每个计费周期的起点都可以升级或调整。',
  },
  {
    q: '你们能保证具体的线索数量吗？',
    a: '不能。坦白讲，任何敢承诺具体线索数量的服务，都得多打几个问号。我们承诺的是把活做扎实——策略、内容、定向一周接一周地推下去，该有的一样不落。绩效奖金也是这个逻辑：目标达成了我们多拿一笔，达不成你就只付正常的月费。',
  },
  {
    q: '"ICP + 精准定向"具体指什么？',
    a: 'ICP 就是理想客户画像。我们会按职位、行业、公司规模这些维度，把你最核心的目标客户圈出来。圈定完，内容和广告就围着这群人来做。Growth 和 Scale 套餐都自带这一项。',
  },
  {
    q: '广告费怎么走？',
    a: '广告费由你的 LinkedIn 账户直接付给 LinkedIn，我们这边只负责操盘和投放。这笔钱不经过我们的账户。',
  },
  {
    q: '能不能只买代写，不签长期？',
    a: '可以。高管个人品牌相关的服务支持单独购买，不需要绑定长期合作。',
  },
  {
    q: '目标没达成，还需要付绩效奖励吗？',
    a: '不需要。只有目标达成或者超额完成，才会触发奖励；没达标的月份就只收正常的服务费。',
  },
  {
    q: 'Foundation 和 Growth 的核心差别在哪？',
    a: 'Foundation 帮你把基础曝光先建起来；Growth 则进一步靠广告投放、精准定向、竞品追踪以及更高频的内容产出，搭起一台真正的线索增长引擎。',
  },
  {
    q: '三个月之后呢？',
    a: '自动转成按月续约。继续、调整方案、提前 30 天通知终止——三种选择都可以，没有任何违约金。',
  },
];
---

<Layout
  lang="zh"
  title="LinkedIn 服务报价｜Nuvora Studio"
  description="Nuvora Studio LinkedIn 服务的完整报价。三档月度托管套餐，外加广告代投、高管品牌、团队培训等单项服务。价格透明，目标只有一个——把 LinkedIn 真正变成你的销售线索来源。"
  abstract="面向 B2B 企业的 LinkedIn 服务定价。月度托管 ¥9,000 至 ¥30,000。广告代投、高管个人品牌、团队内训另行计价。"
>
  <NavBar lang="zh" />
  <main id="main-content">

    <!-- ═══ HERO ═══ -->
    <section class="pricing-hero" aria-labelledby="pricing-heading">
      <div class="pricing-hero__bg" aria-hidden="true"></div>
      <div class="pricing-hero__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="pricing-hero__content">
          <p class="eyebrow eyebrow--light reveal">价格方案</p>
          <h1 id="pricing-heading" class="pricing-hero__title reveal reveal-delay-1">
            目标只有一个——让 LinkedIn<span class="text-gradient">真的替你带回销售线索。</span>
          </h1>
          <p class="pricing-hero__sub reveal reveal-delay-2">
            按你眼下所处的阶段，挑一档最合适的来用。每一档都自带策略、内容、数据报告和专属对接人。报价没有任何隐藏费用——前三个月走完之后，也不绑长期。
          </p>
          <div class="pricing-hero__actions reveal reveal-delay-3">
            <a href="#retainer" class="btn btn--primary btn--lg">看一下方案</a>
            <a href="/zh/contact?intent=call" class="btn btn--outline-white btn--lg">先约一次沟通</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 月度托管 ═══ -->
    <section class="section" id="retainer" aria-labelledby="retainer-heading">
      <div class="container">
        <div class="s-head reveal">
          <p class="eyebrow">月度托管套餐</p>
          <h2 id="retainer-heading">LinkedIn 按月托管</h2>
          <p class="s-head__sub">三档方案，统一 3 个月起签。</p>
        </div>

        <div class="reveal reveal-delay-1">
          <Pricing1 plans={plans} features={features} ctaLabel="预约沟通" popularLabel="多数客户选这一档" periodLabel="/月" />
        </div>

        <div class="tier-cards reveal reveal-delay-2">
          <div class="tier-card">
            <strong>Foundation</strong>　适合先把 LinkedIn 的底子打扎实、为后续增长打地基的企业。
          </div>
          <div class="tier-card tier-card--pop">
            <strong>Growth</strong>　真正的线索增长，是从这一档开始的——广告投放、精准定向、双倍内容产出。也是大多数客户的选择。
          </div>
          <div class="tier-card">
            <strong>Scale</strong>　适合彻底押注 LinkedIn 的公司：每月 16 条内容、资深负责人挂帅，所有服务一条线协同推进。
          </div>
        </div>

        <p class="s-footnote reveal">
          拿不准选哪档？<a href="/zh/contact?intent=call">先约一次沟通</a>，我们一起把最合适的那条路理清楚。
        </p>
      </div>
    </section>

    <!-- ═══ 高管个人品牌 ═══ -->
    <section class="section exec-section" aria-labelledby="exec-heading">
      <div class="exec-section__bg" aria-hidden="true"></div>
      <div class="exec-section__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="exec-split">
          <div class="exec-split__text reveal">
            <p class="eyebrow">既能搭配套餐，也能单独购买</p>
            <h2 id="exec-heading">高管个人品牌</h2>
            <p class="s-head__sub">
              公司主页传递的是一种信号，高管个人账号传递的是另一种信号。客户在动手联系你之前，这两边基本都会先翻一遍。
            </p>
            <p class="s-head__note">
              这是一项专门为高管设计的独立服务——把他个人在 LinkedIn 上的影响力先做起来。
            </p>
          </div>
          <div class="exec-split__cards reveal reveal-delay-1">
            {execServices.map(row => (
              <div class="exec-card">
                <p class="exec-card__label">{row.service}</p>
                <p class="exec-card__price">{row.price}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 广告单独托管 ═══ -->
    <section class="section" aria-labelledby="ads-heading">
      <div class="container">
        <div class="s-head reveal">
          <p class="eyebrow">独立服务</p>
          <h2 id="ads-heading">LinkedIn 广告代投放</h2>
          <p class="s-head__sub">
            适合需要专业广告操盘、但暂时不需要全套长期服务的企业。广告费用单独计算。
          </p>
          <p class="s-head__note">两档方案统一 3 个月起签，另收一次性 ¥10,000 账户搭建费。</p>
        </div>

        <div class="ads-table reveal">
          <div class="ads-table__scroll">
            <table aria-label="LinkedIn 广告代运营方案对比">
              <thead>
                <tr>
                  <th class="ads-table__corner"></th>
                  <th class="ads-table__col-head">月投放额<br />&lt; ¥100,000</th>
                  <th class="ads-table__col-head">月投放额<br />&gt; ¥100,000</th>
                </tr>
              </thead>
              <tbody>
                {adsFeatures.map((row, i) => (
                  <tr class={i === 0 ? 'ads-table__row--price' : ''}>
                    <td class="ads-table__label">{row.label}</td>
                    <td class="ads-table__val">
                      {row.foundation === '✓' ? (
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-label="包含"><path d="M4 9.5l3.5 3.5L14 6" stroke="var(--blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      ) : row.foundation === '·' ? (
                        <span class="ads-table__dash">·</span>
                      ) : (
                        <strong>{row.foundation}</strong>
                      )}
                    </td>
                    <td class="ads-table__val">
                      {row.growth === '✓' ? (
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-label="包含"><path d="M4 9.5l3.5 3.5L14 6" stroke="var(--blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      ) : row.growth === '·' ? (
                        <span class="ads-table__dash">·</span>
                      ) : (
                        <strong>{row.growth}</strong>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 大客户 ═══ -->
    <section class="section section--dark enterprise" aria-labelledby="enterprise-heading">
      <div class="enterprise__bg" aria-hidden="true"></div>
      <div class="enterprise__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">

        <div class="ent-top reveal">
          <p class="eyebrow eyebrow--light">按需定制</p>
          <h2 id="enterprise-heading" class="ent-top__title">企业级合作</h2>
          <p class="ent-top__lead">
            为那些需要在多个市场、多个团队、多种语言环境下把 LinkedIn 跑通的跨国企业准备。
          </p>
        </div>

        <div class="ent-intro reveal">
          <p>
            标准套餐能覆盖绝大多数 B2B 企业的需求——但总有一些公司摊子铺得很大：几个区域市场同时在动、几十位高管的主页要维护、内容要出四五种语言、广告还得在亚太、欧洲、北美同时跑。
          </p>
          <p>企业级合作就是为这种局面准备的。</p>
          <p>
            整个方案按你的组织架构量身定制——不是拿一份通用模板换上 logo 就交差。正式启动之前，我们会先做一轮深度调研：业务目标、目标市场、内部谁负责哪一块、平时怎么协作——全部摸清楚，再动手。
          </p>
        </div>

        <div class="ent-grid">
          <div class="ent-block reveal">
            <h3 class="ent-block__title">大客户通常需要的是这些</h3>
            <ul class="ent-list" role="list">
              <li>横跨多个区域、多种语言的 LinkedIn 整体策略——不是各干各的</li>
              <li>公司主页和高管主页的发布节奏统一排期，互不冲突</li>
              <li>全球团队层面的员工社交传播方案</li>
              <li>一位资深策略师从头跟到尾，就一个人，不会换来换去</li>
              <li>多个广告账户、多种币种，统一管起来</li>
              <li>多语种内容由懂当地市场的人重新写，而不是把英文版扔进翻译软件</li>
              <li>数据看板按你内部真用的 KPI 来搭，不套模板</li>
              <li>每季度和管理层坐下来复盘一次</li>
            </ul>
          </div>

          <div class="ent-block reveal reveal-delay-1">
            <h3 class="ent-block__title">价格怎么定</h3>
            <div class="ent-block__text">
              <p>
                企业级合作都是一个客户一份报价，没有什么统一的价目表。涉及多少个市场、多少位高管、多大的内容产量、几个广告账户、几种语言——这些加在一起，才能算出价格来。
              </p>
              <p class="ent-price-range">
                企业级合作通常起步在<strong>每月 ¥69,100 至 ¥172,750</strong>，更高的也有。正式开始之前，我们都会给你一份逐项拆开列清的报价单，每一笔都看得明明白白。
              </p>
            </div>

            <h3 class="ent-block__title" style="margin-top: var(--sp-10);">什么样的公司适合</h3>
            <ul class="ent-list" role="list">
              <li>团队分布在多个国家的跨国企业</li>
              <li>正在拓展新市场的企业，行业不限</li>
              <li>真正把 LinkedIn 当作战略级渠道在投的公司——不是发几条动态走个过场</li>
            </ul>
          </div>
        </div>

        <div class="ent-cta reveal">
          <p class="ent-cta__text">标准套餐已经装不下你们的需求？那这个电话迟早得打。</p>
          <a href="/zh/contact?intent=enterprise" class="btn btn--primary btn--lg">预约企业级咨询</a>
        </div>

      </div>
    </section>

    <!-- ═══ 附加服务 ═══ -->
    <section class="section" style="background: var(--off-white);" aria-labelledby="addons-heading">
      <div class="container">
        <div class="s-head reveal" style="text-align: center; max-width: 640px; margin-inline: auto;">
          <p class="eyebrow">单项服务</p>
          <h2 id="addons-heading">内容制作、培训、员工传播</h2>
          <p class="s-head__sub" style="margin-inline: auto;">
            文字帖、AI 视觉素材这些，月度套餐里本就含着。下面这些则是可以按需另外加的项目。
          </p>
        </div>

        <div class="addon-grid">
          <!-- 内容 -->
          <div class="addon-col reveal">
            <h3 class="addon-col__title">内容制作</h3>
            {contentServices.map(row => (
              <div class="addon-item">
                <p class="addon-item__name">{row.service}</p>
                <p class="addon-item__price">{row.price}</p>
              </div>
            ))}
          </div>

          <div class="addon-divider" aria-hidden="true"></div>

          <!-- 培训 -->
          <div class="addon-col reveal reveal-delay-1">
            <h3 class="addon-col__title">培训 & 员工社交传播</h3>
            {trainingServices.map(row => (
              <div class="addon-item">
                <p class="addon-item__name">{row.service}</p>
                <p class="addon-item__price">{row.price}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 绩效奖金 ═══ -->
    <section class="section section--dark" aria-labelledby="bonus-heading">
      <div class="container container--md">
        <div class="s-head reveal" style="text-align: center;">
          <p class="eyebrow eyebrow--light">可选</p>
          <h2 id="bonus-heading" style="color: var(--white);">绩效奖金</h2>
          <p class="s-head__sub" style="color: var(--navy-text-2); margin-inline: auto;">
            仅 Growth 和 Scale 套餐可选。逻辑很简单：我们的一部分费用直接和结果挂钩，目标达成才拿这笔奖励。
          </p>
        </div>

        <div class="bonus-grid">
          {bonusServices.map((b, i) => (
            <div class={`bonus-card reveal reveal-delay-${i + 1}`}>
              <span class="bonus-card__pct">{b.percent}</span>
              <p class="bonus-card__title">{b.model}</p>
              <p class="bonus-card__desc">{b.structure}</p>
              <span class="bonus-card__tag">Growth & Scale</span>
            </div>
          ))}
        </div>

        <p class="s-footnote reveal" style="color: var(--navy-text-3); text-align: center; margin-top: var(--sp-8);">
          目标在合作启动时双方一起定，之后每个季度都会拿出来重新对一次。
        </p>
      </div>
    </section>

    <!-- ═══ 免责说明 ═══ -->
    <div style="padding: var(--sp-10) 0; background: var(--off-white);">
      <div class="container">
        <p class="s-disclaimer reveal">
