  description="至少 4 小时实时会议：搭建 Nuvora 团队、全员培训、三个月免费答疑。费用 3,500 元，其中 1,750 元返还到您的钱包。"
  abstract="Nuvora 应用的付费上线辅导：至少 4 小时实时会议，全员培训，三个月免费答疑，3,500 元中的 1,750 元返还到团队钱包。"
  schemas={onboardingPageSchemas(lang)}
>
  <NavBar lang="zh" />
  <main id="main-content">
    <OnboardingOffer copy={copy} bookHref={onboardingPath('book', lang)} payHref={ONBOARDING_PAY[lang]} />
  </main>
</Layout>
