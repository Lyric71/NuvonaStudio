---
import Layout from '../../../layouts/Layout.astro';
import NavBar from '../../../components/NavBar.astro';
import FAQ from '../../../components/FAQ.astro';
import { servicePageSchemas } from '../../../i18n/schemas';

/* ── Data ───────────────────────────────────────────────── */

const overviewCards = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 7V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.6"/><line x1="9" y1="12" x2="15" y2="12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="9" y1="16" x2="13" y2="16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
    title: '企业主页运营',
    text: '公司主页代运营（Company Page Management）：从零搭建到日常打理，把这张面向全球的"门面"做扎实。',
    href: '#svc-company-page',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
    title: '内容生产与编审',
    text: '所有内容形式都接，每周稳定上线，覆盖你所有的目标市场——靠内容把行业地位立起来。',
    href: '#svc-content-production',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
    title: 'LinkedIn 企业通讯',
    text: 'LinkedIn Newsletter：在你和那群对业务真正要紧的专业人士之间，直接拉一条线。',
    href: '#svc-newsletter',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/><line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="1.6"/><rect x="7" y="14" width="3" height="3" rx="0.5" fill="currentColor" opacity="0.7"/></svg>`,
    title: 'LinkedIn 线上活动',
    text: 'LinkedIn Events 是平台上参与度最高的形式之一，每一次报名背后，都是一个能对上号的潜在客户。',
    href: '#svc-events',
  },
];

const whatWeDo = [
  { title: 'LinkedIn 内容运营整块都交给我们', body: `从策略制定、选题规划，到内容生产、发布执行、数据复盘——全包。
你负责审稿点头，我们负责落地推进，你的团队该忙正事忙正事。`, icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/></svg>` },
  { title: '说你的话，不是说我们的话', body: `每个品牌都有自己的说话方式。
我们会先把你团队的表达习惯、你目标市场真正关心的话题摸透，最后写出来的东西，读者一看会觉得"这不就是他们自己人写的吗"——那种信任感，是装不出来的。`, icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>` },
  { title: '用客户的母语，对着他直说', body: `不是翻译，是母语原创。
德语、中文、西班牙语、葡萄牙语——每一种语言都从零写起，针对目标市场量身做。`, icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 9h17M3.5 15h17" stroke="currentColor" stroke-width="1.6"/><ellipse cx="12" cy="12" rx="4" ry="9" stroke="currentColor" stroke-width="1.6"/></svg>` },
  { title: 'AI 帮我们提速，但不拿质量来换', body: 'AI 用来加速调研、初稿、多语种、视觉和视频。但每一条最终能不能上线，决定权始终在人手里。', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.09 6.26L20 10l-5.91 1.74L12 18l-2.09-6.26L4 10l5.91-1.74L12 2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>` },
  { title: '只汇报真正用得上的结果', body: '月报围着你的商业指标转：这个月做了什么、数据为什么动、下个月打算怎么调。那种满屏花花绿绿、销售看半天也不知道跟自己有什么关系的图表，不会出现在我们的报告里。', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 17V13M12 17V9M17 17V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>` },
];

const whyBlocks = [
  { title: '我们只做 LinkedIn', body: '不是那种把 LinkedIn 当成十五个渠道之一顺手做的数字营销公司——我们就把这一件事做到极致。' },
  { title: '从第一天起就具备多语言能力', body: '大多数机构是把英文翻一下就叫\u201c本地化\u201d。\n我们是在每一种语言里，做真正的母语原创。' },
  { title: 'AI 提速，编辑把关', body: `我们在整条内容流程里都用 AI 工具来提效，
但每一条内容上线之前都得过专业编辑这一关。能让技术解决的让技术解决——质量这扇门，人来守。` },
  { title: '所有成果完全归你', body: '内容、订阅用户、活动报名数据、创意资产，全部属于你。\n没有绑定，也没有\u201c被平台或代理商卡脖子\u201d的风险。' },
];

const services = [
  {
    id: 'svc-company-page',
    title: '企业主页运营',
    short: '你 LinkedIn 上面向全球的"门面"，搭建和日常打理都交给我们来。',
    details: [
      '先做一轮全面诊断：横幅、简介区、精选内容、行业标签，该调的调、该换的换',
      '每个月发什么、按什么节奏发——既看 LinkedIn 算法那边的规律，也对齐你们自己的业务节奏',
      '文字帖、轮播、短视频、PDF 文档、投票，能用得上的格式基本一个不落',
      '涨粉同时走几条路：员工帮转、广告定投，再加上内容本身真有人愿意分享',
      '月底交一份复盘：做了什么、数据怎么变、下个月打算怎么调',
    ],
    trust: '快的部分交给 AI 跑，质量这一关团队亲自把守——分工就这么定。',
    footnote: '没你点头的东西不会发出去。所有内容做出来归属权始终在你这边。',
    stat: null,
    image: '/images/content-company-page.webp',
    imageAlt: '企业主页管理界面',
  },
  {
    id: 'svc-content-production',
    title: '内容生产与编审',
    short: '所有内容形式都接，每周稳定上线，每个目标市场都覆盖。',
    details: [
      '用什么格式发不是随便挑的，是按策略来定的',
      '高管代笔（Ghostwriting）这块——管理层有想法、有观点，我们负责帮他们把这些表达出来、推出去',
      '多语种不走翻译那一条路，每种语言都安排母语的人从头直接写',
      '编辑排期提前一个月就定死：写稿、审稿、你过目、准时上线，一环不乱',
    ],
    trust: '调研和初稿环节 AI 帮了不少忙，多语种内容也靠它拉速度——但每一件出品的质量编辑团队一直在盯。',
    footnote: '发之前必须过你这关。不满意就改，没什么好说的。',
    stat: null,
    image: '/images/content-production.webp',
    imageAlt: '内容生产工作流',
  },
  {
    id: 'svc-newsletter',
    title: 'LinkedIn 企业通讯',
    short: '在你和那群对业务真正要紧的专业人士之间，直接拉一条线。',
    details: [
      '定位先想清楚：这份通讯到底讲什么、给谁看、凭什么让人愿意一直订下去',
      '选题、写稿、编辑、推出去——包括标题怎么起、读者看完该做什么，整套我们一手包',
      '订阅量靠几条路一起拉：企业主页导流、高管个人号带，再叠加定向推广——自然流和付费流并行推',
      '每期发完出一份数据：打开率、点击率、新增多少订阅，全都写清楚',
    ],
    trust: '选题研究、受众分析、多语种初稿——这几环 AI 介入比较多。但品牌调性和最终定稿的决定权，始终在人手里。',
    footnote: '订阅者名单归你，这一条没有商量余地。',
    stat: null,
    image: '/images/content-newsletter.webp',
    imageAlt: 'LinkedIn 企业通讯设计',
  },
  {
    id: 'svc-events',
    title: 'LinkedIn 线上活动',
    short: 'LinkedIn 上互动最猛的玩法。每一个报名的人，都带着真实姓名和职位走过来。',
    details: [
      '选题定位先想透：切入角度要够尖，目标人群要清楚——办就得办到坐满',
      '推广提前四周就开始铺，多个触点同时发力，自然曝光和付费投放双线推',
      '嘉宾不是丢上场就开聊的——每个人事先都要把内容对一遍，设备也会提前调好',
      '直播当天我们盯全场，你只管安心分享',
      '活动结束才是真正的开始：录像剪辑、精华切片、文字稿撰写、社交媒体的传播帖——全套跟上',
      '报名者数据整理好之后，配上一套后续跟进方案，直接递到你商务团队手上',
    ],
    trust: '录像处理和精华剪辑这块 AI 帮了大忙。活动里真正值得说的那部分内容，会被拆成好几种格式在 LinkedIn 上分批发出去。',
    footnote: '素材和报名者信息全部归你。如果我们判断选题方向拉不动报名，第一周就会老老实实告诉你。',
    stat: '100% 报名数据归属权',
    image: '/images/content-events.webp',
    imageAlt: 'LinkedIn 活动推广视觉',
  },
];

const cardIcons = overviewCards.map(c => c.icon);

const stats = [
  { value: '80%', label: 'B2B 社交媒体线索的 80% 来自 LinkedIn', context: '其他平台跟它的差距不是一点点。', source: 'LinkedIn Marketing Solutions / Cognism' },
  { value: '7x', label: '坚持每周更新，粉丝增长速度能跑出 7 倍', context: '增长最有效的方法其实就一个字——发，持续地发。', source: 'LinkedIn' },
  { value: '5x', label: '视频内容的互动量是图文的 5 倍', context: '格式选对，效果差距非常明显。', source: 'LinkedIn' },
  { value: '59%', label: '59% 的 B2B 决策者认为观点型内容最能建立信任', context: '比广告和白皮书都管用。', source: 'LinkedIn / Edelman' },
  { value: '4/5', label: '每 5 位 LinkedIn 用户，就有 4 位参与公司采购决策', context: '换句话说，你内容触达到的人，大概率是能拍板的。', source: 'LinkedIn' },
  { value: '2x', label: 'LinkedIn 的转化率是其他社交平台的 2 倍', context: '用户来这里本就处在工作状态——接受度自然就高一档。', source: 'LinkedIn Marketing Solutions' },
  { value: '277%', label: '在线索获取上，比 Facebook 和 X 总和还高 277%', context: '说实话，根本不像是在同一个赛道里竞争。', source: 'HubSpot' },
  { value: '46%', label: 'B2B 网站社交流量的 46% 来自 LinkedIn', context: '好内容不只是做品牌——它真的会往你网站里引人。', source: 'LinkedIn' },
  { value: '28%', label: '相比 Google Ads，获客成本低 28%', context: '如果同时还在做自然内容，这个数字还能再压下来。', source: 'HubSpot' },
  { value: '61%', label: '有了自然互动垫底，付费转化率再提 61%', context: '自然内容和广告一起做的公司，两头的账都更好看。', source: 'LinkedIn 内部数据' },
];

const faqs = [
  { q: '合作开始的头一个月，一般怎么走？', a: '上来先摸底——企业主页什么状况、高管号什么情况、之前发过哪些内容、粉丝是什么结构。摸完之后出策略，第一个月的内容排好给你过目，你点头就开始发。大多数客户两三周就能进入状态。' },
  { q: '合作周期怎么算？', a: '前三个月是启动期，足够把体系搭起来，也能看到第一波数据上的变化。三个月之后按月续约，想走随时都可以。留下来的客户是因为东西真的在起作用——不是因为合同没到期。' },
  { q: 'AI 到底用在哪些环节？', a: '用得挺深的。调研、初稿、多语种内容、图片生成、视频剪辑，AI 都参与。但 AI 跑出来的东西从来不直接用：文字编辑要审、设计要审、最后还得你点头。整体效果是产量上来了、速度提了、成本降了——质量这条线从未放松过。AI 干体力活，标准始终由人定。' },
  { q: '做出来的东西不满意怎么办？', a: '那就改，没什么好商量的。不用你解释为什么不满意，也不会加你的钱。我们的原则就一条：宁可一篇内容改三遍，也不硬把一个"凑合能看"的东西发出去。' },
  { q: '必须四项服务一起签吗？能不能先试一个？', a: '先签一个完全没问题，后面觉得需要了再加。' },
  { q: '我们团队每周要配合多久？', a: '其实花不了多少时间。内容我们提前一个月就排好，你们团队就看一看、批一批——一周二三十分钟基本够用。有客户跟我们讲过：每周一早上喝咖啡的功夫顺手就处理完了。' },
  { q: '能按我们自己的品牌规范来做吗？', a: '当然，这是基本操作。品牌手册你直接拿过来——语言怎么说、视觉什么风格、审批怎么走，我们按你们的规矩来。如果有合规要求或专有术语方面的限制，也会严格遵守。' },
  { q: '月报里一般都有什么？', a: '围着商业目标写：粉丝涨了多少、互动数据如何、哪条内容跑得好、线索那边有没有动静。然后告诉你哪些打法有效、哪些没效、下个月打算怎么调。不会塞一堆好看但没人看得懂的图表凑数。' },
  { q: '大约多久能看到效果？', a: '多数客户两个月左右就能感受到变化——主页浏览在涨、粉丝在涨、互动数据也开始动。线索转化这一块会慢一些，一般三个月左右才真正起量。内容这事急不来，需要沉淀。好在 LinkedIn 这个平台本身就奖励"一直在做"的那群人。' },
  { q: '到时候想停下，怎么操作？', a: '三个月启动期走完后，提前一个月通知我们就行。内容、订阅者名单、设计文件全部打包交还给你。合作期间做出来的所有东西，归属权一直都是你的。' },
];
---

<Layout
  title="LinkedIn 内容服务｜帮 B2B 企业从 LinkedIn 拿回客户"
  description="LinkedIn 内容一站式代运营：策略、生产、发布、复盘——全流程包圆。专门服务 B2B 企业，把 LinkedIn 做成一个真正能出商机的地方。"
  abstract="我们替 B2B 企业打理 LinkedIn 上的全部内容。四项服务，一个目标——让 LinkedIn 真正给你带回客户。"
  lang="zh"
  schemas={servicePageSchemas('zh', 'content')}
>
  <NavBar lang="zh" />
  <main id="main-content">

    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="c-hero" aria-labelledby="hero-h">
      <div class="c-hero__bg" aria-hidden="true"></div>
      <div class="c-hero__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="c-hero__content">
          <p class="eyebrow eyebrow--light reveal">LinkedIn 内容服务</p>
          <h1 id="hero-h" class="c-hero__h1 reveal reveal-delay-1">
            既能吸住眼球、又能带回客户的 <span class="text-gradient">LinkedIn 内容</span>
          </h1>
          <p class="c-hero__sub reveal reveal-delay-2">
            从策略制定、内容生产、发布执行，到数据复盘和月度报告——一站式全包，不用你操心。
          </p>
          <div class="c-hero__actions reveal reveal-delay-3">
            <a href="/zh/contact" class="btn btn--primary btn--lg">预约沟通</a>
          </div>
        </div>
      </div>
    </section>


    <!-- ── Service Overview Cards ──────────────────────────── -->
    <section class="section c-overview" aria-label="服务总览">
      <div class="container">
        <div class="c-ov__grid">
          {overviewCards.map((card, i) => (
            <a href={card.href} class={`c-ov-card reveal${i > 0 ? ` reveal-delay-${Math.min(i, 3)}` : ''}`}>
              <div class="c-ov-card__top">
                <span class="c-ov-card__icon" set:html={card.icon} />
              </div>
              <strong class="c-ov-card__title">{card.title}</strong>
              <p class="c-ov-card__text">{card.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>


    <!-- ── What We Do ──────────────────────────────────────── -->
    <section class="section c-wwd" aria-labelledby="wwd-h">
      <div class="container">
        <div class="c-wwd__head reveal">
          <p class="eyebrow">我们做的事</p>
          <h2 id="wwd-h" class="c-wwd__h2">把 LinkedIn 跑成一条持续给你带客户的渠道</h2>
          <p class="c-wwd__intro">你团队有硬功夫，公司也有好故事可讲。但这些东西闷在公司内部，销售管线是怎么也填不满的。</p>
          <p class="c-wwd__intro">我们做的事说白了就一件：把品牌里最能打动人的那部分挖出来，做成一套每周在 LinkedIn 上稳定运转的内容体系。帖子、长文、企业通讯、线上活动——所有形式都奔着同一件事去：让该看到你的人看到你。</p>
        </div>

        <div class="c-wwd__grid">
          {whatWeDo.map((item, i) => (
            <div class={`c-wwd-card reveal${i > 0 ? ` reveal-delay-${Math.min(i, 3)}` : ''}`}>
              <div class="c-wwd-card__top">
                <span class="c-wwd-card__icon" aria-hidden="true" set:html={item.icon} />
              </div>
              <strong class="c-wwd-card__title">{item.title}</strong>
              <p class="c-wwd-card__body">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- ── Why Brands Work With Us ─────────────────────────── -->
    <section class="section c-why" aria-labelledby="why-h">
      <div class="c-why__bg" aria-hidden="true"></div>
      <div class="container">
