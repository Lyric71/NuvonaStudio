---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import FAQ from '../../components/FAQ.astro';
import Testimonials from '../../components/Testimonials.astro';

const painPoints = [
  {
    stat: '3%',
    label: '能把 LinkedIn 内容做到稳定更新的 B2B 公司，只有 3%',
    detail: '剩下那 97%——发完一两条就没下文了，过几个月又回过头来问一句：LinkedIn 这事，到底值不值得做？',
  },
  {
    stat: '0',
    label: '亲自打理自己 LinkedIn 主页的高管，几乎为零',
    detail: '随便翻几位 C 级高管的主页就明白——跟招聘网站上的简历没什么两样。一句观点都没有，信任二字从何说起。',
  },
  {
    stat: '72%',
    label: '的 LinkedIn 广告预算，就这么打了水漂',
    detail: '人群圈错了、形式选偏了、转化链路从中间断掉——一个没有顶层设计的广告账户，烧起钱来的速度会让你晚上睡不着。',
  },
];

const services = [
  {
    title: 'LinkedIn 内容服务',
    tag: '自然增长',
    body: '公司主页一站式代运营——所有 LinkedIn 内容形式全覆盖，更新节奏稳得住。品牌该露脸的场合不缺席，团队腾得出精力专心干主业。',
    href: '/zh/services/content',
    subs: [
      '企业主页全托管',
      '内容策划与生产',
      'LinkedIn Newsletter',
      'LinkedIn 线上活动运营',
    ],
  },
  {
    title: 'LinkedIn 广告服务',
    tag: '付费增长',
    body: '从 Sponsored Content 到 Lead Gen Forms——账户从零搭建到全盘托管。预算只花在能拍板的人身上，让每一次曝光都换成实打实的业务线索。',
    href: '/zh/services/advertising',
    subs: [
      '广告账户架构设计',
      '受众定向与圈层筛选',
      '素材与文案创作',
      'CRM 数据打通、效果归因',
    ],
  },
  {
    title: '策略咨询',
    tag: '策略支持',
    body: '高管个人品牌、员工影响力、团队培训，按你公司的实际需要灵活组合。',
    href: '/zh/services/consulting',
    subs: [
      '员工社交传播方案',
      '高管个人品牌',
      '企业内训／工作坊',
      'LinkedIn 策略评估',
    ],
  },
];

const steps = [
  {
    title: '诊断与规划',
    body: '把你 LinkedIn 的家底、竞品的打法、目标客户的样子全部摸清楚，给出一份按优先级排好的行动方案——完全按你公司的真实情况来，不套模板。',
    detail: '第 1–2 周',
  },
  {
    title: '搭建与启动',
    body: '账号优化、内容产出、广告投放——几条线一起铺开同时跑。',
    detail: '第 3–4 周',
  },
  {
    title: '优化与增长',
    body: '围着事先谈好的 KPI 每月复盘一次：跑得通的策略加码放大，转化漏斗一段段提速。',
    detail: '持续进行',
  },
];

const pillars = [
  {
    title: '只做 LinkedIn，别的都不接',
    body: '所有服务围着 LinkedIn 这一个平台转，别的一概不做。算法怎么跑、什么格式吃香、定向怎么搭、什么样的内容能带回客户——这些就是我们每天在死磕的事。',
    metric: '100%',
    metricLabel: '专注 LinkedIn',
  },
  {
    title: '内容是发给客户看的，不是发给老板审的',
    body: '每一条内容都奔着你的目标客户去写。B2B 这群读者眼睛很尖——刷过去毫无反应，这条就算白发了。',
    metric: '3.2x',
    metricLabel: '平均互动提升 3.2 倍',
  },
  {
    title: '账目一清二楚，从来没有隐藏费用',
    body: '报告写得明明白白，报价没有任何隐性条款。每一项做了什么、为什么这么做，你随时来问，我们随时讲得清。',
    metric: '0',
    metricLabel: '隐性收费',
  },
  {
    title: 'AI 提速，人工终审 100% 兜底',
    body: 'AI 帮我们提速、放大产能——这一点我们不避讳。但每一条内容发出去之前都得过团队这一道关，没有任何一条会跳过去。',
    metric: '100%',
    metricLabel: '人工终审',
  },
];

const industries = [
  { label: '科技与 SaaS' },
  { label: '制造与工业' },
  { label: '专业服务' },
  { label: '医疗健康与生命科学' },
  { label: '金融服务' },
  { label: '物流与供应链' },
];

const posts = [
  {
    category: 'LinkedIn 策略',
    tags: ['算法', '触达率'],
    title: '2026 年 LinkedIn 触达率被腰斩，跟你的内容真没关系',
    excerpt: 'LinkedIn 上线了一套叫 360Brew 的新算法。企业自然触达直接砍掉一半，公司主页的流量更惨，少了六成。不是你的内容变差了，是平台把规则改了。',
    date: '2026-03-29',
    slug: 'why-your-reach-dropped',
    image: '/blog/hero-reach-dropped.svg',
  },
  {
    category: 'LinkedIn 策略',
    tags: ['内容', '线索'],
    title: 'LinkedIn 内容有了曝光，然后呢？怎么把流量变成客户',
    excerpt: '光有阅读量没人主动找上门，内容做了等于白做。Inbound 转化率能做到 14.6%，主动外呼也就 1.7%，中间差了将近 10 倍。根子上的问题，是内容体系压根就没搭起来。',
    date: '2026-03-29',
    slug: 'content-to-inbound-leads',
    image: '/blog/hero-ads-vs-organic.svg',
  },
  {
    category: 'LinkedIn 广告',
    tags: ['广告', '归因'],
    title: 'LinkedIn 广告 ROI 难看？多半是你算账的方式有问题',
    excerpt: 'B2B 广告投在 LinkedIn 上，实际回报率能跑到 121%。问题在于一个买家从第一次接触到真正下单，平均要走 272 天。你要是非盯着 30 天的 ROI 看，那当然难看。',
    date: '2026-03-29',
    slug: 'linkedin-ad-roi-measurement-problem',
    image: '/blog/hero-ads-cost.svg',
  },
];

const faqs = [
  { q: '你们的客户都在哪些地区？', a: '全球都有。欧洲、北美、亚洲都有合作中的客户。' },
  { q: '你们真的只做 LinkedIn 吗？', a: '真的。不做 SEO、不做 Instagram，也不接所谓的"全渠道整合营销"。LinkedIn，就这一个。' },
  { q: '起步费用是多少？', a: 'Foundation 方案 $1,800 一个月起步，策略、内容、月度数据报告全包。大部分客户都是先从这一档开始用，后面再按需要往上加。', link: { text: '完整报价在这里 →', href: '/zh/pricing' } },
  { q: '是不是只适合大企业？', a: '不是。$1,800 一个月就能拿到一套完整的 LinkedIn 代运营；培训和广告托管也可以单拎出来做。' },
  { q: '广告投放费用包含在服务费里吗？', a: '广告费是单独算的，而且始终由你直接付给 LinkedIn，不经我们手。' },
  { q: '效果到底怎么衡量？', a: '开始合作时一起把 KPI 谈定——线索数、销售管道、粉丝净增、单条线索成本，每月一份报告说清楚。我们不会拿曝光量和点赞数糊弄你。' },
];

---

<Layout
  lang="zh"
  title="Nuvora Studio｜专注 LinkedIn 的 B2B 营销机构"
  description="只服务 B2B 企业、只做 LinkedIn 一件事的营销咨询公司。LinkedIn 内容代运营、LinkedIn 广告投放、高管个人品牌、团队培训，全都围绕这一个平台。"
  abstract="只做 LinkedIn 的 B2B 营销公司。策略、内容、广告、培训，在这一个平台上一次性解决。"
  preloadHero="/images/hero-notification.webp"
  preloadHeroSrcset="/images/hero-notification-640.webp 640w, /images/hero-notification-1024.webp 1024w, /images/hero-notification.webp 1408w"
  preloadHeroSizes="100vw"
>
  <NavBar lang="zh" />
  <main id="main-content">

    <!-- ═══════════════════════════ 1. HERO ═══════════════════════════ -->
    <section class="hero" aria-labelledby="hero-heading">
      <img src="/images/hero-notification.webp" srcset="/images/hero-notification-640.webp 640w, /images/hero-notification-1024.webp 1024w, /images/hero-notification.webp 1408w" sizes="100vw" alt="" aria-hidden="true" class="hero__bg" fetchpriority="high" decoding="async" width="1408" height="768" />
      <div class="hero__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="hero__content">
          <p class="eyebrow eyebrow--light hero__anim">专注 LinkedIn 的 B2B 营销机构</p>
          <h1 id="hero-heading" class="hero__h1 hero__anim hero__anim--1">
            让 LinkedIn 真的变成<span class="text-gradient">替你带回订单的渠道。</span>
          </h1>
          <p class="hero__sub hero__anim hero__anim--2">
            策略、内容、广告——只围着 LinkedIn 这一个平台做。
            让 B2B 企业在这里站稳脚跟，让对的人看到你，让生意自己找上门。
          </p>
          <div class="hero__actions hero__anim hero__anim--3">
            <a href="/zh/contact?intent=call" class="btn btn--primary btn--lg">预约策略通话</a>
            <a href="/zh/services" class="btn btn--outline-white btn--lg">查看服务内容</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════ 2. PROBLEM STATEMENT ═══════════════════════════ -->
    <section class="section problem" aria-labelledby="problem-heading">
      <div class="container">

        <div class="problem__hero reveal">
          <div class="problem__head">
            <p class="eyebrow eyebrow--light">行业现状</p>
            <h2 id="problem-heading">
              绝大多数 B2B 公司，<br />在 LinkedIn 上近乎"隐形"
            </h2>
            <p class="problem__sub">
              内容三天打鱼两天晒网，公司主页好几年没动一下，高管的个人主页活脱脱像注册完就忘了密码的样子。
              广告砸出去，也往往砸不到真正能拍板的那个人。LinkedIn 是个吃长期投入和专业深度的平台——
              这两样都缺，再好的 B2B 渠道也救不了你。
            </p>
          </div>

          <div class="problem__visual">
            <img
              src="/images/problem-linkedin.webp"
              alt="两块屏幕对比：左侧是空白的LinkedIn通知、零曝光和平直的数据曲线；右侧是不断涌入的连接请求、新线索和12,400次展示"
              class="problem__img"
              width="760"
              height="760"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="problem__grid">
          {painPoints.map((p, i) => (
            <div class="problem__card reveal" style={`transition-delay: ${i * 0.1}s`}>
              <p class="problem__stat">{p.stat}</p>
              <p class="problem__label">{p.label}</p>
              <p class="problem__detail">{p.detail}</p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════ 3. SERVICES GRID ═══════════════════════════ -->
    <section id="services" class="section" style="background: var(--off-white);" aria-labelledby="services-heading">
      <div class="container">

        <div class="services__head reveal">
          <div>
            <p class="eyebrow">服务范围</p>
            <h2 id="services-heading">把 LinkedIn 做好，所需的每一环我们都接</h2>
          </div>
          <p class="services__intro">
            做了什么、花了多少、效果如何，账目全透明。策略、诊断、月度报告是每个项目的标配，从不另外收钱。
          </p>
        </div>

        <div class="services__grid">
          {services.map((s, i) => (
            <a href={s.href} class="services__card reveal" style={`transition-delay: ${i * 0.08}s`}>
              <div class="services__card-top">
                <span class="tag tag--cyan">{s.tag}</span>
                <span class="services__arrow" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M4.5 15.5L15.5 4.5M15.5 4.5H7.5M15.5 4.5V12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
              {s.title === 'LinkedIn 内容服务' ? (
                <div class="services__vis services__vis--content" aria-hidden="true">
                  <img src="/images/content-calendar-v2.webp" alt="" width="480" height="270" loading="lazy" />
                </div>
              ) : s.title === 'LinkedIn 广告服务' ? (
                <div class="services__vis services__vis--content" aria-hidden="true">
                  <img src="/images/ad-creative-stack.webp" alt="" width="480" height="270" loading="lazy" />
                </div>
              ) : s.title === '策略咨询' ? (
                <div class="services__vis services__vis--content" aria-hidden="true">
                  <img src="/images/consulting-workshop.webp" alt="" width="480" height="270" loading="lazy" />
                </div>
              ) : (
                <div class="vis-placeholder services__vis" aria-hidden="true">
                  <span>视觉占位</span>
                </div>
              )}
              <h3 class="services__card-title">{s.title}</h3>
              <p class="services__card-desc">{s.body}</p>
              <ul class="services__subs">
                {s.subs.map(sub => (
                  <li class="services__sub">{sub}</li>
                ))}
              </ul>
            </a>
          ))}
        </div>

        <div class="services__foot reveal">
          <a href="/zh/services" class="btn btn--outline btn--lg">查看全部服务详情</a>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════ 4. HOW WE WORK ═══════════════════════════ -->
    <section class="section" style="background: var(--deep-navy);" aria-labelledby="process-heading">
      <div class="container">

        <div class="process__head reveal">
          <p class="eyebrow eyebrow--light">合作方式</p>
          <h2 id="process-heading" style="color: var(--white);">
            从诊断到增长，<br /><em style="color: rgba(255,255,255,0.35); font-weight: 300;">三步走完</em>
          </h2>
        </div>

        <div class="process__grid">
          {steps.map((s, i) => (
            <div class="process__step reveal" style={`transition-delay: ${i * 0.1}s`}>
              <div class="process__line-horizontal" aria-hidden="true"></div>
              <div class="process__content">
                <span class="process__detail">{s.detail}</span>
                <h3 class="process__title">{s.title}</h3>
                <p class="process__body">{s.body}</p>
              </div>
              {s.title === '诊断与规划' ? (
                <div class="process__vis process__vis--img" aria-hidden="true">
                  <img src="/images/audit-strategy.webp" alt="" width="600" height="375" loading="lazy" />
                </div>
              ) : s.title === '搭建与启动' ? (
                <div class="process__vis process__vis--img" aria-hidden="true">
                  <img src="/images/build-launch.webp" alt="" width="600" height="375" loading="lazy" />
                </div>
              ) : s.title === '优化与增长' ? (
                <div class="process__vis process__vis--img" aria-hidden="true">
                  <img src="/images/grow-report.webp" alt="" width="600" height="375" loading="lazy" />
                </div>
              ) : (
                <div class="vis-placeholder process__vis" aria-hidden="true">
                  <span>视觉占位</span>
                </div>
              )}
            </div>
          ))}
        </div>

        <div class="process__cta reveal" style="transition-delay: 0.3s">
          <a href="/zh/pricing" class="btn btn--outline-white btn--lg">查看报价</a>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════ 5. WHAT SETS US APART ═══════════════════════════ -->
    <section class="section" aria-labelledby="apart-heading">
      <div class="container">
        <div class="apart__layout">

          <div class="apart__left">
            <div class="apart__head reveal">
              <p class="eyebrow">为什么选择我们</p>
              <h2 id="apart-heading">只做一件事，<br />那就是 LinkedIn。</h2>
              <div class="accent-bar"></div>
              <p class="apart__lead">
                我们不是顺手带 LinkedIn 业务的数字营销公司。LinkedIn 就是我们的全部，没有之一。
              </p>
            </div>

            <!-- Visual: comparison graphic -->
            <div class="apart__visual reveal reveal-delay-1" aria-hidden="true">
              <div class="apart__visual-inner">
                <div class="apart__vis-compare">
                  <div class="apart__vis-col apart__vis-col--them">
                    <span class="apart__vis-label">综合型营销公司</span>
                    <div class="apart__vis-bars">
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 30%"></div></div>
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 25%"></div></div>
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 20%"></div></div>
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 35%"></div></div>
                      <div class="apart__vis-item"><span class="apart__vis-dot apart__vis-dot--muted"></span><div class="apart__vis-bar apart__vis-bar--muted" style="width: 15%"></div></div>
                    </div>
                  </div>
                  <div class="apart__vis-divider"></div>
                  <div class="apart__vis-col apart__vis-col--us">
                    <span class="apart__vis-label">Nuvora Studio</span>
                    <div class="apart__vis-bars">
                      <div class="apart__vis-item"><span class="apart__vis-dot"></span><div class="apart__vis-bar" style="width: 100%"></div></div>
                    </div>
                    <span class="apart__vis-tag">只做 LinkedIn</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="apart__right">
            <div class="apart__grid">
              {pillars.map((p, i) => (
                <div class="apart__card reveal" style={`transition-delay: ${i * 0.08}s`}>
                  <div class="apart__card-metric">
                    <span class="apart__metric-value">{p.metric}</span>
                    <span class="apart__metric-label">{p.metricLabel}</span>
                  </div>
                  <div class="apart__card-body">
                    <div class="apart__card-header">
                      <h3 class="apart__title">{p.title}</h3>
                    </div>
                    <p class="apart__body">{p.body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════ 6. TESTIMONIALS ═══════════════════════════ -->
    <Testimonials
      eyebrow="客户怎么说"
      heading="合作过的人，是这么评价的"
      sub="不同行业的 B2B 团队，看的都是同一件事：实际结果。"
      items={[
        { text: "半年下来，40% 的线索都是从 LinkedIn 进来的。坦白讲，这个渠道之前在我们这儿根本没人当回事。", image: "https://randomuser.me/api/portraits/women/32.jpg", name: "Sophie Laurent", role: "CMO，SaaS 公司" },
        { text: "他们不是那种随手帮你发几条帖的团队，是真摸透了 B2B 的购买逻辑。原来几位高管的 LinkedIn 主页没人理，现在经常有人主动找上来谈业务。", image: "https://randomuser.me/api/portraits/men/45.jpg", name: "Marcus Webb", role: "销售 VP，工业技术" },
        { text: "最戳到我们的就是透明这一点。每个月报告清清楚楚——什么有效、什么没效、钱花到哪去了。之前换过好几家服务商，从来没遇到过这么实诚的。", image: "https://randomuser.me/api/portraits/women/28.jpg", name: "Priya Sharma", role: "市场负责人，金融科技" },
        { text: "我们之前试过三家，效果都很一般。Nuvora 不一样的地方在于，他们真的把 LinkedIn 算法和 B2B 买家的行为习惯吃透了，不是什么社交媒体都接的那种万金油。", image: "https://randomuser.me/api/portraits/men/22.jpg", name: "David Chen", role: "CEO，管理咨询公司" },
        { text: "广告费以前基本就是打水漂。他们接手之后把账户结构整个重搭了一遍，线索质量上来了，获客成本差不多降了一半。", image: "https://randomuser.me/api/portraits/women/44.jpg", name: "Emma Bergström", role: "数字营销负责人，制造业" },
        { text: "内容质量是真的扎实。发出来一看，就是我们自己人会说的话，完全闻不到外包那种刻意感。能把 B2B 内容做到这个程度的，确实不多。", image: "https://randomuser.me/api/portraits/men/36.jpg", name: "James Okafor", role: "创始人，专业服务" },
        { text: "策略、内容、投放，全权交给他们了。从原来一个月发一条勉强凑数，到现在公司主页、高管主页、广告投放全线都在跑——这变化我们自己都没想到。", image: "https://randomuser.me/api/portraits/women/51.jpg", name: "Ana Rodriguez", role: "市场总监，医疗行业" },
        { text: "我们做了一个员工传播的项目，销售团队现在在 LinkedIn 上活跃多了，行业里慢慢也打开了认知度。最重要的是，带回来的线索是真的能算得出账来的。", image: "https://randomuser.me/api/portraits/men/53.jpg", name: "Ravi Patel", role: "CRO，企业软件" },
        { text: "他们给的报告很务实——线索多少条、质量怎么样、单条多少钱，全摆在台面上。不像之前合作过的几家，拿一堆曝光数据就当交差了……", image: "https://randomuser.me/api/portraits/women/19.jpg", name: "Laura Koenig", role: "COO，物流公司" },
      ]}
    />

    <!-- ═══════════════════════════ 7. INDUSTRIES ═══════════════════════════ -->
    <section class="section" aria-labelledby="industries-heading">
      <div class="container">
        <div class="industries__layout">

          <div class="industries__text reveal">
            <p class="eyebrow">服务行业</p>
            <h2 id="industries-heading">为 B2B 量身打造，<br /><em>各行各业通用</em></h2>
            <div class="accent-bar"></div>
            <p class="industries__body">
              跨国集团也好，高增长公司也罢，行业不同、市场不同，底层逻辑都一样——都是 B2B。
            </p>
            <p class="industries__body">
              你的客户其实就在 LinkedIn 上，只是你还没找到他们？过来聊聊看。
            </p>
            <a href="/zh/contact" class="btn btn--primary" style="margin-top: var(--sp-6);">
              联系我们
            </a>
          </div>

          <div class="industries__right reveal reveal-delay-2">
            <div class="industries__visual" aria-hidden="true">
              <img src="/images/global-connections.webp" alt="" width="480" height="270" loading="lazy" />
            </div>
            <div class="industries__grid" aria-label="服务覆盖的行业">
              {industries.map(ind => (
                <div class="industries__item">
                  <span class="industries__dot" aria-hidden="true"></span>
                  <span class="industries__label">{ind.label}</span>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════ 8. INSIGHTS PREVIEW ═══════════════════════════ -->
    <section class="section" style="background: var(--off-white);" aria-labelledby="insights-heading">
      <div class="container">

        <div class="insights__head reveal">
          <div>
            <p class="eyebrow">专栏</p>
            <h2 id="insights-heading">来自一线实战的 LinkedIn 深度观察</h2>
          </div>
          <p class="insights__sub">
            LinkedIn 策略、B2B 内容怎么打磨、广告怎么投、平台最新的风向变动，这些我们都会写。
            作者本人每天就在做这件事，不是那种坐在办公室攒稿的内容团队。
          </p>
        </div>

        <div class="insights__grid">
          {posts.map((post, i) => (
            <article class="insights__card reveal" style={`transition-delay: ${i * 0.08}s`}>
              {post.image ? (
                <div class="insights__thumb insights__thumb--img" style={`background-image: url('${post.image}')`} aria-hidden="true"></div>
              ) : (
                <div class="vis-placeholder insights__thumb" aria-hidden="true">
                  <span>视觉占位</span>
                </div>
              )}
              <div class="insights__card-top">
                <div class="insights__tags">
                  {post.tags.map(t => <span class="insights__tag">{t}</span>)}
                </div>
              </div>
              <h3 class="insights__title">
                <a href={`/insights/${post.slug}`}>{post.title}</a>
              </h3>
              <p class="insights__excerpt">{post.excerpt}</p>
              <a href={`/insights/${post.slug}`} class="insights__read">
                继续阅读
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8m0 0L7.5 3.5M11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </article>
          ))}
        </div>

        <div class="text-center reveal" style="margin-top: var(--sp-10);">
          <a href="/zh/insights" class="btn btn--outline btn--lg">查看全部文章</a>
        </div>


      </div>
    </section>

    <!-- ═══════════════════════════ 9. FAQ ═══════════════════════════ -->
    <FAQ heading="常见问题" faqs={faqs} footer="还有别的疑问？" footerLink={{ text: '直接来问就好', href: '/zh/contact' }} id="faq-zh" />

    <!-- ═══════════════════════════ 10. CONTACT CTA ═══════════════════════════ -->
    <section class="section cta" aria-labelledby="cta-heading" style="background: var(--deep-navy);">
      <div class="container">
        <div class="cta__layout">

          <div class="cta__left reveal">
            <p class="eyebrow eyebrow--light">现在开始</p>
            <h2 id="cta-heading" class="cta__headline">
              准备好让 LinkedIn<br />
              <em>真正给生意带来回报了吗</em>
            </h2>
          </div>

          <div class="cta__right reveal reveal-delay-2">
            <p class="cta__sub">
              说一下你们公司眼下的情况——我们替你看看，LinkedIn 上还有哪些没用上的机会。就是聊一聊，不会推销什么。
            </p>
            <div class="cta__actions">
              <a href="/zh/contact?intent=call" class="btn btn--primary btn--lg">预约 30 分钟通话</a>
              <a href="/zh/contact" class="btn btn--outline-white btn--lg">在线留言</a>
            </div>
            <p class="cta__note">30 分钟，不推销，就聊实际问题。</p>
          </div>

        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ═══════════════════════════════════════════════════════════
     HERO
     ═══════════════════════════════════════════════════════════ */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--sp-32) var(--sp-24);
    min-height: 520px;
    display: flex;
    align-items: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(15,23,42, 0.88) 0%,
      rgba(15,23,42, 0.55) 50%,
      rgba(15,23,42, 0.20) 100%
    );
    z-index: 1;
  }

  .hero__content {
    max-width: 680px;
  }

  .hero__h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.10;
    letter-spacing: -0.02em;
    margin-block: var(--sp-5) var(--sp-6);
  }
  .hero__h1 .text-gradient {
    background: linear-gradient(135deg, var(--cyan) 0%, var(--sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__sub {
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.68);
    max-width: 520px;
    line-height: 1.75;
    margin-bottom: var(--sp-10);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .hero__anim { animation: heroFadeUp 0.7s var(--ease, ease) both; }
  .hero__anim--1 { animation-delay: 0.06s; }
  .hero__anim--2 { animation-delay: 0.14s; }
  .hero__anim--3 { animation-delay: 0.22s; }
  /* The h1 is the LCP text: slide it in without starting invisible. */
  @keyframes heroRise {
    from { transform: translateY(20px); }
    to   { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__h1.hero__anim { animation-name: heroRise; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__anim { animation: none; opacity: 1; transform: none; }
  }

  @media (max-width: 640px) {
    .hero { padding-block: var(--sp-16) var(--sp-12); }
  }

  /* ═══════════════════════════════════════════════════════════
     PROBLEM STATEMENT
     ═══════════════════════════════════════════════════════════ */
  .problem {
    background: var(--deep-navy);
  }

  /* ── Hero row ── */
  .problem__hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-12);
    align-items: center;
    margin-bottom: var(--sp-16);
  }

  .problem__head {
    max-width: 540px;
  }

  .problem__head :global(.eyebrow) {
    color: var(--cyan);
  }

  .problem__head :global(h2) {
    color: var(--white);
    margin-bottom: var(--sp-6);
  }

  .problem__sub {
    font-size: var(--fs-md);
    color: var(--navy-text-2);
    line-height: 1.75;
  }

  /* ── Visual ── */
  .problem__visual {
    border-radius: var(--r-xl);
    overflow: hidden;
  }

  .problem__img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Stat cards ── */
  .problem__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-6);
  }

  .problem__card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--r-xl);
    padding: var(--sp-8);
    transition: all var(--t-base);
  }

  .problem__card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateY(-3px);
  }

  .problem__stat {
    font-family: var(--font-display);
    font-size: var(--fs-5xl);
    font-weight: 700;
    line-height: 1;
    color: var(--cyan);
    margin-bottom: var(--sp-4);
    letter-spacing: -0.03em;
  }

  .problem__label {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--white);
    line-height: 1.3;
    margin-bottom: var(--sp-4);
    letter-spacing: -0.01em;
  }

  .problem__detail {
    font-size: var(--fs-sm);
    color: var(--navy-text-2);
    line-height: 1.7;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .problem__hero {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .problem__head { max-width: 660px; margin-inline: auto; }
    .problem__visual { max-width: 480px; margin-inline: auto; }
    .problem__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .problem__grid { grid-template-columns: 1fr; }
    .problem__stat { font-size: var(--fs-4xl); }
  }

  /* ═══════════════════════════════════════════════════════════
     SERVICES GRID
     ═══════════════════════════════════════════════════════════ */
  .services__head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-12);
    align-items: end;
    margin-bottom: var(--sp-12);
  }

  .services__intro {
    font-size: var(--fs-md);
    color: var(--text-2);
    line-height: 1.7;
    max-width: 400px;
    align-self: flex-end;
    padding-bottom: 6px;
  }

  /* ── Card grid ── */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-6);
    margin-bottom: var(--sp-12);
  }

  /* ── Card ── */
  .services__card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    padding: var(--sp-8);
    transition: all var(--t-base);
    text-decoration: none;
    color: inherit;
  }

  .services__card:hover {
    border-color: var(--border-2);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .services__card:hover .services__arrow {
    background: var(--deep-navy);
    color: var(--white);
    border-color: var(--deep-navy);
  }

  .services__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-6);
  }

  .services__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-3);
    transition: all var(--t-base);
    flex-shrink: 0;
  }

  /* ── Visual ── */
  .services__vis {
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 120px;
    margin-bottom: var(--sp-6);
    border-radius: var(--r-lg);
    background: var(--off-white);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .services__vis--content {
    background: none;
    border: none;
    padding: 0;
  }

  .services__vis--content img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-lg);
  }

  .services__vis span {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .services__card-title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: var(--sp-4);
  }

  .services__card-desc {
    font-size: var(--fs-sm);
    color: var(--text-2);
    line-height: 1.75;
    margin-bottom: var(--sp-6);
  }

  /* ── Sub-services list ── */
  .services__subs {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: auto;
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
  }

  .services__sub {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-2);
    letter-spacing: 0.02em;
    padding-left: var(--sp-4);
    position: relative;
  }

  .services__sub::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cyan);
  }

  .services__foot { text-align: center; }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .services__head { grid-template-columns: 1fr; gap: var(--sp-6); }
    .services__intro { max-width: 100%; }
    .services__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .services__grid { grid-template-columns: 1fr; }
  }

  /* ═══════════════════════════════════════════════════════════
     HOW WE WORK
     ═══════════════════════════════════════════════════════════ */
  .process__head {
    text-align: center;
    max-width: 580px;
    margin-inline: auto;
    margin-bottom: var(--sp-16);
  }

  .process__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-8);
    margin-bottom: var(--sp-12);
    align-items: start;
  }

  .process__step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .process__line-horizontal {
    height: 1px;
    background: linear-gradient(to right, rgba(6, 182, 212, 0.25), transparent);
    margin-bottom: var(--sp-2);
  }

  .process__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    flex: 1;
  }

  .process__detail {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
  }

  .process__title {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--white);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .process__body {
    font-size: var(--fs-sm);
    color: var(--navy-text-2);
    line-height: 1.75;
  }

  .process__vis {
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 100px;
    margin-top: auto;
    border-radius: var(--r-lg);
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .process__vis--img {
    background: none;
    border: none;
    padding: 0;
  }

  .process__vis--img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--r-lg);
  }

  .process__vis span {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.12);
  }

  .process__cta { text-align: center; }

  @media (max-width: 768px) {
    .process__grid { grid-template-columns: 1fr; gap: var(--sp-10); }
    .process__line-horizontal { display: none; }
  }

  /* ═══════════════════════════════════════════════════════════
     WHAT SETS US APART
     ═══════════════════════════════════════════════════════════ */
  .apart__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-12);
    align-items: start;
  }

  .apart__left {
    position: sticky;
    top: calc(var(--sp-24));
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .apart__lead {
    font-size: var(--fs-md);
    color: var(--text-2);
    line-height: 1.75;
  }

  /* ── Comparison visual ── */
  .apart__visual {
    background: var(--off-white);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    overflow: hidden;
  }

  .apart__visual-inner {
    padding: var(--sp-8);
  }

  .apart__vis-compare {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .apart__vis-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .apart__vis-label {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .apart__vis-col--us .apart__vis-label {
    color: var(--sky);
  }

  .apart__vis-bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .apart__vis-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apart__vis-dot {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--cyan);
    flex-shrink: 0;
  }
  .apart__vis-dot--muted {
    background: var(--border-2);
  }

  .apart__vis-bar {
    height: 6px;
    background: var(--gradient-accent);
    border-radius: 3px;
  }
  .apart__vis-bar--muted {
    background: var(--border);
    opacity: 0.6;
  }

  .apart__vis-divider {
    height: 1px;
    background: var(--border);
  }

  .apart__vis-tag {
    display: inline-block;
    width: fit-content;
    padding: 3px 10px;
    border-radius: var(--r-full);
    background: rgba(14,165,233,0.08);
    color: var(--sky);
    font-size: 0.65rem;
    font-weight: 600;
