  }

  .form-check:hover .form-check__inner { border-color: var(--border-2); }

  .form-check__input:focus-visible + .form-check__inner {
    border-color: var(--sky);
    box-shadow: 0 0 0 3px rgba(14,165,233,0.18);
  }

  .form-check__input:checked + .form-check__inner {
    border-color: var(--sky);
    background: rgba(14,165,233,0.04);
  }

  .form-check__box {
    flex-shrink: 0;
    width: 18px; height: 18px;
    border-radius: 5px;
    border: 1.5px solid var(--border-2);
