    color: #c0392b;
  }
  .form-banner.is-visible { display: block; }

  /* ── 选项卡片组（服务 / 时间） ── */
  .form-chips {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3);
    margin-top: var(--sp-1);
  }

  .form-chip { position: relative; cursor: pointer; display: block; }

  .form-chip__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    inset: 0;
  }

  .form-chip__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-4);
    background: var(--white);
    border: 1.5px solid var(--border);
    border-radius: var(--r-lg);
    transition: border-color var(--t-fast), background var(--t-fast), box-shadow var(--t-fast), transform var(--t-fast);
    height: 100%;
  }

  #service-group .form-chip__inner::after {
    content: '';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: var(--white);
    transition: background var(--t-fast), border-color var(--t-fast);
  }

  #service-group .form-chip__input:checked + .form-chip__inner::after {
    background: var(--sky)
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M3 6.5l2 2 4-5' stroke='white' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>")
      center / 11px no-repeat;
    border-color: var(--sky);
  }

  .form-chip:hover .form-chip__inner { border-color: var(--border-2); background: var(--off-white); }

  .form-chip__input:focus-visible + .form-chip__inner {
    border-color: var(--sky);
    box-shadow: 0 0 0 3px rgba(14,165,233,0.18);
  }

  .form-chip__input:checked + .form-chip__inner {
    border-color: var(--sky);
