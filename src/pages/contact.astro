    box-shadow: 0 0 0 3px rgba(14,165,233,0.18);
  }

  .form-check__input:checked + .form-check__inner {
    border-color: var(--sky);
    background: rgba(14,165,233,0.04);
  }

  .form-check__box {
    flex-shrink: 0;
    width: 18px; height: 18px;
    border-radius: 5px;
    border: 1.5px solid var(--border-2);
    background: var(--white);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background var(--t-fast), border-color var(--t-fast);
  }

  .form-check__input:checked + .form-check__inner .form-check__box {
    background: var(--sky)
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M3 6.5l2 2 4-5' stroke='white' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>")
      center / 12px no-repeat;
    border-color: var(--sky);
  }

  .form-check__label {
    flex: 1;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--text);
    line-height: 1.45;
  }

  .form-check__price {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--sky);
    white-space: nowrap;
  }

  .form-hint a {
    color: var(--sky);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .form-hint a:hover { color: var(--blue); }

  .contact-form__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }

  .contact-form__privacy {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .submit-spinner {
    display: inline-block;
    width: 16px; height: 16px;
    border: 2px solid rgba(255,255,255,0.30);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    margin-left: var(--sp-2);
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ══════════════════════════════════════════
     SIDEBAR
  ══════════════════════════════════════════ */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    position: sticky;
    top: 96px;
  }

  .sidebar-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-2xl);
    padding: var(--sp-5) var(--sp-6);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--t-base);
  }

  .sidebar-card:hover {
    box-shadow: var(--shadow-md);
  }

  .sidebar-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--deep-navy);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-bottom: var(--sp-3);
    opacity: 0.55;
  }

  /* Steps */
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .step-item {
    display: flex;
    gap: var(--sp-3);
    position: relative;
  }

  /* vertical connector line between steps */
  .step-item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 14px;
    top: 30px;
    bottom: -4px;
    width: 1px;
    background: var(--border);
  }

  .step-item + .step-item { margin-top: var(--sp-2); }

  .step-item__number {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--deep-navy);
    color: var(--white);
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 0;
    position: relative;
    z-index: 1;
  }

  .step-item__content {
    padding-top: 3px;
    padding-bottom: var(--sp-2);
  }
  .step-item__content strong {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--deep-navy);
    margin-bottom: var(--sp-1);
  }
  .step-item__content p {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--text-2);
    line-height: 1.7;
  }

  /* Trust list */
  .trust-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .trust-item {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--text-2);
    line-height: 1.5;
  }

  .trust-item__icon {
    flex-shrink: 0;
    width: 26px; height: 26px;
    background: rgba(6,182,212,0.08);
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  /* Pricing anchor card */
  .sidebar-card--pricing {
    background: var(--deep-navy);
    border-color: rgba(255,255,255,0.08);
  }

  .sidebar-card--pricing:hover {
    box-shadow: var(--shadow-lg);
  }

  .pricing-anchor__top {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-bottom: var(--sp-2);
  }
  .pricing-anchor__label {
    font-size: var(--fs-xs);
    color: var(--cyan);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pricing-anchor__value {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    font-weight: 700;
    color: var(--white);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .pricing-anchor__value span {
    font-size: var(--fs-lg);
    font-weight: 400;
    color: rgba(255,255,255,0.42);
  }
  .pricing-anchor__note {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: rgba(255,255,255,0.38);
    margin-bottom: var(--sp-3);
    line-height: 1.5;
  }
  .pricing-anchor__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--cyan);
    transition: gap var(--t-fast), color var(--t-fast);
  }
  .pricing-anchor__link:hover { gap: var(--sp-3); color: var(--sky); }

  /* ══════════════════════════════════════════
     RESPONSIVE
  ══════════════════════════════════════════ */
  @media (max-width: 1024px) {
    .contact-layout { grid-template-columns: 1fr; }
    .contact-sidebar { position: static; flex-direction: row; flex-wrap: wrap; }
    .sidebar-card { flex: 1; min-width: 260px; }
    .contact-hero__inner { grid-template-columns: 1fr; }
    .contact-hero__visual { display: none; }
    .hero-circle { display: none; }
  }

  @media (max-width: 640px) {
    .contact-hero { padding-block: var(--sp-16) var(--sp-12); }
    .contact-hero__chips { gap: var(--sp-2); }
    .contact-form { padding: var(--sp-6); }
    .contact-card__header { padding: var(--sp-6); }
    .contact-form__grid { grid-template-columns: 1fr; }
    .contact-sidebar { flex-direction: column; }
    .sidebar-card { min-width: unset; }
    .form-chips { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form    = document.getElementById('contact-form') as HTMLFormElement | null;
  const tsField = document.getElementById('form-ts') as HTMLInputElement | null;
  if (tsField) tsField.value = String(Date.now());
  const card    = document.getElementById('contact-card') as HTMLElement | null;
  const success = document.getElementById('contact-success') as HTMLElement | null;
  const submitBtn   = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label') as HTMLElement | null;
  const submitSpinner = document.getElementById('submit-spinner') as HTMLElement | null;
  const errorBanner  = document.getElementById('form-error-banner') as HTMLElement | null;
  const errorMessage = document.getElementById('form-error-message') as HTMLElement | null;

  function setFieldError(fieldId: string, message: string) {
    const field = document.getElementById(fieldId) as HTMLInputElement | HTMLTextAreaElement | null;
    const error = document.getElementById(`${fieldId}-error`);
    field?.classList.toggle('is-invalid', !!message);
    if (error) error.textContent = message;
  }

  function clearErrors() {
    ['name', 'email', 'website', 'company', 'project'].forEach(id => setFieldError(id, ''));
    const serviceErr  = document.getElementById('service-error');
    const timelineErr = document.getElementById('timeline-error');
    if (serviceErr)  serviceErr.textContent  = '';
    if (timelineErr) timelineErr.textContent = '';
    if (errorBanner) errorBanner.classList.remove('is-visible');
  }

  /**
   * Validate the form. Returns the first invalid element (to focus + scroll to),
   * or null if everything passes. Fields are checked in the order they appear
   * on the form so the first error matches what the user sees.
   */
  function validate(data: FormData): HTMLElement | null {
    let firstInvalid: HTMLElement | null = null;
    const remember = (el: HTMLElement | null) => {
      if (el && !firstInvalid) firstInvalid = el;
    };

    // — Name —
    if (!(data.get('name') as string)?.trim()) {
      setFieldError('name', 'Could you pop your name in here for us?');
      remember(document.getElementById('name'));
    }

    // — Email —
    const email = (data.get('email') as string)?.trim();
    if (!email) {
      setFieldError('email', "We'll need an email address to write back to you.");
      remember(document.getElementById('email'));
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      setFieldError('email', "That email address looks off — could you double-check?");
      remember(document.getElementById('email'));
    }

    // — Website —
    const website = (data.get('website') as string)?.trim();
    if (!website) {
      setFieldError('website', 'Pop in your company website so we can read up on you.');
      remember(document.getElementById('website'));
    } else {
      try {
        const url = new URL(website);
        if (url.protocol !== 'http:' && url.protocol !== 'https:') {
          setFieldError('website', 'The address should start with https:// or http://');
          remember(document.getElementById('website'));
        }
      } catch {
        setFieldError('website', 'That web address looks off — try something like https://heliobio.com');
        remember(document.getElementById('website'));
      }
    }

    // — Company —
    if (!(data.get('company') as string)?.trim()) {
      setFieldError('company', 'Could you share the name of your company?');
      remember(document.getElementById('company'));
    }

    // — Services (multi-select) —
    const services = data.getAll('service') as string[];
    if (services.length === 0) {
      const serviceErr = document.getElementById('service-error');
      if (serviceErr) serviceErr.textContent = 'Pick at least one service so we know where to focus.';
      remember(document.querySelector<HTMLInputElement>('input[name="service"]'));
    }

    // — Timeline —
    const timeline = data.get('timeline') as string | null;
    if (!timeline) {
      const timelineErr = document.getElementById('timeline-error');
      if (timelineErr) timelineErr.textContent = "Let us know roughly when you'd like to start.";
      remember(document.querySelector<HTMLInputElement>('input[name="timeline"]'));
    }

    // — Project (now at the bottom of the form) —
    if (!(data.get('project') as string)?.trim()) {
      setFieldError('project', 'A few lines about your project will help us prepare a useful reply.');
      remember(document.getElementById('project'));
    }

    return firstInvalid;
  }

  /**
   * Bring an invalid field into view and put cursor focus on it.
   * For visually-hidden inputs (chip/checklist groups), scroll to the
   * surrounding wrapper so the visual chip is actually on screen.
   */
  function focusInvalid(el: HTMLElement) {
    const wrapper =
      el.closest('.form-group') ??
      el.closest('.form-chips') ??
      el.closest('.form-checklist') ??
      el;
    wrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
    // Slight delay lets the smooth scroll start before focus shifts — feels less abrupt.
    window.setTimeout(() => {
      try { el.focus({ preventScroll: true }); } catch { el.focus(); }
    }, 80);
  }

  /* ── Package dropdown: populate based on selected service ── */
  type PackageOpt = { value: string; label: string; price: string };
  const packageData: Record<string, PackageOpt[]> = JSON.parse(
    (document.getElementById('package-data') as HTMLScriptElement | null)?.textContent || '{}'
  );
  const preselect: { service: string; package: string } = JSON.parse(
    (document.getElementById('preselect-data') as HTMLScriptElement | null)?.textContent || '{}'
  );

  const packageList = document.getElementById('package-list');
  const packageHint = document.getElementById('package-hint');

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function populatePackages(selectedServices: string[], preselectedValues: string[] = []) {
    if (!packageList) return;

    // Preserve the user's existing checked packages across re-renders, plus any preselected ones.
    const existing = new Set<string>(
      Array.from(packageList.querySelectorAll<HTMLInputElement>('input[name="package"]:checked'))
        .map(el => el.value)
    );
    preselectedValues.forEach(v => v && existing.add(v));

    // Merge & dedupe packages from every selected service (keep first occurrence).
    const seen = new Set<string>();
    const merged: PackageOpt[] = [];
    selectedServices.forEach(svc => {
      (packageData[svc] || []).forEach(opt => {
        if (!seen.has(opt.value)) {
          seen.add(opt.value);
          merged.push(opt);
        }
      });
    });

    if (!merged.length) {
      packageList.innerHTML = '<p class="form-checklist__empty">Choose a service above first.</p>';
      return;
    }

    packageList.innerHTML = merged.map(opt => {
      const checked = existing.has(opt.value) ? 'checked' : '';
      const price = opt.price ? `<span class="form-check__price">${escapeHtml(opt.price)}</span>` : '';
      return `
        <label class="form-check">
          <input type="checkbox" name="package" value="${escapeHtml(opt.value)}" class="form-check__input" ${checked} />
          <span class="form-check__inner">
            <span class="form-check__box" aria-hidden="true"></span>
            <span class="form-check__label">${escapeHtml(opt.label)}</span>
            ${price}
          </span>
        </label>
      `;
    }).join('');
  }

  function getSelectedServices(): string[] {
    return Array.from(
      document.querySelectorAll<HTMLInputElement>('input[name="service"]:checked')
    ).map(el => el.value);
  }

  document.querySelectorAll<HTMLInputElement>('input[name="service"]').forEach(input => {
    input.addEventListener('change', () => populatePackages(getSelectedServices()));
  });

  // Initial populate (handles preselected service from URL or already-checked boxes)
  const initialServices = getSelectedServices();
  if (initialServices.length) {
    populatePackages(initialServices, preselect.package ? [preselect.package] : []);
    if (packageHint && preselect.package) {
      packageHint.innerHTML = 'Pre-selected from the pricing page. Adjust if needed.';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const data = new FormData(form);
    const invalid = validate(data);
    if (invalid) {
      focusInvalid(invalid);
      return;
    }

    if (submitBtn)     submitBtn.disabled = true;
    if (submitLabel)   submitLabel.textContent = 'Sending…';
    if (submitSpinner) submitSpinner.style.display = 'inline-block';

    try {
      const res = await fetch('/api/contact', { method: 'POST', body: data });
      const json = await res.json();

      if (res.ok) {
        if (card)    card.style.display = 'none';
        if (success) success.classList.add('is-visible');
      } else {
        if (errorBanner)  errorBanner.classList.add('is-visible');
        if (errorMessage) errorMessage.textContent = json.error ?? "Something didn't go through on our end. Please try again in a moment.";
      }
    } catch {
      if (errorBanner)  errorBanner.classList.add('is-visible');
      if (errorMessage) errorMessage.textContent = 'Looks like a connection hiccup. Check your network and try again.';
    } finally {
      if (submitBtn)     submitBtn.disabled = false;
      if (submitLabel)   submitLabel.textContent = 'Send my message';
      if (submitSpinner) submitSpinner.style.display = 'none';
    }
  });
</script>
