---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';

/* ── Service options (mirror NavBar "Services" submenu) ── */
const services = [
  {
    value: 'content',
    label: 'Content',
    sub: 'Company pages, written posts, newsletters and live events',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  },
  {
    value: 'advertising',
    label: 'Advertising',
    sub: 'Sponsored content, InMail campaigns and lead-gen forms',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
  },
  {
    value: 'consulting',
    label: 'Consulting',
    sub: 'Hands-on workshops, employee advocacy and executive personal branding',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2V3z" stroke="currentColor" stroke-width="1.6"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7V3z" stroke="currentColor" stroke-width="1.6"/></svg>`,
  },
];

/* ── Package options (mirror Pricing page) ── */
const packagesByService: Record<string, { value: string; label: string; price: string }[]> = {
  content: [
    { value: 'retainer-foundation', label: 'Foundation retainer',           price: '$1,800/mo' },
    { value: 'retainer-growth',     label: 'Growth retainer',               price: '$3,500/mo' },
    { value: 'retainer-scale',      label: 'Scale retainer',                price: '$6,000/mo' },
    { value: 'exec-ghostwriting',   label: 'Executive ghostwriting',        price: '$1,200/mo per leader' },
    { value: 'video-ai',            label: 'AI-generated video',            price: '$200–$5,000 per video' },
    { value: 'video-pro',           label: 'Professional video shooting',   price: 'Custom quote' },
    { value: 'multilingual',        label: 'Multilingual content',          price: 'Custom quote per language' },
    { value: 'enterprise',          label: 'Enterprise (multi-market)',     price: 'From $10,000/mo' },
    { value: 'not-sure',            label: "Not sure yet — let's discuss",  price: '' },
  ],
  advertising: [
    { value: 'ads-under-15k',       label: 'Ads management (under $15K/mo spend)', price: '$1,500/mo' },
    { value: 'ads-over-15k',        label: 'Ads management (over $15K/mo spend)',  price: '6–10% of spend' },
    { value: 'retainer-growth',     label: 'Growth retainer (includes ads)',       price: '$3,500/mo' },
    { value: 'retainer-scale',      label: 'Scale retainer (includes ads)',        price: '$6,000/mo' },
    { value: 'enterprise',          label: 'Enterprise (multi-market)',            price: 'From $10,000/mo' },
    { value: 'not-sure',            label: "Not sure yet — let's discuss",         price: '' },
  ],
  consulting: [
    { value: 'exec-profile',        label: 'Executive profile optimization',       price: '$500 one-time per profile' },
    { value: 'training-workshop',   label: 'Training workshop (2 hours)',          price: '$2,500 per session' },
    { value: 'training-program',    label: 'Team training program (4 sessions)',   price: '$8,000 one-time' },
    { value: 'advocacy',            label: 'Employee advocacy program',            price: '$2,500/mo' },
    { value: 'enterprise',          label: 'Enterprise (multi-market)',            price: 'From $10,000/mo' },
    { value: 'not-sure',            label: "Not sure yet — let's discuss",         price: '' },
  ],
};

/* ── Pre-selection from URL params (set by pricing page CTAs) ── */
const url = new URL(Astro.request.url);
const intentParam = url.searchParams.get('intent');
const tierParam   = url.searchParams.get('tier');

let preselectedService = '';
let preselectedPackage = '';
if (intentParam === 'retainer' && tierParam) {
  preselectedService = 'content';
  preselectedPackage = `retainer-${tierParam}`;
} else if (intentParam === 'enterprise') {
  preselectedService = 'content';
  preselectedPackage = 'enterprise';
}
---

<Layout
  title="Contact Nuvora Studio | Let's talk about your LinkedIn project"
  description="Whether you already know what you need or you're still weighing up options, we'd love to hear from you. Every message gets read by a real person and answered inside one working day."
  abstract="Tell us what you have in mind. We reply to every message inside one working day. No auto-responder, no scripted pitch, just a useful first conversation."
>
  <NavBar />
  <main id="main-content">

    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="contact-hero" aria-labelledby="contact-heading">
      <div class="contact-hero__bg" aria-hidden="true"></div>
      <div class="contact-hero__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="contact-hero__content">
          <p class="eyebrow eyebrow--light reveal">Start a conversation</p>
          <h1 id="contact-heading" class="contact-hero__h1 reveal reveal-delay-1">
            Let's talk <span class="text-gradient">LinkedIn.</span>
          </h1>
          <p class="contact-hero__sub reveal reveal-delay-2">
            Whether your project is fully scoped or you're still weighing the options, drop us a line. A real person reads every message, and you'll have a considered reply within one working day.
          </p>
          <div class="contact-hero__actions reveal reveal-delay-3">
            <a href="#contact-form" class="btn btn--primary btn--lg">Tell us about your project</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Form + Sidebar ────────────────────────────────────── -->
    <section class="section contact-section" style="background: var(--off-white);">
      <div class="container">
        <div class="contact-layout">

          <!-- ── Left: Form ── -->
          <div class="contact-form-col">

            <!-- Success state -->
            <div class="contact-success" id="contact-success" aria-live="polite">
              <div class="contact-success__icon">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                  <path d="M5 14l6.5 6.5L23 8" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <h2 class="contact-success__title">Thank you. Your message is on its way.</h2>
              <p class="contact-success__body">
                We've got it from here. Someone on the team will read it carefully and come back to you within one working day.
              </p>
              <a href="/" class="btn btn--primary" style="margin-top: var(--sp-6)">Back to the homepage</a>
            </div>

            <!-- Form card -->
            <div class="contact-card" id="contact-card">
              <div class="contact-card__header">
                <div class="contact-card__header-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M2 5a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V5z" stroke="var(--blue)" stroke-width="1.5"/>
                    <path d="M2 7l8 5 8-5" stroke="var(--blue)" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div>
                  <h2 class="contact-card__title">A few details so we can come prepared</h2>
                  <p class="contact-card__note">
                    Anything marked with an asterisk <span aria-hidden="true">*</span> is essential. The rest is entirely up to you.
                  </p>
                </div>
              </div>

              <form id="contact-form" class="contact-form" novalidate aria-label="Contact form">
                <input type="text" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;opacity:0;pointer-events:none;" />
                <input type="hidden" name="form_ts" id="form-ts" value="" />
                <div class="contact-form__grid">

                  <!-- Name -->
                  <div class="form-group">
                    <label class="form-label" for="name">
                      Your name <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input class="form-input" type="text" id="name" name="name"
                      autocomplete="name" required placeholder="Mariana Castillo" />
                    <span class="form-error" id="name-error" role="alert"></span>
                  </div>

                  <!-- Email -->
                  <div class="form-group">
                    <label class="form-label" for="email">
                      Your email <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input class="form-input" type="email" id="email" name="email"
                      autocomplete="email" required placeholder="mariana@heliobio.com" />
                    <span class="form-error" id="email-error" role="alert"></span>
                  </div>

                  <!-- Phone -->
                  <div class="form-group">
                    <label class="form-label" for="phone">
                      Your phone <span class="form-optional">(optional)</span>
                    </label>
                    <input class="form-input" type="tel" id="phone" name="phone"
                      autocomplete="tel" placeholder="+44 20 7946 0958" />
                  </div>

                  <!-- Website -->
                  <div class="form-group">
                    <label class="form-label" for="website">
                      Your website <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input class="form-input" type="url" id="website" name="website"
                      autocomplete="url" required placeholder="https://heliobio.com" />
                    <span class="form-error" id="website-error" role="alert"></span>
                  </div>

                  <!-- Company -->
                  <div class="form-group contact-form__full">
                    <label class="form-label" for="company">
                      Your company name <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input class="form-input" type="text" id="company" name="company"
                      autocomplete="organization" required placeholder="Helio Biosciences" />
                    <span class="form-error" id="company-error" role="alert"></span>
                  </div>

                  <!-- Service (multi-select) -->
                  <div class="form-group contact-form__full">
                    <label class="form-label">
                      Which of our services interest you? <span class="required-mark" aria-hidden="true">*</span>
                      <span class="form-optional">Pick as many as feel relevant.</span>
                    </label>
                    <div class="form-chips" role="group" aria-label="Services" id="service-group">
                      {services.map((s) => (
                        <label class="form-chip">
                          <input
                            type="checkbox"
                            name="service"
                            value={s.value}
                            class="form-chip__input"
                            data-service={s.value}
                            checked={preselectedService === s.value}
                          />
                          <span class="form-chip__inner">
                            <span class="form-chip__icon" set:html={s.icon} />
                            <span class="form-chip__text">
                              <strong class="form-chip__label">{s.label}</strong>
                              <span class="form-chip__sub">{s.sub}</span>
                            </span>
                          </span>
                        </label>
                      ))}
                    </div>
                    <span class="form-error" id="service-error" role="alert"></span>
                  </div>

                  <!-- Package (multi-select) -->
                  <div class="form-group contact-form__full">
                    <label class="form-label" id="package-label">
                      Any of our packages catching your eye? <span class="form-optional">(optional)</span>
                    </label>
                    <div class="form-checklist" role="group" aria-labelledby="package-label" id="package-list">
                      <p class="form-checklist__empty">Pick a service above to see the matching packages.</p>
                    </div>
                    <p class="form-hint" id="package-hint">Prices match our <a href="/pricing">pricing page</a>. Still weighing things up? Leave it blank and we'll cover it on the call.</p>
                  </div>

                  <!-- Timeline -->
                  <div class="form-group contact-form__full">
                    <label class="form-label">
                      When would you like to get started? <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <div class="form-chips form-chips--compact" role="radiogroup" aria-label="Timeline" id="timeline-group">
                      <label class="form-chip form-chip--compact">
                        <input type="radio" name="timeline" value="now" class="form-chip__input" required />
                        <span class="form-chip__inner">
                          <strong class="form-chip__label">As soon as possible</strong>
                          <span class="form-chip__sub">Within the next few weeks</span>
                        </span>
                      </label>
                      <label class="form-chip form-chip--compact">
                        <input type="radio" name="timeline" value="3-months" class="form-chip__input" />
                        <span class="form-chip__inner">
                          <strong class="form-chip__label">In about three months</strong>
                          <span class="form-chip__sub">Laying the groundwork</span>
                        </span>
                      </label>
                      <label class="form-chip form-chip--compact">
                        <input type="radio" name="timeline" value="6-months" class="form-chip__input" />
                        <span class="form-chip__inner">
                          <strong class="form-chip__label">Roughly six months out</strong>
                          <span class="form-chip__sub">Planning ahead for later</span>
                        </span>
                      </label>
                    </div>
                    <span class="form-error" id="timeline-error" role="alert"></span>
                  </div>

                  <!-- Project -->
                  <div class="form-group contact-form__full">
                    <label class="form-label" for="project">
                      Tell us about your project, in your own words <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <textarea class="form-textarea" id="project" name="project"
                      required rows="5"
                      placeholder="A few sentences are plenty. For example: We're a 120-person biotech expanding into Europe and want our leadership team much more visible on LinkedIn over the next year…"
                    ></textarea>
                    <span class="form-error" id="project-error" role="alert"></span>
                  </div>
                </div>

                <!-- Package catalog data for the client script -->
                <script type="application/json" id="package-data" is:inline set:html={JSON.stringify(packagesByService)}></script>
                <script type="application/json" id="preselect-data" is:inline set:html={JSON.stringify({ service: preselectedService, package: preselectedPackage })}></script>

                <!-- Error banner -->
                <div class="form-banner" id="form-error-banner" role="alert">
                  <span id="form-error-message"></span>
                </div>

                <div class="contact-form__actions">
                  <button type="submit" class="btn btn--primary btn--lg" id="submit-btn">
                    <span id="submit-label">Send my message</span>
                    <span id="submit-spinner" class="submit-spinner" style="display:none" aria-hidden="true"></span>
                  </button>
                  <p class="contact-form__privacy">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 1L2 3v3c0 2.5 1.7 4.7 4 5.4C8.3 10.7 10 8.5 10 6V3L6 1z" stroke="var(--text-3)" stroke-width="1.2" fill="none"/></svg>
                    Your details stay with us. We will never sell or share them with anyone.
                  </p>
                </div>
              </form>
            </div>

          </div>

          <!-- ── Right: Sidebar ── -->
          <aside class="contact-sidebar" aria-label="Contact information">

            <!-- What happens next -->
            <div class="sidebar-card sidebar-card--steps reveal">
              <h3 class="sidebar-card__title">What happens next</h3>
              <ol class="steps-list">
                <li class="step-item">
                  <div class="step-item__number" aria-hidden="true">1</div>
                  <div class="step-item__content">
                    <strong>A real person reads what you sent</strong>
                    <p>Someone on the team reads your message carefully, usually within a few hours and always inside one working day. No auto-replies, no queue.</p>
                  </div>
                </li>
                <li class="step-item">
                  <div class="step-item__number" aria-hidden="true">2</div>
                  <div class="step-item__content">
                    <strong>A proper, thirty-minute call</strong>
                    <p>If it feels like a fit on both sides, we set up a short call to talk through your goals. No slides, no pitch, just an honest exchange.</p>
                  </div>
                </li>
                <li class="step-item">
                  <div class="step-item__number" aria-hidden="true">3</div>
                  <div class="step-item__content">
                    <strong>A proposal that actually fits you</strong>
                    <p>Within a few days you receive a written proposal shaped around your audience and your goals. Never a template with your logo on top.</p>
                  </div>
                </li>
              </ol>
            </div>

            <!-- Trust signals -->
            <div class="sidebar-card sidebar-card--trust reveal reveal-delay-1">
              <h3 class="sidebar-card__title">Why Nuvora</h3>
              <ul class="trust-list">
                <li class="trust-item">
                  <div class="trust-item__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 1.5l1.8 3.6 4 .58-2.9 2.83.69 3.99L8 10.27l-3.59 1.88.69-3.99-2.9-2.83 4-.58L8 1.5z" fill="var(--cyan)" opacity="0.9"/>
                    </svg>
                  </div>
                  <span>AI runs in the background. Real people own your brand voice.</span>
                </li>
                <li class="trust-item">
                  <div class="trust-item__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <rect x="2" y="4" width="12" height="9" rx="1.5" stroke="var(--cyan)" stroke-width="1.4"/>
                      <path d="M5 4V3a3 3 0 016 0v1" stroke="var(--cyan)" stroke-width="1.4"/>
                    </svg>
                  </div>
                  <span>Nothing goes live without your sign-off, ever</span>
                </li>
                <li class="trust-item">
                  <div class="trust-item__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 2C5.24 2 3 4.24 3 7c0 2.76 2.24 5 5 5s5-2.24 5-5-2.24-5-5-5z" stroke="var(--cyan)" stroke-width="1.4"/>
                      <path d="M8 5v3l2 1" stroke="var(--cyan)" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </div>
                  <span>Trusted by B2B companies across every time zone</span>
                </li>
                <li class="trust-item">
                  <div class="trust-item__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M13 5L6 12 3 9" stroke="var(--cyan)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <span>Every piece of content we create is yours to keep, forever</span>
                </li>
              </ul>
            </div>

            <!-- Pricing anchor -->
            <div class="sidebar-card sidebar-card--pricing reveal reveal-delay-2">
              <div class="pricing-anchor__top">
                <span class="pricing-anchor__label">Engagements start at</span>
                <span class="pricing-anchor__value">$1,800<span>/month</span></span>
              </div>
              <p class="pricing-anchor__note">Flexible monthly retainers. No long-term lock-in after the first three months.</p>
              <a href="/pricing" class="pricing-anchor__link">
                See the full pricing
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>

          </aside>

        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* ══════════════════════════════════════════
     HERO
  ══════════════════════════════════════════ */
  .contact-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--sp-32) var(--sp-24);
    min-height: 520px;
    display: flex;
    align-items: center;
  }

  .contact-hero__bg {
    position: absolute;
    inset: 0;
    background: url('/images/contact-hero-people.webp') center center / cover no-repeat;
    z-index: 0;
  }

  .contact-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(15,23,42, 0.92) 0%,
      rgba(15,23,42, 0.75) 50%,
      rgba(15,23,42, 0.45) 100%
    );
    z-index: 1;
  }

  .contact-hero__content {
    max-width: 680px;
  }

  .contact-hero__h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.10;
    letter-spacing: -0.02em;
    margin-block: var(--sp-5) var(--sp-6);
  }
  .contact-hero__h1 .text-gradient {
    background: linear-gradient(135deg, var(--cyan) 0%, var(--sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .contact-hero__sub {
    font-size: var(--fs-md);
    color: rgba(255, 255, 255, 0.68);
    max-width: 520px;
    line-height: 1.75;
    margin-bottom: var(--sp-10);
  }

  .contact-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  @media (max-width: 640px) {
    .contact-hero { padding-block: var(--sp-16) var(--sp-12); }
  }

  /* ══════════════════════════════════════════
     LAYOUT: two columns
  ══════════════════════════════════════════ */
  .contact-section { padding-block: var(--sp-16) var(--sp-24); }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--sp-10);
    align-items: start;
  }

  /* ══════════════════════════════════════════
     FORM CARD
  ══════════════════════════════════════════ */
  .contact-success {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--sp-20) var(--sp-10);
    background: var(--white);
    border-radius: var(--r-2xl);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }
  .contact-success.is-visible { display: flex; }

  .contact-success__icon {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: var(--sky);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sp-6);
    box-shadow: 0 0 0 10px rgba(14,165,233,0.10);
  }

  .contact-success__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--deep-navy);
    margin-bottom: var(--sp-3);
    letter-spacing: -0.02em;
  }

  .contact-success__body {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--text-2);
    max-width: 360px;
    line-height: 1.75;
  }

  .contact-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .contact-card__header {
    padding: var(--sp-8) var(--sp-10) var(--sp-6);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .contact-card__header-icon {
    width: 40px; height: 40px;
    flex-shrink: 0;
    background: rgba(14,165,233,0.07);
    border-radius: var(--r-lg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600;
    color: var(--deep-navy);
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }

  .contact-card__note {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .contact-form {
    padding: var(--sp-8) var(--sp-10);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
  }

  .contact-form__full { grid-column: 1 / -1; }
  .required-mark { color: var(--sky); margin-left: 2px; }
  .form-optional { color: var(--text-3); font-weight: 400; font-size: var(--fs-xs); }

  .form-error {
    font-size: var(--fs-xs);
    color: #c0392b;
    min-height: 16px;
    display: block;
  }

  .form-input.is-invalid,
  .form-textarea.is-invalid {
    border-color: #c0392b;
    box-shadow: 0 0 0 3px rgba(192,57,43,0.08);
