  .form-banner {
    display: none;
    padding: var(--sp-4);
    background: #FEF2F2;
    border: 1px solid rgba(192,57,43,0.15);
    border-radius: var(--r-md);
    font-size: var(--fs-sm);
    color: #c0392b;
  }
  .form-banner.is-visible { display: block; }

  /* ── Chip groups (Service / Timeline) ── */
  .form-chips {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3);
    margin-top: var(--sp-1);
  }

  .form-chip {
    position: relative;
    cursor: pointer;
    display: block;
  }

  .form-chip__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    inset: 0;
  }

  .form-chip__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-4);
    background: var(--white);
    border: 1.5px solid var(--border);
    border-radius: var(--r-lg);
    transition:
      border-color var(--t-fast),
      background var(--t-fast),
      box-shadow var(--t-fast),
      transform var(--t-fast);
    height: 100%;
  }

  /* Tiny checkmark badge — only shown for service chips when checked */
  #service-group .form-chip__inner::after {
    content: '';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--border);
    background: var(--white);
    transition: background var(--t-fast), border-color var(--t-fast);
  }

  #service-group .form-chip__input:checked + .form-chip__inner::after {
    background: var(--sky)
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M3 6.5l2 2 4-5' stroke='white' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>")
      center / 11px no-repeat;
    border-color: var(--sky);
  }

  .form-chip:hover .form-chip__inner {
    border-color: var(--border-2);
    background: var(--off-white);
  }

  .form-chip__input:focus-visible + .form-chip__inner {
    border-color: var(--sky);
    box-shadow: 0 0 0 3px rgba(14,165,233,0.18);
  }

  .form-chip__input:checked + .form-chip__inner {
    border-color: var(--sky);
    background: rgba(14,165,233,0.04);
    box-shadow: 0 0 0 1px var(--sky) inset;
  }

  .form-chip__icon {
    flex-shrink: 0;
    width: 36px; height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-md);
    background: rgba(14,165,233,0.08);
    color: var(--sky);
    transition: background var(--t-fast), color var(--t-fast);
  }

  .form-chip__input:checked + .form-chip__inner .form-chip__icon {
    background: var(--sky);
    color: var(--white);
  }

  .form-chip__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .form-chip__label {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
  }

  .form-chip__sub {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--text-3);
    line-height: 1.35;
  }

  /* Compact variant — used for the timeline row, no icons */
  .form-chips--compact .form-chip__inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: var(--sp-3) var(--sp-4);
  }

  /* Disabled state for the package select before service is chosen */
  .form-select:disabled {
    background: var(--off-white);
    color: var(--text-3);
    cursor: not-allowed;
  }

  /* ── Package checklist (multi-select rows) ── */
  .form-checklist {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-top: var(--sp-1);
    padding: var(--sp-2);
    background: var(--off-white);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }

  .form-checklist__empty {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--text-3);
    padding: var(--sp-4);
    text-align: center;
  }

  .form-check {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .form-check__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    inset: 0;
  }

  .form-check__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    background: var(--white);
    border: 1.5px solid transparent;
