---
/** /help/<slug>: one article of the help center, English (src/components/help/HelpArticle.astro). */
import HelpArticle from '../../components/help/HelpArticle.astro';
import { helpArticles } from '../../lib/help';

export function getStaticPaths() {
  return helpArticles('en').map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
---

<HelpArticle lang="en" slug={slug!} />
