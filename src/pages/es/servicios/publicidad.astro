---
import Layout from '../../../layouts/Layout.astro';
import NavBar from '../../../components/NavBar.astro';
import FAQ from '../../../components/FAQ.astro';
import { servicePageSchemas } from '../../../i18n/schemas';

const capabilities = [
  {
    title: 'Arquitectura de campaña',
    body: 'Diseñamos la estructura de tus campañas en torno a tu embudo de venta. Cada formato, cada buyer persona y cada mensaje cumple un papel concreto. Nada se solapa y nada cae al vacío.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
      <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
      <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
      <rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
    </svg>`,
  },
  {
    title: 'Segmentación quirúrgica',
    body: "Construimos tus audiencias por cargo, nivel jerárquico, empresa, plantilla, sector de actividad y aptitudes. Y cuando hace falta tirar de Account-Based Marketing, vamos directamente a la cuenta donde están quienes firman el contrato.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.6"/>
      <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
    </svg>`,
  },
  {
    title: 'Diseño de los anuncios',
    body: "Redactamos y diseñamos cada anuncio en casa. Los copys atacan el dolor real de tu comprador, nada de generalidades vacías. Los visuales están pensados para el feed de LinkedIn tal y como rinde de verdad. Todo se prueba en varios segmentos antes de meter un solo euro en serio.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 20h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>`,
  },
  {
    title: 'Despliegue en todos los formatos',
    body: "Operamos todos los formatos publicitarios de LinkedIn dentro de un mismo sistema. Sin silos, sin campañas lanzadas a salto de mata. El objetivo: un dispositivo integrado que alimenta tu pipeline comercial mes a mes.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 6h16M4 10h16M4 14h16M4 18h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>`,
  },
  {
    title: 'Optimización con IA',
    body: "Usamos la inteligencia artificial para producir y testar variantes de copy, mensajes y visuales sobre distintos segmentos de audiencia. Detectamos qué funciona por cargo y por nivel jerárquico mucho antes de haber agotado el presupuesto. Las campañas se afinan semana tras semana.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2l2.09 6.26L20 10l-5.91 1.74L12 18l-2.09-6.26L4 10l5.91-1.74L12 2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>`,
  },
  {
    title: 'Reporting conectado a tu CRM',
    body: "Rendimos cuentas sobre el pipeline de negocio, no sobre impresiones. Cada informe detalla cuánto se ha invertido, qué se ha probado, qué ha rendido y qué cambiamos a la semana siguiente. Sin jerga ni cifras de adorno.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/>
      <path d="M7 17V13M12 17V9M17 17V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>`,
  },
];

const adFormats = [
  {
    title: 'Contenido patrocinado',
    body: "El formato base de LinkedIn y, de largo, el más versátil. Tiene ocho variantes: imagen, carrusel, vídeo, documento, evento, tribuna de directivo, artículo y publicidad en televisión conectada. Lo usamos para instalar notoriedad, atrapar atención y traer visitantes cualificados a la parte alta del embudo.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>`,
    image: '/images/advertising-sponsored-content.webp',
    imageAlt: 'Pieza de campaña de contenido patrocinado',
  },
  {
    title: 'Mensajería patrocinada',
    body: "Aquí hay dos variantes. Los anuncios por mensaje apuntan a un único objetivo con un solo botón de acción. Los anuncios conversacionales ofrecen varios caminos y deja que sea el destinatario quien elija. ¿El denominador común? Todo aterriza directamente en la bandeja de entrada de LinkedIn, justo cuando tu prospecto está activo en la plataforma.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/>
      <path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>`,
    image: '/images/advertising-sponsored-messaging.webp',
    imageAlt: 'Pieza de campaña de mensajería patrocinada',
  },
  {
    title: 'Anuncios dinámicos',
    body: "Estos anuncios se personalizan automáticamente a partir del perfil de cada usuario. Hay versiones para hacer crecer tu página (seguidores), para mandar tráfico a tu web (destacar) y para captar leads cuando alguien descarga un contenido (contenido). Cero visuales que producir a mano para cada persona.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2l2.09 6.26L20 10l-5.91 1.74L12 18l-2.09-6.26L4 10l5.91-1.74L12 2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
    </svg>`,
    image: '/images/advertising-dynamic-ads.webp',
    imageAlt: 'Pieza de campaña de anuncios dinámicos',
  },
  {
    title: 'Anuncios de texto',
    body: "Publicidad de clic en modo autoservicio, situada en la columna lateral del escritorio. Es el formato más económico de LinkedIn y no exige compromiso de inversión. En nuestras manos funciona como herramienta de precisión dentro del dispositivo global. Nunca lo lanzamos en solitario.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 6h16M4 10h16M4 14h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <rect x="16" y="14" width="5" height="7" rx="1" stroke="currentColor" stroke-width="1.6"/>
    </svg>`,
    image: '/images/advertising-text-ads.webp',
    imageAlt: 'Pieza de campaña de anuncios de texto',
  },
  {
    title: 'Formularios de captación',
    body: "Formularios prerrellenados, integrados nativamente en LinkedIn. El usuario pulsa dos clics y listo: sin página externa, sin campos que volver a teclear. Los combinamos con contenido patrocinado y mensajería para empujar la conversión en cada fase del embudo.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="5" y="3" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/>
      <path d="M9 7h6M9 11h6M9 15h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>`,
    image: '/images/advertising-lead-gen-forms.webp',
    imageAlt: 'Pieza de formularios de captación de contactos',
  },
];

const differentiators = [
  {
    title: 'Estamos certificados por LinkedIn.',
    body: "No es solo un logo decorativo en la web. Nuestro equipo ha cursado y aprobado la evaluación oficial de LinkedIn en estrategia, formatos, segmentación, medición y optimización. En la práctica, significa que trabajas con gente que opera al máximo nivel de exigencia que define la propia plataforma.",
  },
  {
    title: 'Pensamos en embudo, no en formatos sueltos.',
    body: "La mayoría de agencias lanzan contenido patrocinado o formularios de captación de manera aislada. Nosotros montamos un dispositivo completo en el que cada formato cumple su papel, desde la notoriedad hasta la firma del contrato. Así es como el coste de adquisición baja y la calidad de los leads sube a la vez.",
  },
  {
    title: "Medimos facturación, no visibilidad.",
    body: "Las impresiones no pagan facturas. Conectamos tus campañas de LinkedIn directamente a tu CRM comercial para saber qué anuncios generan negocio real. La optimización semanal solo se apoya en los indicadores que importan para tu dirección comercial. El resto, fuera del cuadro de mando.",
  },
  {
    title: 'Probamos antes de invertir en serio.',
    body: "Con la IA producimos y testamos decenas de variantes de copy, ganchos y botones de acción antes de comprometer tu presupuesto a gran escala. El día que volcamos recursos en una campaña, ya sabemos exactamente qué está funcionando.",
  },
  {
    title: 'Nos encargamos de todo.',
    body: "Estrategia, diseño, segmentación, lanzamiento, optimización y balance. Todo. No tienes que llamar a un estratega por un lado, a un diseñador por otro y a un media buyer en un tercer punto. Un solo equipo, una sola operativa, un único interlocutor.",
  },
  {
    title: 'El B2B es nuestro único oficio.',
    body: "No hacemos publicidad de gran consumo en paralelo. La publicidad B2B en LinkedIn es lo único que hacemos. Ciclos de venta de varios meses, cuatro o cinco perfiles a convencer dentro de la misma empresa y un lead que cuesta 200 € pero puede acabar en un contrato de 200.000 €: ese es nuestro día a día.",
  },
];

const steps = [
  {
    num: '01',
    title: 'Diagnóstico',
    body: "Dedicamos tiempo a entender tu empresa, tus compradores y tus objetivos comerciales. Revisamos todo lo que ya has hecho en LinkedIn, qué funcionó y qué no, y localizamos dónde están las verdaderas bolsas de crecimiento.",
  },
  {
    num: '02',
    title: 'Construcción',
    body: "Arquitectura de campañas, composición de audiencias, redacción de los anuncios y producción de los visuales. Todo se estructura alrededor de tu embudo de venta y del ciclo comercial real de tu sector.",
  },
  {
    num: '03',
    title: 'Lanzamiento y testing',
    body: "Lanzamos las campañas y las pruebas arrancan en paralelo. Copys, visuales, audiencias, formatos, botones de acción: todo se testea a la vez. La IA nos ayuda a aflorar las combinaciones ganadoras mucho más rápido que un equipo trabajando a mano.",
  },
  {
    num: '04',
    title: 'Optimización y escalado',
    body: "Cada semana optimizamos en función de lo que genera negocio real, no de los simples clics. Lo que funciona se escala, lo que no rinde se corta. Y cada mes recibes un informe que enlaza directamente tu gasto publicitario con tu facturación.",
  },
];

const stats = [
  { number: '121 %', label: 'ROAS publicitario', note: "Retorno sobre la inversión publicitaria de LinkedIn en B2B, frente al 67 % de Google Search y al 51 % de Meta.", source: 'Fuente: informe Dreamdata 2026' },
  { number: '6,1 %', label: 'Tasa de conversión', note: 'Tasa de conversión media en LinkedIn (EE. UU.), frente al 3,75 % de Google Search y al 0,77 % de la display de Google.' },
  { number: '80 %', label: 'Leads B2B sociales', note: "El 80 % de los leads B2B que vienen de redes sociales nacen en LinkedIn. De Meta no. Del resto, tampoco." },
  { number: '41 %', label: 'Cuota de presupuesto', note: "Peso de LinkedIn dentro de los presupuestos publicitarios B2B. Es la primera partida de inversión concentrada en una sola plataforma." },
  { number: '10-13 %', label: 'Tasa de formularios', note: "Tasa de conversión de los formularios nativos de captación, frente al 2,35 % de las landings clásicas." },
  { number: '4 de cada 5', label: 'Influyen en la compra', note: "Usuarios de LinkedIn que participan en las decisiones de compra de su empresa." },
  { number: '211', label: 'Días hasta la firma', note: "Duración media del ciclo de compra B2B, desde el primer contacto hasta la firma. Por eso hace falta un dispositivo que cubra todo el recorrido." },
  { number: '33 %', label: "Intención de compra", note: "Incremento de intención de compra en las marcas que hacen publicidad en LinkedIn. Está medido, no estimado." },
];

const faqs = [
  {
    q: "¿Qué significa exactamente «certificado por LinkedIn»?",
    a: "Significa que el equipo ha cursado y aprobado el programa de certificación oficial de LinkedIn, el que cubre estrategia de campaña, formatos publicitarios, segmentación, medición y optimización. Es el referente que la propia plataforma define en materia de expertise publicitaria. No todas las agencias lo consiguen, nosotros sí.",
  },
  {
    q: '¿Qué formatos publicitarios de LinkedIn gestionáis?',
    a: "Los cinco. Contenido patrocinado (con sus ocho variantes), mensajería patrocinada (anuncios por mensaje y conversacionales), anuncios dinámicos, anuncios de texto y formularios de captación. Todo se gestiona dentro de una misma operativa, no como campañas sueltas que viven cada una por su lado.",
  },
  {
    q: "¿Os encargáis solo de la compra de medios o también de estrategia y creatividad?",
    a: "De todo. Partimos de tu cliente objetivo, de tu embudo de venta y de tus objetivos comerciales. A partir de ahí diseñamos la arquitectura, redactamos los copys, producimos los visuales, lanzamos, testamos y optimizamos. Un único equipo se ocupa de principio a fin.",
  },
  {
    q: '¿Cómo se rinde cuentas de los resultados?',
    a: "Medimos sobre el pipeline. Cada semana recibes una nota de optimización y, cada mes, un informe de rendimiento. Dentro encuentras cuánto se ha invertido, qué se ha probado, qué ha funcionado y qué vamos a ajustar. Sin jerga ni cifras de adorno.",
  },
  {
    q: "¿Cómo se utiliza la inteligencia artificial?",
    a: "La usamos para producir y testar variantes de copys, mensajes y visuales sobre distintos segmentos de audiencia. Eso nos permite saber qué funciona mejor por cargo y por nivel jerárquico antes de haber agotado el presupuesto. La optimización va más rápido y el coste de adquisición baja.",
  },
  {
    q: '¿Qué presupuesto publicitario mínimo hay que prever?',
    a: "Trabajamos con empresas que se toman LinkedIn en serio como palanca de desarrollo comercial. Si tu presupuesto mensual queda por debajo de 5.000 €, lo más probable es que LinkedIn todavía no sea el canal adecuado. Te lo decimos en la primera llamada, no vamos a hacerte perder el tiempo.",
  },
  {
    q: '¿En cuánto tiempo se pueden esperar resultados?',
    a: "La mayoría de clientes ve llegar leads cualificados en los primeros 30 días. Pero hay que tener presente que LinkedIn cubre todo el recorrido de compra y que un ciclo B2B dura, de media, 211 días. El valor real se construye a lo largo de varios meses, a medida que las campañas acumulan datos y la segmentación se afina.",
  },
  {
    q: "¿Hace falta una página de empresa sólida antes de lanzar campañas?",
    a: "Suma mucho, pero no es bloqueante. Quien vea tu anuncio acabará pasando por tu página corporativa antes de dar el siguiente paso. Si conviene, ponemos a punto la página durante la fase de arranque para que todo esté en orden antes del primer impacto.",
  },
  {
    q: '¿Podéis segmentar empresas o funciones concretas?',
    a: "Sí, y aquí LinkedIn no tiene equivalente real. Segmentamos por cargo, nivel jerárquico, empresa, tamaño de plantilla, sector, aptitudes y muchos otros criterios. Llegas a quien decide la compra y a nadie más.",
  },
  {
    q: "¿En qué sectores trabaja Nuvora?",
    a: "Tecnología, industria, servicios B2B, software, salud y algún sector adicional. Mientras tus compradores estén en LinkedIn y tus contratos superen los 20.000 €, podemos montar un dispositivo que se autofinancie.",
  },
  {
    q: '¿Cómo se empieza?',
    a: "Reservas una llamada. Revisamos juntos tu presencia en LinkedIn, hablamos sobre tus objetivos comerciales y te decimos con franqueza si la publicidad en LinkedIn es el canal adecuado para ti. Sin presentación interminable. Sin presión.",
  },
];
---

<Layout
  preloadHero="/images/advertising-hero.webp"
  title="Publicidad en LinkedIn | Más leads B2B cualificados"
  description="Todos los formatos publicitarios de LinkedIn gestionados dentro de un mismo dispositivo, diseñado para generar leads B2B. Segmentación quirúrgica, optimización con IA e informes orientados a pipeline."
  abstract="Operamos todos los formatos publicitarios de LinkedIn para que generes más leads B2B cualificados. Segmentación precisa, dispositivo que cubre todo el embudo de venta e informes que miden negocio firmado, no impresiones."
  lang="es"
  schemas={servicePageSchemas('es', 'advertising')}
>
  <NavBar lang="es" />
  <main id="main-content">

    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="ads-hero" aria-labelledby="ads-heading">
      <div class="ads-hero__bg" aria-hidden="true"></div>
      <div class="ads-hero__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="ads-hero__content">
          <p class="eyebrow eyebrow--light reveal">Publicidad en LinkedIn</p>
          <h1 id="ads-heading" class="ads-hero__h1 reveal reveal-delay-1">
            Anuncios en LinkedIn que transforman clics en <span class="text-gradient">negocio firmado.</span>
          </h1>
          <p class="ads-hero__sub reveal reveal-delay-2">
            Que tus compradores viven en LinkedIn ya lo sabes. Lo que hacemos nosotros es asegurarnos de que tus anuncios impacten a los interlocutores adecuados, en el momento adecuado y con el mensaje adecuado, y de convertir esa atención en leads cualificados con los que tu equipo comercial pueda trabajar.
          </p>
          <div class="ads-hero__actions reveal reveal-delay-3">
            <a href="/es/contacto?intent=call" class="btn btn--primary btn--lg">Reservar una llamada</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── The Problem ─────────────────────────────────────── -->
    <section class="section problem" aria-labelledby="problem-heading">
      <div class="container">
        <div class="problem__inner">
          <div class="problem__text">
            <h2 id="problem-heading" class="problem__h2 reveal">La mayoría de empresas tira por la borda su presupuesto publicitario en LinkedIn</h2>
            <div class="problem__body">
              <p class="problem__p reveal">Patrocinan un post. Eligen una audiencia demasiado amplia. Y cruzan los dedos.</p>
              <p class="problem__p reveal">¿Resultado? Coste por clic disparado, leads sin pulso y ninguna conexión clara entre lo que se gasta y lo que se ingresa.</p>
              <p class="problem__p reveal">La publicidad en LinkedIn funciona. Pero a condición de pensarla como un dispositivo integral, no como una sucesión de campañas desconectadas entre sí.</p>
              <p class="problem__p problem__p--highlight reveal">Es exactamente lo que hacemos aquí.</p>
            </div>
          </div>
          <div class="problem__visual reveal reveal-delay-2" aria-hidden="true">
            <div class="problem__graphic">
              <div class="problem__bar problem__bar--1"><span>Presupuesto tirado</span></div>
              <div class="problem__bar problem__bar--2"><span>Contactos sin valor</span></div>
              <div class="problem__bar problem__bar--3"><span>Sin trazabilidad</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── What We Do ──────────────────────────────────────── -->
    <section class="section what-we-do" aria-labelledby="wwd-heading">
      <div class="container">
        <div class="wwd__head reveal">
          <p class="eyebrow">Nuestro enfoque</p>
          <h2 id="wwd-heading" class="wwd__h2">Diseñamos y operamos tu estrategia publicitaria de LinkedIn de principio a fin</h2>
          <p class="wwd__intro">No te entregamos un documento de estrategia y te deseamos suerte. Asumimos el proceso completo, desde la definición de la audiencia hasta el seguimiento del negocio firmado. Nuestro equipo está <strong>certificado por LinkedIn</strong>, lo que en la práctica significa que cumple con el referente oficial de la plataforma en estrategia, segmentación y optimización.</p>
        </div>

        <div class="wwd__grid">
          {capabilities.map((cap, i) => (
            <div class={`wwd-card reveal${i > 0 ? ` reveal-delay-${Math.min(i, 3)}` : ''}`}>
              <div class="wwd-card__top">
                <span class="wwd-card__icon" aria-hidden="true" set:html={cap.icon} />
              </div>
              <strong class="wwd-card__title">{cap.title}</strong>
              <p class="wwd-card__body">{cap.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Ad Formats We Run ───────────────────────────────── -->
    <section class="section formats-section" aria-labelledby="formats-heading">
      <div class="container">
        <div class="formats__head reveal">
          <p class="eyebrow">Formatos publicitarios</p>
          <h2 id="formats-heading" class="formats__h2">Todos los formatos publicitarios de LinkedIn. Un único equipo certificado.</h2>
          <p class="formats__intro">LinkedIn ofrece cinco formatos publicitarios y cada uno cumple un papel distinto dentro del embudo de venta. La mayoría de agencias se queda en uno o dos. Nosotros operamos los cinco dentro del mismo dispositivo, porque es la única forma de mover a un comprador del descubrimiento a la firma. El equipo certificado sabe cuándo activar cada palanca y cómo.</p>
        </div>

        {adFormats.map((fmt, i) => (
          <div class={`fmt-block${i % 2 === 1 ? ' fmt-block--flip' : ''} reveal`} id={`fmt-${i}`}>
            <div class="fmt-block__text">
              <div class="fmt-block__label">
                <span class="fmt-block__icon" aria-hidden="true" set:html={fmt.icon} />
              </div>
              <h3 class="fmt-block__title">{fmt.title}</h3>
              <p class="fmt-block__body">{fmt.body}</p>
            </div>
            <div class="fmt-block__visual">
              <div class="fmt-block__img-wrap">
                <img
                  src={fmt.image}
                  alt={fmt.imageAlt}
                  class="fmt-block__img"
                  width="560"
                  height="380"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Why Work With Us ────────────────────────────────── -->
    <section class="section why-us" aria-labelledby="why-heading">
      <div class="why-us__bg" aria-hidden="true"></div>
      <div class="container">
        <div class="why__head reveal">
          <p class="eyebrow eyebrow--light">Por qué nosotros</p>
          <h2 id="why-heading" class="why__h2">Lo que nos distingue</h2>
        </div>

        <div class="why__layout">

          <!-- Left: Visual column -->
          <div class="why__visual reveal">
            <!-- Team photo placeholder -->
            <div class="why__photo-wrap">
              <img
                src="/images/advertising-team.webp"
                alt="El equipo de Nuvora Studio"
                class="why__photo"
                width="480"
                height="560"
                loading="lazy"
              />
            </div>

            <!-- Certification badge -->
            <div class="why__cert">
              <div class="why__cert-badge">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                  <path d="M14 2l3.09 6.26L24 10l-6.91 2.74L14 22l-3.09-9.26L4 10l6.91-1.74L14 2z" fill="var(--cyan)"/>
