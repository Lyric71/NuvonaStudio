---
import Layout from '../../../layouts/Layout.astro';
import NavBar from '../../../components/NavBar.astro';
import FAQ from '../../../components/FAQ.astro';
import { servicePageSchemas } from '../../../i18n/schemas';

/* ── Datos ────────────────────────────────────────────── */

const overviewCards = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 7V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.6"/><line x1="9" y1="12" x2="15" y2="12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="9" y1="16" x2="13" y2="16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
    title: 'Gestión de la página de empresa',
    text: 'Tu primera carta de presentación digital, construida y mantenida de principio a fin.',
    href: '#svc-company-page',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
    title: 'Producción editorial',
    text: 'Todos los formatos, cada semana, en tus mercados. Contenido que instala tu credibilidad y la mantiene en el tiempo.',
    href: '#svc-content-production',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
    title: 'Newsletter de LinkedIn',
    text: 'Un canal directo con los profesionales que mueven la aguja de tu negocio.',
    href: '#svc-newsletter',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/><line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="1.6"/><rect x="7" y="14" width="3" height="3" rx="0.5" fill="currentColor" opacity="0.7"/></svg>`,
    title: 'Eventos de LinkedIn',
    text: 'El formato más potente de la plataforma en interacciones. Y cada inscrito es un contacto cualificado con nombre y apellidos.',
    href: '#svc-events',
  },
];

const whatWeDo = [
  { title: 'Toda la producción editorial, fuera de tu mesa.', body: 'Estrategia, calendario editorial, producción, publicación e informes mensuales. Tú validas, del resto nos encargamos nosotros. Tu equipo recupera por fin el tiempo para dedicarse a su trabajo real.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/><rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/></svg>` },
  { title: 'Tu voz, no la nuestra.', body: 'Dedicamos tiempo a entender cómo habla tu equipo, qué le interesa a tu mercado y a quién intentas llegar exactamente. Después, redactamos. El resultado tiene que leerse como si lo hubieras escrito tú mismo. Si no, lo rehacemos.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>` },
  { title: 'Contenido en el idioma de tus compradores.', body: 'No traducimos: redactamos de forma nativa, con personas que piensan directamente en la lengua de destino. Si tus prospectos leen en alemán, mandarín o español, escribimos para ellos desde cero.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 9h17M3.5 15h17" stroke="currentColor" stroke-width="1.6"/><ellipse cx="12" cy="12" rx="4" ry="9" stroke="currentColor" stroke-width="1.6"/></svg>` },
  { title: 'La IA acelera el ritmo. La calidad no se negocia.', body: 'En la práctica, la IA nos ayuda con la investigación, la redacción, el multilingüe, los visuales y el montaje. Pero el equipo editorial revisa cada pieza y tú validas todo antes de publicar. Más contenido, más rápido y a menor coste unitario, siempre con un humano teniendo la última palabra.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.09 6.26L20 10l-5.91 1.74L12 18l-2.09-6.26L4 10l5.91-1.74L12 2z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>` },
  { title: 'Informes que habla tu dirección comercial.', body: 'Un informe al mes, atado a tus objetivos de negocio. Qué funcionó, qué no arrancó como esperábamos y qué vamos a cambiar. Nada de cuadros de mando con 45 indicadores que nadie sabe interpretar.', icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 17V13M12 17V9M17 17V7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>` },
];

const whyBlocks = [
  { title: 'Solo hacemos esto.', body: 'Nada de agencia digital que ofrece LinkedIn como uno entre otros quince canales. LinkedIn es lo único que hacemos. Nuestros métodos, los procesos editoriales y los benchmarks de rendimiento están diseñados para esto y para nada más.' },
  { title: 'Multilingüe desde el primer día.', body: 'La mayoría de agencias traducen una pieza en inglés y lo llaman localización. Nosotros redactamos de forma nativa en cada idioma. Tu contenido en alemán se lee como si lo hubiera escrito alguien que piensa directamente en alemán. Y es exactamente lo que ocurre.' },
  { title: 'La IA pone la velocidad. El humano marca el listón.', body: 'Usamos inteligencia artificial en cada etapa: investigación, primeros borradores, visuales, cortes de vídeo. Pero ninguna pieza se publica sin pasar por el equipo editorial. Quien decide si está lista es él, no la máquina.' },
  { title: 'Todo es tuyo.', body: 'Los contenidos, la lista de suscriptores, los datos de los inscritos, las creatividades. Si decides marcharte mañana, todo se va contigo. Nosotros no nos quedamos absolutamente nada.' },
];

const services = [
  {
    id: 'svc-company-page',
    title: 'Gestión de la página de empresa',
    short: 'Tu primera carta de presentación digital, construida y mantenida de principio a fin.',
    details: [
      'Auditoría y rediseño completo (banner, sección Acerca de, contenidos destacados, etiquetas de especialidad)',
      'Gestión mensual de las publicaciones, calibrada al algoritmo de LinkedIn y a tus prioridades comerciales',
      'Todos los formatos cubiertos: texto, carruseles, vídeo, documentos, encuestas',
      'Crecimiento de la base de seguidores a través de la activación de empleados, campañas segmentadas y contenido que circula',
      'Informe mensual: qué ha pasado en la página, por qué y qué vamos a ajustar',
    ],
    trust: 'Ganamos tiempo gracias a la IA, pero quien garantiza el nivel siempre es el equipo.',
    footnote: 'Ninguna pieza se publica sin tu visto bueno. Y todo lo que construimos se queda contigo.',
    stat: null,
    image: '/images/content-company-page.webp',
    imageAlt: 'Panel de gestión de la página de empresa',
  },
  {
    id: 'svc-content-production',
    title: 'Producción editorial',
    short: 'Todos los formatos, cada semana, en cada uno de tus mercados.',
    details: [
      'Cada formato de LinkedIn elegido por una razón concreta, nunca por defecto',
      'Ghostwriting para tus directivos: el conocimiento lo ponen ellos, nosotros le damos voz',
      'Contenidos multilingües redactados de forma nativa, no traducidos',
      'Calendario editorial cerrado con un mes de antelación: redactado, revisado, validado y publicado en plazo',
    ],
    trust: 'Investigación, redacción y multilingüe: ahí la IA nos acelera. El equipo editorial vela por que el resultado se aguante.',
    footnote: 'Validas cada pieza. Si no termina de convencer, la rehacemos.',
    stat: null,
    image: '/images/content-production.webp',
    imageAlt: 'Proceso de producción editorial',
  },
  {
    id: 'svc-newsletter',
    title: 'Newsletter de LinkedIn',
    short: 'Un canal directo con los profesionales que mueven la aguja de tu negocio.',
    details: [
      'Concepto editorial: qué defiende tu newsletter, a quién le habla y por qué la gente se queda suscrita',
      'Producción completa: investigación, redacción, revisión, asunto del envío y llamadas a la acción',
      'Crecimiento de suscriptores: captación orgánica y de pago a través de tu página corporativa, los perfiles de directivos y campañas segmentadas',
      'Seguimiento de rendimiento: tasa de apertura, clics, crecimiento de la base y análisis después de cada edición',
    ],
    trust: 'La investigación de temas y la redacción multilingüe las acelera la IA. La pluma y el control final son siempre humanos.',
    footnote: 'La lista de suscriptores es tuya. Siempre.',
    stat: null,
    image: '/images/content-newsletter.webp',
    imageAlt: 'Maqueta de newsletter de LinkedIn',
  },
  {
    id: 'svc-events',
    title: 'Eventos de LinkedIn',
    short: 'El formato más potente de la plataforma en interacciones. Y cada inscrito, un contacto con nombre y apellidos.',
    details: [
      'Concepto y posicionamiento: un ángulo claro, un público bien acotado y un formato pensado para llenar la sala',
      'Campaña de promoción multicanal lanzada cuatro semanas antes del evento, combinando orgánico y pago',
      'Preparación de ponentes: cada participante recibe un briefing, ensaya y pasa la prueba técnica',
      'Gestión en directo: nosotros conducimos la sesión, tú te concentras en el contenido',
      'Materiales post-evento: grabación, cortes de vídeo, resumen escrito y piezas sociales',
      'Plan de recontacto: datos de los inscritos junto a un plan de acción concreto para tu equipo comercial',
    ],
    trust: 'Procesado de grabaciones, generación de cortes y reaprovechamiento de los momentos clave en todos los formatos de LinkedIn: de eso se encarga la IA.',
    footnote: 'Materiales y datos de los inscritos: todo es tuyo. Y si el concepto no se sostiene, te lo diremos ya en la primera semana.',
    stat: '100 % Propiedad de los datos de los inscritos',
    image: '/images/content-events.webp',
    imageAlt: 'Pieza de promoción de un evento de LinkedIn',
  },
];

const cardIcons = overviewCards.map(c => c.icon);

const stats = [
  { value: '80 %', label: 'de los leads B2B que llegan desde redes sociales nacen en LinkedIn.', context: 'Ninguna otra plataforma se le acerca, ni de lejos.', source: 'LinkedIn Marketing Solutions / Cognism' },
  { value: '7x', label: 'más rápido crece la base de seguidores de las páginas que publican con cadencia semanal.', context: 'La constancia es, de largo, la primera palanca.', source: 'LinkedIn' },
  { value: '5x', label: 'más interacción en los contenidos de vídeo frente a las publicaciones estáticas.', context: 'El formato pesa tanto como el fondo.', source: 'LinkedIn' },
  { value: '59 %', label: 'de los decisores B2B consideran el contenido experto la fuente más fiable para evaluar a un proveedor.', context: 'Por delante de la publicidad, de los whitepapers y de los casos de estudio.', source: 'LinkedIn / Edelman' },
  { value: '4 de cada 5', label: 'usuarios de LinkedIn participan activamente en las decisiones de compra de su empresa.', context: 'Traducido: tu contenido aterriza ante personas con capacidad de firmar.', source: 'LinkedIn' },
  { value: '2x', label: 'más conversiones en LinkedIn que en el resto de redes sociales.', context: 'El público ya está conectado en modo profesional.', source: 'LinkedIn Marketing Solutions' },
  { value: '277 %', label: 'más eficaz que Facebook y X sumados a la hora de generar leads cualificados.', context: 'Simplemente no juegan en la misma liga.', source: 'HubSpot' },
  { value: '46 %', label: 'del tráfico social hacia los sitios B2B procede de LinkedIn.', context: 'El contenido no solo construye marca: trae visitantes con intención.', source: 'LinkedIn' },
  { value: '28 %', label: 'menos coste por lead en LinkedIn frente a Google Ads.', context: 'Y el contenido orgánico todavía abarata más la cuenta.', source: 'HubSpot' },
  { value: '61 %', label: 'más probabilidades de convertir vía publicidad después de una interacción orgánica.', context: 'Contenido más publicidad, juntos, rinden más que cualquiera por su cuenta.', source: 'Investigación interna de LinkedIn' },
];

const faqs = [
  { q: 'En la práctica, ¿cómo es el primer mes?', a: 'Arrancamos con una auditoría de tu presencia en LinkedIn: página corporativa, perfiles directivos, histórico de publicaciones y base de suscriptores. A partir de ahí cerramos la estrategia editorial, te pasamos el primer mes de contenido para tu validación y nos ponemos en marcha. La mayoría de clientes está operativa en dos o tres semanas.' },
  { q: '¿Cuánto dura el compromiso mínimo?', a: 'Tres meses al inicio y, a partir de ahí, mes a mes. Ese primer trimestre es el tiempo necesario para sentar las bases y empezar a medir cosas reales. Después te quedas porque funciona, no porque haya un contrato atándote.' },
  { q: '¿Cómo interviene la IA en la producción de contenido?', a: 'En todas las etapas: investigación, redacción, multilingüe, creación de imágenes, montaje de vídeo. Eso nos permite producir más volumen, más rápido y a menor coste. Pero el equipo editorial revisa cada texto y los diseñadores comprueban cada visual. Ninguna pieza se publica sin validación humana y sin tu visto bueno. En ese punto no negociamos.' },
  { q: '¿Y si una pieza no me convence?', a: 'La rehacemos. Sin discutir y sin facturar de más. Preferimos reescribir un post tres veces antes que publicar algo que no encaja.' },
  { q: '¿Puedo empezar por un solo servicio?', a: 'Por supuesto. Arranca por lo que te queme más y el resto lo añadimos cuando convenga.' },
  { q: '¿Cuánto tiempo le quita esto a mi equipo?', a: 'Bastante poco, la verdad. Planificamos el contenido con un mes de antelación, tu equipo revisa y valida. Solemos quedarnos en veinte o treinta minutos a la semana. Hay clientes que lo despachan el lunes por la mañana con el café.' },
  { q: '¿Se puede trabajar con nuestra identidad gráfica?', a: 'Sin problema. Identidad visual, tono, terminología, flujos de validación: nos adaptamos a tu marco. Si tienes plantillas obligatorias o restricciones regulatorias, también las respetamos al pie de la letra.' },
  { q: '¿Cómo son los informes mensuales?', a: 'Un informe al mes, atado a tus objetivos comerciales: crecimiento de seguidores, interacciones, rendimiento por contenido e indicadores de generación de leads. Te contamos qué funcionó, qué no arrancó como esperábamos y qué vamos a ajustar el mes siguiente. Sin relleno.' },
  { q: '¿Cuánto tardo en ver resultados?', a: 'Las visitas al perfil, el crecimiento de seguidores y las interacciones suelen moverse en los primeros 60 días. Para los leads comerciales, más bien 90 días. Es el tiempo que tarda el contenido en acumularse y la audiencia lectora en consolidarse. No prometemos resultados de la noche a la mañana porque sería deshonesto: LinkedIn premia a quien aguanta la distancia.' },
  { q: '¿Y si quiero parar?', a: 'Pasados los tres primeros meses, basta con un preaviso de 30 días. Contenidos, suscriptores y materiales se van contigo, sin excepción.' },
];
---

<Layout
  lang="es"
  title="Servicios de contenido en LinkedIn | Más leads B2B cualificados"
  description="Producimos todo el contenido de LinkedIn que tu marca necesita. Estrategia, producción, publicación e informes. Pensado para B2B y para que llegue gente con intención real de comprar."
  abstract="Llevamos tu contenido de LinkedIn de principio a fin: estrategia, producción, publicación e informes. Cuatro servicios y un único objetivo: más leads cualificados desde la plataforma."
  schemas={servicePageSchemas('es', 'content')}
>
  <NavBar lang="es" />
  <main id="main-content">

    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="c-hero" aria-labelledby="hero-h">
      <div class="c-hero__bg" aria-hidden="true"></div>
      <div class="c-hero__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="c-hero__content">
          <p class="eyebrow eyebrow--light reveal">Servicios de contenido en LinkedIn</p>
          <h1 id="hero-h" class="c-hero__h1 reveal reveal-delay-1">
            Contenido en LinkedIn que capta atención y termina en <span class="text-gradient">leads cualificados.</span>
          </h1>
          <p class="c-hero__sub reveal reveal-delay-2">
            Producimos todo el contenido que tu presencia en LinkedIn necesita. Estrategia, producción, publicación e informes. A ti, ni una sola gestión te toca.
          </p>
          <div class="c-hero__actions reveal reveal-delay-3">
            <a href="/es/contacto" class="btn btn--primary btn--lg">Reservar una llamada</a>
          </div>
        </div>
      </div>
    </section>


    <!-- ── Service Overview Cards ──────────────────────────── -->
    <section class="section c-overview" aria-label="Resumen de servicios">
      <div class="container">
        <div class="c-ov__grid">
          {overviewCards.map((card, i) => (
            <a href={card.href} class={`c-ov-card reveal${i > 0 ? ` reveal-delay-${Math.min(i, 3)}` : ''}`}>
              <div class="c-ov-card__top">
                <span class="c-ov-card__icon" set:html={card.icon} />
              </div>
              <strong class="c-ov-card__title">{card.title}</strong>
              <p class="c-ov-card__text">{card.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>


    <!-- ── What We Do ──────────────────────────────────────── -->
    <section class="section c-wwd" aria-labelledby="wwd-h">
      <div class="container">
        <div class="c-wwd__head reveal">
          <p class="eyebrow">Nuestro enfoque</p>
          <h2 id="wwd-h" class="c-wwd__h2">Convertimos tu presencia en LinkedIn en una palanca comercial real.</h2>
          <p class="c-wwd__intro">Tu equipo tiene el expertise. Tu empresa tiene una historia que merece contarse. Pero mientras ese saber hacer se quede entre las cuatro paredes de la oficina, no llenará jamás el libro de pedidos.</p>
          <p class="c-wwd__intro">Cogemos aquello que da credibilidad a tu marca y lo convertimos en una mecánica editorial que rueda en LinkedIn semana tras semana. Publicaciones, artículos, newsletters, eventos: todo calibrado para llegar a quien compra lo que tú vendes.</p>
        </div>

        <div class="c-wwd__grid">
          {whatWeDo.map((item, i) => (
            <div class={`c-wwd-card reveal${i > 0 ? ` reveal-delay-${Math.min(i, 3)}` : ''}`}>
              <div class="c-wwd-card__top">
                <span class="c-wwd-card__icon" aria-hidden="true" set:html={item.icon} />
              </div>
              <strong class="c-wwd-card__title">{item.title}</strong>
              <p class="c-wwd-card__body">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- ── Why Brands Work With Us ─────────────────────────── -->
    <section class="section c-why" aria-labelledby="why-h">
      <div class="c-why__bg" aria-hidden="true"></div>
      <div class="container">
        <div class="c-why__head reveal">
          <p class="eyebrow eyebrow--light">Por qué nosotros</p>
          <h2 id="why-h" class="c-why__h2">Diseñado para B2B. Tallado a medida para lo internacional.</h2>
        </div>

        <div class="c-why__layout">
          <!-- Left: visual column -->
          <div class="c-why__visual reveal">
            <div class="c-why__photo-wrap">
              <img src="/images/content-team.webp" alt="El equipo de Nuvora Studio" class="c-why__photo" width="480" height="560" loading="lazy" />
            </div>
            <div class="c-why__trust-row">
              <div class="c-why__trust-item">
                <span class="c-why__trust-num">100 %</span>
                <span class="c-why__trust-label">Dedicado a LinkedIn</span>
              </div>
              <div class="c-why__trust-divider"></div>
              <div class="c-why__trust-item">
                <span class="c-why__trust-num">B2B</span>
                <span class="c-why__trust-label">En exclusiva</span>
              </div>
              <div class="c-why__trust-divider"></div>
              <div class="c-why__trust-item">
                <span class="c-why__trust-num">Global</span>
                <span class="c-why__trust-label">Multilingüe</span>
              </div>
            </div>
          </div>

          <!-- Right: differentiator cards -->
          <div class="c-why__cards">
            {whyBlocks.map((b, i) => (
              <div class={`c-why-card reveal${i > 0 ? ` reveal-delay-${Math.min(i, 3)}` : ''}`}>
                <div class="c-why-card__content">
                  <strong class="c-why-card__title">{b.title}</strong>
                  <p class="c-why-card__body">{b.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>


    <!-- ── Our LinkedIn Content Services ───────────────────── -->
    <section class="section c-svc" aria-labelledby="svc-h">
      <div class="container">
        <div class="c-svc__head reveal">
          <p class="eyebrow">Nuestros servicios</p>
          <h2 id="svc-h" class="c-svc__h2">Cuatro servicios. Un objetivo. Más leads cualificados desde LinkedIn.</h2>
          <p class="c-svc__intro">Cada servicio funciona por separado, pero juntos transforman tu presencia en LinkedIn en un sistema de captación con el que tu equipo comercial puede contar a diario.</p>
        </div>

        {services.map((s, i) => (
          <div class={`c-svc-block${i % 2 === 1 ? ' c-svc-block--flip' : ''} reveal`} id={s.id}>
            <div class="c-svc-block__text">
              <div class="c-svc-block__label">
                <span class="c-svc-block__icon" set:html={cardIcons[i]} />
              </div>
              <h3 class="c-svc-block__title">{s.title}</h3>
              <p class="c-svc-block__short">{s.short}</p>

              <ul class="c-svc-block__details" role="list">
                {s.details.map(d => (
                  <li>
                    <svg class="c-svc-check" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="8" fill="var(--blue)" opacity="0.10"/><path d="M5 8l2.2 2.2L11.4 6" stroke="var(--blue)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>

              <div class="c-svc-block__trust">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1l1.76 3.58L13 5.24l-3 2.88.72 4.12L7 10.36 3.28 12.24 4 8.12 1 5.24l4.24-.66L7 1z" fill="var(--cyan)" opacity="0.85"/></svg>
                <p>{s.trust}</p>
