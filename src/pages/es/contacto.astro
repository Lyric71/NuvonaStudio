---
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';

/* ── Servicios (alineados con el menú «Servicios» del NavBar) ── */
const services = [
  {
    value: 'content',
    label: 'Contenido',
    sub: 'Página de empresa, publicaciones, newsletters, eventos',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>`,
  },
  {
    value: 'advertising',
    label: 'Publicidad',
    sub: 'Posts patrocinados, InMail y formularios de leads',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
  },
  {
    value: 'consulting',
    label: 'Consultoría',
    sub: 'Formación, programas de embajadores y marca personal',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2V3z" stroke="currentColor" stroke-width="1.6"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7V3z" stroke="currentColor" stroke-width="1.6"/></svg>`,
  },
];

/* ── Paquetes (espejo de la página de precios) ── */
const packagesByService: Record<string, { value: string; label: string; price: string }[]> = {
  content: [
    { value: 'retainer-foundation', label: 'Plan Foundation',                    price: '1.500 €/mes' },
    { value: 'retainer-growth',     label: 'Plan Growth',                        price: '3.000 €/mes' },
    { value: 'retainer-scale',      label: 'Plan Scale',                         price: '5.250 €/mes' },
    { value: 'exec-ghostwriting',   label: 'Ghostwriting para directivos',       price: '1.050 €/mes por directivo' },
    { value: 'video-ai',            label: 'Vídeo generado por IA',              price: '180–4.500 € por vídeo' },
    { value: 'video-pro',           label: 'Rodaje de vídeo profesional',        price: 'Presupuesto a medida' },
    { value: 'multilingual',        label: 'Contenido multilingüe',              price: 'Presupuesto por idioma' },
    { value: 'enterprise',          label: 'Enterprise (multimercado)',          price: 'Desde 9.000 €/mes' },
    { value: 'not-sure',            label: 'Aún sin decidir, ya lo veremos', price: '' },
  ],
  advertising: [
    { value: 'ads-under-15k',       label: 'Gestión de anuncios (menos de 13.000 €/mes de inversión)', price: '1.300 €/mes' },
    { value: 'ads-over-15k',        label: 'Gestión de anuncios (más de 13.000 €/mes de inversión)',   price: '6%–10% del gasto' },
    { value: 'retainer-growth',     label: 'Plan Growth (incluye anuncios)',     price: '3.000 €/mes' },
    { value: 'retainer-scale',      label: 'Plan Scale (incluye anuncios)',      price: '5.250 €/mes' },
    { value: 'enterprise',          label: 'Enterprise (multimercado)',          price: 'Desde 9.000 €/mes' },
    { value: 'not-sure',            label: 'Aún sin decidir, ya lo veremos', price: '' },
  ],
  consulting: [
    { value: 'exec-profile',        label: 'Optimización del perfil de directivos',      price: '450 € por perfil (pago único)' },
    { value: 'training-workshop',   label: 'Taller de formación (2 horas)',              price: '2.200 € por sesión' },
    { value: 'training-program',    label: 'Programa de formación para equipos (4 sesiones)', price: '7.000 € (pago único)' },
    { value: 'advocacy',            label: 'Programa de empleados embajadores',          price: '2.200 €/mes' },
    { value: 'enterprise',          label: 'Enterprise (multimercado)',                  price: 'Desde 9.000 €/mes' },
    { value: 'not-sure',            label: 'Aún sin decidir, ya lo veremos',    price: '' },
  ],
};

/* ── Preselección desde los parámetros de URL (CTAs de la página de precios) ── */
const url = new URL(Astro.request.url);
const intentParam = url.searchParams.get('intent');
const tierParam   = url.searchParams.get('tier');

let preselectedService = '';
let preselectedPackage = '';
if (intentParam === 'retainer' && tierParam) {
  preselectedService = 'content';
  preselectedPackage = `retainer-${tierParam}`;
} else if (intentParam === 'enterprise') {
  preselectedService = 'content';
  preselectedPackage = 'enterprise';
}
---

<Layout
  preloadHero="/images/contact-hero-people.webp"
  lang="es"
  title="Contactar con Nuvora Studio | Hablemos de LinkedIn"
  description="Cuéntanos en qué estás trabajando. Cada mensaje lo lee una persona del equipo y tiene respuesta dentro del siguiente día hábil. Sin respuestas automáticas, sin discursos de venta."
  abstract="Cuéntanos en qué estás trabajando. Cada mensaje llega a una persona del equipo y tiene respuesta dentro del siguiente día hábil."
>
  <NavBar lang="es" />
  <main id="main-content">

    <section class="contact-hero" aria-labelledby="contact-heading">
      <div class="contact-hero__bg" aria-hidden="true"></div>
      <div class="contact-hero__overlay" aria-hidden="true"></div>
      <div class="container" style="position: relative; z-index: 2;">
        <div class="contact-hero__content">
          <p class="eyebrow eyebrow--light reveal">Pongámonos en contacto</p>
          <h1 id="contact-heading" class="contact-hero__h1 reveal reveal-delay-1">
            Hablemos de <span class="text-gradient">LinkedIn.</span>
          </h1>
          <p class="contact-hero__sub reveal reveal-delay-2">
            Tengas el proyecto cerrado o todavía a medio cocinar, escríbenos. Una persona del equipo lee cada mensaje y te responde dentro del siguiente día hábil.
          </p>
          <div class="contact-hero__actions reveal reveal-delay-3">
            <a href="#contact-form" class="btn btn--primary btn--lg">Iniciar la conversación</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section contact-section" style="background: var(--off-white);">
      <div class="container">
        <div class="contact-layout">

          <div class="contact-form-col">

            <div class="contact-success" id="contact-success" aria-live="polite">
              <div class="contact-success__icon">
                <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                  <path d="M5 14l6.5 6.5L23 8" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <h2 class="contact-success__title">Recibido. Tu mensaje ya va de camino.</h2>
              <p class="contact-success__body">
                Alguien del equipo lo leerá con calma y te escribirá dentro del siguiente día hábil.
              </p>
              <a href="/es" class="btn btn--primary" style="margin-top: var(--sp-6)">Volver al inicio</a>
            </div>

            <div class="contact-card" id="contact-card">
              <div class="contact-card__header">
                <div class="contact-card__header-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M2 5a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V5z" stroke="var(--blue)" stroke-width="1.5"/>
                    <path d="M2 7l8 5 8-5" stroke="var(--blue)" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div>
                  <h2 class="contact-card__title">Unos datos para llegar preparados</h2>
                  <p class="contact-card__note">
                    Los campos con asterisco <span aria-hidden="true">*</span> son imprescindibles. El resto, como prefieras.
                  </p>
                </div>
              </div>

              <form id="contact-form" class="contact-form" novalidate aria-label="Formulario de contacto">
                <input type="text" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-10000px;width:1px;height:1px;opacity:0;pointer-events:none;" />
                <input type="hidden" name="form_ts" id="form-ts" value="" />
                <div class="contact-form__grid">

                  <div class="form-group">
                    <label class="form-label" for="name">
                      Tu nombre <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input class="form-input" type="text" id="name" name="name"
                      autocomplete="name" required placeholder="María Fernández" />
                    <span class="form-error" id="name-error" role="alert"></span>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="email">
                      Tu correo electrónico <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input class="form-input" type="email" id="email" name="email"
                      autocomplete="email" required placeholder="maria@heliobio.es" />
                    <span class="form-error" id="email-error" role="alert"></span>
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="phone">
                      Tu teléfono <span class="form-optional">(opcional)</span>
                    </label>
                    <input class="form-input" type="tel" id="phone" name="phone"
                      autocomplete="tel" placeholder="+34 91 423 80 00" />
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="website">
                      Web de tu empresa <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input class="form-input" type="url" id="website" name="website"
                      autocomplete="url" required placeholder="https://heliobio.es" />
                    <span class="form-error" id="website-error" role="alert"></span>
                  </div>

                  <div class="form-group contact-form__full">
                    <label class="form-label" for="company">
                      Nombre de tu empresa <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <input class="form-input" type="text" id="company" name="company"
                      autocomplete="organization" required placeholder="Helio Biosciences" />
                    <span class="form-error" id="company-error" role="alert"></span>
                  </div>

                  <!-- Servicios (multiselección) -->
                  <div class="form-group contact-form__full">
                    <label class="form-label">
                      ¿Qué servicios te interesan? <span class="required-mark" aria-hidden="true">*</span>
                      <span class="form-optional">Marca los que cuadren.</span>
                    </label>
                    <div class="form-chips" role="group" aria-label="Servicios" id="service-group">
                      {services.map((s) => (
                        <label class="form-chip">
                          <input
                            type="checkbox"
                            name="service"
                            value={s.value}
                            class="form-chip__input"
                            data-service={s.value}
                            checked={preselectedService === s.value}
                          />
                          <span class="form-chip__inner">
                            <span class="form-chip__icon" set:html={s.icon} />
                            <span class="form-chip__text">
                              <strong class="form-chip__label">{s.label}</strong>
                              <span class="form-chip__sub">{s.sub}</span>
                            </span>
                          </span>
                        </label>
                      ))}
                    </div>
                    <span class="form-error" id="service-error" role="alert"></span>
                  </div>

                  <!-- Paquetes (multiselección) -->
                  <div class="form-group contact-form__full">
                    <label class="form-label" id="package-label">
                      ¿Algún paquete encaja ya? <span class="form-optional">(opcional)</span>
                    </label>
                    <div class="form-checklist" role="group" aria-labelledby="package-label" id="package-list">
                      <p class="form-checklist__empty">Marca antes un servicio y aparecerán los paquetes asociados.</p>
                    </div>
                    <p class="form-hint" id="package-hint">Mismos precios que la <a href="/es/precios">página de precios</a>. ¿Dudas? Déjalo en blanco y lo vemos en la llamada.</p>
                  </div>

                  <!-- Plazo -->
                  <div class="form-group contact-form__full">
                    <label class="form-label">
                      ¿Cuándo te gustaría arrancar? <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <div class="form-chips form-chips--compact" role="radiogroup" aria-label="Plazo" id="timeline-group">
                      <label class="form-chip form-chip--compact">
                        <input type="radio" name="timeline" value="now" class="form-chip__input" required />
                        <span class="form-chip__inner">
                          <strong class="form-chip__label">Cuanto antes</strong>
                          <span class="form-chip__sub">En unas pocas semanas</span>
                        </span>
                      </label>
                      <label class="form-chip form-chip--compact">
                        <input type="radio" name="timeline" value="3-months" class="form-chip__input" />
                        <span class="form-chip__inner">
                          <strong class="form-chip__label">En unos tres meses</strong>
                          <span class="form-chip__sub">Vamos preparando terreno</span>
                        </span>
                      </label>
                      <label class="form-chip form-chip--compact">
                        <input type="radio" name="timeline" value="6-months" class="form-chip__input" />
                        <span class="form-chip__inner">
                          <strong class="form-chip__label">Hacia los seis meses</strong>
                          <span class="form-chip__sub">Para más adelante</span>
                        </span>
                      </label>
                    </div>
                    <span class="form-error" id="timeline-error" role="alert"></span>
                  </div>

                  <!-- Proyecto -->
                  <div class="form-group contact-form__full">
                    <label class="form-label" for="project">
                      Cuéntanos tu proyecto, a tu manera <span class="required-mark" aria-hidden="true">*</span>
                    </label>
                    <textarea class="form-textarea" id="project" name="project"
                      required rows="5"
                      placeholder="Con unas frases basta. Ejemplo: somos una biotech de 120 personas en plena expansión europea y queremos que nuestros directivos ganen visibilidad en LinkedIn este año…"
                    ></textarea>
                    <span class="form-error" id="project-error" role="alert"></span>
                  </div>
                </div>

                <!-- Datos de catálogo para el script del cliente -->
                <script type="application/json" id="package-data" is:inline set:html={JSON.stringify(packagesByService)}></script>
                <script type="application/json" id="preselect-data" is:inline set:html={JSON.stringify({ service: preselectedService, package: preselectedPackage })}></script>

                <div class="form-banner" id="form-error-banner" role="alert">
                  <span id="form-error-message"></span>
                </div>

                <div class="contact-form__actions">
                  <button type="submit" class="btn btn--primary btn--lg" id="submit-btn">
                    <span id="submit-label">Enviar mi mensaje</span>
                    <span id="submit-spinner" class="submit-spinner" style="display:none" aria-hidden="true"></span>
                  </button>
                  <p class="contact-form__privacy">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 1L2 3v3c0 2.5 1.7 4.7 4 5.4C8.3 10.7 10 8.5 10 6V3L6 1z" stroke="var(--text-3)" stroke-width="1.2" fill="none"/></svg>
                    Tus datos se quedan con nosotros. Nunca se ceden, nunca se venden.
                  </p>
                </div>
              </form>
            </div>

          </div>

          <aside class="contact-sidebar" aria-label="Información de contacto">

            <div class="sidebar-card sidebar-card--steps reveal">
              <h3 class="sidebar-card__title">Qué pasa después</h3>
              <ol class="steps-list">
                <li class="step-item">
                  <div class="step-item__number" aria-hidden="true">1</div>
                  <div class="step-item__content">
                    <strong>Una persona del equipo lee tu mensaje</strong>
                    <p>Normalmente en pocas horas, siempre dentro del siguiente día hábil. Nada de respuestas automáticas, nada de colas.</p>
                  </div>
                </li>
                <li class="step-item">
                  <div class="step-item__number" aria-hidden="true">2</div>
                  <div class="step-item__content">
                    <strong>Una llamada de media hora, sin diapositivas</strong>
                    <p>Si hay buen encaje por ambas partes, reservamos un rato para hablar de tus objetivos. Conversación franca, no presentación de ventas.</p>
                  </div>
                </li>
                <li class="step-item">
                  <div class="step-item__number" aria-hidden="true">3</div>
                  <div class="step-item__content">
                    <strong>Una propuesta hecha a tu medida</strong>
                    <p>A los pocos días recibirás una propuesta por escrito construida sobre tu audiencia y tus objetivos. No una plantilla con tu logo pegado encima.</p>
                  </div>
                </li>
              </ol>
            </div>

            <div class="sidebar-card sidebar-card--trust reveal reveal-delay-1">
              <h3 class="sidebar-card__title">Por qué Nuvora</h3>
              <ul class="trust-list">
                <li class="trust-item">
                  <div class="trust-item__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 1.5l1.8 3.6 4 .58-2.9 2.83.69 3.99L8 10.27l-3.59 1.88.69-3.99-2.9-2.83 4-.58L8 1.5z" fill="var(--cyan)" opacity="0.9"/>
                    </svg>
                  </div>
                  <span>La IA trabaja en segundo plano. La voz de tu marca la cuidan personas.</span>
                </li>
                <li class="trust-item">
                  <div class="trust-item__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <rect x="2" y="4" width="12" height="9" rx="1.5" stroke="var(--cyan)" stroke-width="1.4"/>
                      <path d="M5 4V3a3 3 0 016 0v1" stroke="var(--cyan)" stroke-width="1.4"/>
                    </svg>
                  </div>
                  <span>Nada se publica sin tu visto bueno</span>
                </li>
                <li class="trust-item">
                  <div class="trust-item__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M8 2C5.24 2 3 4.24 3 7c0 2.76 2.24 5 5 5s5-2.24 5-5-2.24-5-5-5z" stroke="var(--cyan)" stroke-width="1.4"/>
                      <path d="M8 5v3l2 1" stroke="var(--cyan)" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </div>
                  <span>Clientes B2B en cualquier franja horaria</span>
                </li>
                <li class="trust-item">
                  <div class="trust-item__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M13 5L6 12 3 9" stroke="var(--cyan)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                  <span>Todo el contenido que producimos es tuyo</span>
                </li>
              </ul>
            </div>

            <div class="sidebar-card sidebar-card--pricing reveal reveal-delay-2">
              <div class="pricing-anchor__top">
                <span class="pricing-anchor__label">Colaboración desde</span>
                <span class="pricing-anchor__value">1.500 €<span>/mes</span></span>
              </div>
              <p class="pricing-anchor__note">Planes mensuales. Sin permanencia pasados los tres primeros meses.</p>
              <a href="/es/precios" class="pricing-anchor__link">
                Ver la lista completa de precios
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>

          </aside>

        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .contact-hero { position: relative; overflow: hidden; padding-block: var(--sp-32) var(--sp-24); min-height: 520px; display: flex; align-items: center; }
  .contact-hero__bg { position: absolute; inset: 0; background: url('/images/contact-hero-people.webp') center center / cover no-repeat; z-index: 0; }
  .contact-hero__overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(15,23,42, 0.92) 0%, rgba(15,23,42, 0.75) 50%, rgba(15,23,42, 0.45) 100%); z-index: 1; }
  .contact-hero__content { max-width: 680px; }
  .contact-hero__h1 { font-family: var(--font-display); font-size: clamp(2.25rem, 4.5vw, 3.75rem); font-weight: 700; color: var(--white); line-height: 1.10; letter-spacing: -0.02em; margin-block: var(--sp-5) var(--sp-6); }
  .contact-hero__h1 .text-gradient { background: linear-gradient(135deg, var(--cyan) 0%, var(--sky) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .contact-hero__sub { font-size: var(--fs-md); color: rgba(255, 255, 255, 0.68); max-width: 520px; line-height: 1.75; margin-bottom: var(--sp-10); }
  .contact-hero__actions { display: flex; flex-wrap: wrap; gap: var(--sp-4); }
  @media (max-width: 640px) { .contact-hero { padding-block: var(--sp-16) var(--sp-12); } }

  .contact-section { padding-block: var(--sp-16) var(--sp-24); }
  .contact-layout { display: grid; grid-template-columns: 1fr 380px; gap: var(--sp-10); align-items: start; }

  .contact-success { display: none; flex-direction: column; align-items: center; text-align: center; padding: var(--sp-20) var(--sp-10); background: var(--white); border-radius: var(--r-2xl); border: 1px solid var(--border); box-shadow: var(--shadow-md); }
  .contact-success.is-visible { display: flex; }
  .contact-success__icon { width: 64px; height: 64px; border-radius: 50%; background: var(--sky); display: flex; align-items: center; justify-content: center; margin-bottom: var(--sp-6); box-shadow: 0 0 0 10px rgba(14,165,233,0.10); }
  .contact-success__title { font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2rem); color: var(--deep-navy); margin-bottom: var(--sp-3); letter-spacing: -0.02em; }
  .contact-success__body { font-family: var(--font-body); font-size: var(--fs-md); color: var(--text-2); max-width: 360px; line-height: 1.75; }

  .contact-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--r-2xl); overflow: hidden; box-shadow: var(--shadow-sm); }
  .contact-card__header { padding: var(--sp-8) var(--sp-10) var(--sp-6); border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: var(--sp-4); }
  .contact-card__header-icon { width: 40px; height: 40px; flex-shrink: 0; background: rgba(14,165,233,0.07); border-radius: var(--r-lg); display: flex; align-items: center; justify-content: center; }
  .contact-card__title { font-family: var(--font-display); font-size: clamp(1.1rem, 2vw, 1.35rem); font-weight: 600; color: var(--deep-navy); letter-spacing: -0.01em; margin-bottom: 2px; }
  .contact-card__note { font-family: var(--font-body); font-size: var(--fs-xs); color: var(--text-3); }

  .contact-form { padding: var(--sp-8) var(--sp-10); display: flex; flex-direction: column; gap: var(--sp-6); }
  .contact-form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-5); }
  .contact-form__full { grid-column: 1 / -1; }
  .required-mark { color: var(--sky); margin-left: 2px; }
  .form-optional { color: var(--text-3); font-weight: 400; font-size: var(--fs-xs); }

  .form-error { font-size: var(--fs-xs); color: #c0392b; min-height: 16px; display: block; }
  .form-input.is-invalid, .form-textarea.is-invalid { border-color: #c0392b; box-shadow: 0 0 0 3px rgba(192,57,43,0.08); }
  .form-banner { display: none; padding: var(--sp-4); background: #FEF2F2; border: 1px solid rgba(192,57,43,0.15); border-radius: var(--r-md); font-size: var(--fs-sm); color: #c0392b; }
  .form-banner.is-visible { display: block; }

  /* ── Chips & checklist (Servicios / Paquetes / Plazo) ── */
  .form-chips { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); margin-top: var(--sp-1); }
  .form-chip { position: relative; cursor: pointer; display: block; }
  .form-chip__input { position: absolute; opacity: 0; pointer-events: none; inset: 0; }
  .form-chip__inner { position: relative; display: flex; align-items: center; gap: var(--sp-3); padding: var(--sp-4); background: var(--white); border: 1.5px solid var(--border); border-radius: var(--r-lg); transition: border-color var(--t-fast), background var(--t-fast), box-shadow var(--t-fast), transform var(--t-fast); height: 100%; }
  #service-group .form-chip__inner::after { content: ''; position: absolute; top: 8px; right: 8px; width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--border); background: var(--white); transition: background var(--t-fast), border-color var(--t-fast); }
  #service-group .form-chip__input:checked + .form-chip__inner::after { background: var(--sky) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M3 6.5l2 2 4-5' stroke='white' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>") center / 11px no-repeat; border-color: var(--sky); }
  .form-chip:hover .form-chip__inner { border-color: var(--border-2); background: var(--off-white); }
  .form-chip__input:focus-visible + .form-chip__inner { border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,0.18); }
  .form-chip__input:checked + .form-chip__inner { border-color: var(--sky); background: rgba(14,165,233,0.04); box-shadow: 0 0 0 1px var(--sky) inset; }
  .form-chip__icon { flex-shrink: 0; width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center; border-radius: var(--r-md); background: rgba(14,165,233,0.08); color: var(--sky); transition: background var(--t-fast), color var(--t-fast); }
  .form-chip__input:checked + .form-chip__inner .form-chip__icon { background: var(--sky); color: var(--white); }
  .form-chip__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .form-chip__label { font-family: var(--font-body); font-size: var(--fs-sm); font-weight: 600; color: var(--text); line-height: 1.2; }
  .form-chip__sub { font-family: var(--font-body); font-size: var(--fs-xs); color: var(--text-3); line-height: 1.35; }
  .form-chips--compact .form-chip__inner { flex-direction: column; align-items: flex-start; gap: 2px; padding: var(--sp-3) var(--sp-4); }
  .form-checklist { display: flex; flex-direction: column; gap: var(--sp-2); margin-top: var(--sp-1); padding: var(--sp-2); background: var(--off-white); border: 1px solid var(--border); border-radius: var(--r-lg); }
  .form-checklist__empty { font-family: var(--font-body); font-size: var(--fs-sm); color: var(--text-3); padding: var(--sp-4); text-align: center; }
  .form-check { position: relative; display: block; cursor: pointer; }
  .form-check__input { position: absolute; opacity: 0; pointer-events: none; inset: 0; }
  .form-check__inner { display: flex; align-items: center; gap: var(--sp-3); padding: var(--sp-3) var(--sp-4); background: var(--white); border: 1.5px solid transparent; border-radius: var(--r-md); transition: border-color var(--t-fast), background var(--t-fast); }
  .form-check:hover .form-check__inner { border-color: var(--border-2); }
  .form-check__input:focus-visible + .form-check__inner { border-color: var(--sky); box-shadow: 0 0 0 3px rgba(14,165,233,0.18); }
  .form-check__input:checked + .form-check__inner { border-color: var(--sky); background: rgba(14,165,233,0.04); }
  .form-check__box { flex-shrink: 0; width: 18px; height: 18px; border-radius: 5px; border: 1.5px solid var(--border-2); background: var(--white); display: inline-flex; align-items: center; justify-content: center; transition: background var(--t-fast), border-color var(--t-fast); }
  .form-check__input:checked + .form-check__inner .form-check__box { background: var(--sky) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none'><path d='M3 6.5l2 2 4-5' stroke='white' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>") center / 12px no-repeat; border-color: var(--sky); }
  .form-check__label { flex: 1; font-family: var(--font-body); font-size: var(--fs-sm); color: var(--text); line-height: 1.45; }
  .form-check__price { flex-shrink: 0; font-family: var(--font-body); font-size: var(--fs-sm); font-weight: 600; color: var(--sky); white-space: nowrap; }
  .form-hint a { color: var(--sky); text-decoration: underline; text-underline-offset: 2px; }
  .form-hint a:hover { color: var(--blue); }

  .contact-form__actions { display: flex; align-items: center; gap: var(--sp-6); flex-wrap: wrap; }
  .contact-form__privacy { display: flex; align-items: center; gap: var(--sp-2); font-family: var(--font-body); font-size: var(--fs-xs); color: var(--text-3); }
  .submit-spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.30); border-top-color: #fff; border-radius: 50%; animation: spin 0.6s linear infinite; margin-left: var(--sp-2); }
  @keyframes spin { to { transform: rotate(360deg); } }

  .contact-sidebar { display: flex; flex-direction: column; gap: var(--sp-4); position: sticky; top: 96px; }
  .sidebar-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--r-2xl); padding: var(--sp-5) var(--sp-6); box-shadow: var(--shadow-sm); transition: box-shadow var(--t-base); }
  .sidebar-card:hover { box-shadow: var(--shadow-md); }
  .sidebar-card__title { font-family: var(--font-display); font-size: var(--fs-sm); font-weight: 600; color: var(--deep-navy); letter-spacing: 0.02em; text-transform: uppercase; margin-bottom: var(--sp-3); opacity: 0.55; }
  .steps-list { display: flex; flex-direction: column; gap: 0; }
  .step-item { display: flex; gap: var(--sp-3); position: relative; }
  .step-item:not(:last-child)::after { content: ''; position: absolute; left: 14px; top: 30px; bottom: -4px; width: 1px; background: var(--border); }
  .step-item + .step-item { margin-top: var(--sp-2); }
  .step-item__number { flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%; background: var(--deep-navy); color: var(--white); font-family: var(--font-display); font-size: var(--fs-xs); font-weight: 700; display: flex; align-items: center; justify-content: center; letter-spacing: 0; position: relative; z-index: 1; }
  .step-item__content { padding-top: 3px; padding-bottom: var(--sp-2); }
  .step-item__content strong { display: block; font-family: var(--font-body); font-size: var(--fs-sm); font-weight: 600; color: var(--deep-navy); margin-bottom: var(--sp-1); }
  .step-item__content p { font-family: var(--font-body); font-size: var(--fs-xs); color: var(--text-2); line-height: 1.7; }
  .trust-list { display: flex; flex-direction: column; gap: var(--sp-2); }
  .trust-item { display: flex; align-items: flex-start; gap: var(--sp-3); font-family: var(--font-body); font-size: var(--fs-sm); color: var(--text-2); line-height: 1.5; }
  .trust-item__icon { flex-shrink: 0; width: 26px; height: 26px; background: rgba(6,182,212,0.08); border-radius: var(--r-md); display: flex; align-items: center; justify-content: center; margin-top: 1px; }
  .sidebar-card--pricing { background: var(--deep-navy); border-color: rgba(255,255,255,0.08); }
  .sidebar-card--pricing:hover { box-shadow: var(--shadow-lg); }
  .pricing-anchor__top { display: flex; flex-direction: column; gap: var(--sp-1); margin-bottom: var(--sp-2); }
  .pricing-anchor__label { font-size: var(--fs-xs); color: var(--cyan); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .pricing-anchor__value { font-family: var(--font-display); font-size: var(--fs-3xl); font-weight: 700; color: var(--white); letter-spacing: -0.03em; line-height: 1; }
  .pricing-anchor__value span { font-size: var(--fs-lg); font-weight: 400; color: rgba(255,255,255,0.42); }
  .pricing-anchor__note { font-family: var(--font-body); font-size: var(--fs-xs); color: rgba(255,255,255,0.38); margin-bottom: var(--sp-3); line-height: 1.5; }
  .pricing-anchor__link { display: inline-flex; align-items: center; gap: var(--sp-2); font-size: var(--fs-sm); font-weight: 600; color: var(--cyan); transition: gap var(--t-fast), color var(--t-fast); }
  .pricing-anchor__link:hover { gap: var(--sp-3); color: var(--sky); }

  @media (max-width: 1024px) {
    .contact-layout { grid-template-columns: 1fr; }
    .contact-sidebar { position: static; flex-direction: row; flex-wrap: wrap; }
    .sidebar-card { flex: 1; min-width: 260px; }
  }
  @media (max-width: 640px) {
    .contact-hero { padding-block: var(--sp-16) var(--sp-12); }
    .contact-form { padding: var(--sp-6); }
    .contact-card__header { padding: var(--sp-6); }
    .contact-form__grid { grid-template-columns: 1fr; }
    .contact-sidebar { flex-direction: column; }
    .sidebar-card { min-width: unset; }
    .form-chips { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form    = document.getElementById('contact-form') as HTMLFormElement | null;
  const tsField = document.getElementById('form-ts') as HTMLInputElement | null;
  if (tsField) tsField.value = String(Date.now());
  const card    = document.getElementById('contact-card') as HTMLElement | null;
  const success = document.getElementById('contact-success') as HTMLElement | null;
  const submitBtn   = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label') as HTMLElement | null;
  const submitSpinner = document.getElementById('submit-spinner') as HTMLElement | null;
  const errorBanner  = document.getElementById('form-error-banner') as HTMLElement | null;
  const errorMessage = document.getElementById('form-error-message') as HTMLElement | null;

  function setFieldError(fieldId: string, message: string) {
    const field = document.getElementById(fieldId) as HTMLInputElement | HTMLTextAreaElement | null;
    const error = document.getElementById(`${fieldId}-error`);
    field?.classList.toggle('is-invalid', !!message);
    if (error) error.textContent = message;
  }

  function clearErrors() {
    ['name', 'email', 'website', 'company', 'project'].forEach(id => setFieldError(id, ''));
    const serviceErr  = document.getElementById('service-error');
    const timelineErr = document.getElementById('timeline-error');
    if (serviceErr)  serviceErr.textContent  = '';
    if (timelineErr) timelineErr.textContent = '';
    if (errorBanner) errorBanner.classList.remove('is-visible');
  }

  function validate(data: FormData): HTMLElement | null {
    let firstInvalid: HTMLElement | null = null;
    const remember = (el: HTMLElement | null) => { if (el && !firstInvalid) firstInvalid = el; };

    if (!(data.get('name') as string)?.trim()) {
      setFieldError('name', 'Dinos tu nombre, por favor.');
      remember(document.getElementById('name'));
    }

    const email = (data.get('email') as string)?.trim();
    if (!email) {
      setFieldError('email', 'Sin correo no podremos escribirte.');
      remember(document.getElementById('email'));
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      setFieldError('email', 'Este correo no nos cuadra. ¿Lo revisas?');
      remember(document.getElementById('email'));
    }

    const website = (data.get('website') as string)?.trim();
    if (!website) {
      setFieldError('website', 'Indícanos la web de tu empresa, así llegamos preparados.');
      remember(document.getElementById('website'));
    } else {
      try {
        const url = new URL(website);
        if (url.protocol !== 'http:' && url.protocol !== 'https:') {
          setFieldError('website', 'La dirección debe empezar por https:// o http://');
          remember(document.getElementById('website'));
        }
      } catch {
        setFieldError('website', 'Esta dirección parece incompleta. Algo como https://heliobio.es');
        remember(document.getElementById('website'));
      }
    }

    if (!(data.get('company') as string)?.trim()) {
      setFieldError('company', '¿Cómo se llama tu empresa?');
      remember(document.getElementById('company'));
    }

    const services = data.getAll('service') as string[];
    if (services.length === 0) {
      const serviceErr = document.getElementById('service-error');
      if (serviceErr) serviceErr.textContent = 'Marca al menos un servicio para saber por dónde empezar.';
      remember(document.querySelector<HTMLInputElement>('input[name="service"]'));
    }

    const timeline = data.get('timeline') as string | null;
    if (!timeline) {
      const timelineErr = document.getElementById('timeline-error');
      if (timelineErr) timelineErr.textContent = '¿Para cuándo te gustaría arrancar, más o menos?';
      remember(document.querySelector<HTMLInputElement>('input[name="timeline"]'));
    }

    if (!(data.get('project') as string)?.trim()) {
      setFieldError('project', 'Unas líneas sobre tu proyecto nos ayudarán a preparar una respuesta útil.');
      remember(document.getElementById('project'));
    }

    return firstInvalid;
  }

  function focusInvalid(el: HTMLElement) {
    const wrapper =
      el.closest('.form-group') ??
      el.closest('.form-chips') ??
      el.closest('.form-checklist') ??
      el;
    wrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
    window.setTimeout(() => {
      try { el.focus({ preventScroll: true }); } catch { el.focus(); }
    }, 80);
  }

  /* ── Paquetes: poblar la lista según los servicios elegidos ── */
  type PackageOpt = { value: string; label: string; price: string };
  const packageData: Record<string, PackageOpt[]> = JSON.parse(
    (document.getElementById('package-data') as HTMLScriptElement | null)?.textContent || '{}'
  );
  const preselect: { service: string; package: string } = JSON.parse(
    (document.getElementById('preselect-data') as HTMLScriptElement | null)?.textContent || '{}'
  );

  const packageList = document.getElementById('package-list');
  const packageHint = document.getElementById('package-hint');

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function populatePackages(selectedServices: string[], preselectedValues: string[] = []) {
    if (!packageList) return;

    const existing = new Set<string>(
      Array.from(packageList.querySelectorAll<HTMLInputElement>('input[name="package"]:checked')).map(el => el.value)
    );
    preselectedValues.forEach(v => v && existing.add(v));

    const seen = new Set<string>();
    const merged: PackageOpt[] = [];
    selectedServices.forEach(svc => {
      (packageData[svc] || []).forEach(opt => {
        if (!seen.has(opt.value)) { seen.add(opt.value); merged.push(opt); }
      });
    });

    if (!merged.length) {
      packageList.innerHTML = '<p class="form-checklist__empty">Primero marca un servicio.</p>';
      return;
    }

    packageList.innerHTML = merged.map(opt => {
      const checked = existing.has(opt.value) ? 'checked' : '';
      const price = opt.price ? `<span class="form-check__price">${escapeHtml(opt.price)}</span>` : '';
      return `
        <label class="form-check">
          <input type="checkbox" name="package" value="${escapeHtml(opt.value)}" class="form-check__input" ${checked} />
          <span class="form-check__inner">
            <span class="form-check__box" aria-hidden="true"></span>
            <span class="form-check__label">${escapeHtml(opt.label)}</span>
            ${price}
          </span>
        </label>
      `;
    }).join('');
  }

  function getSelectedServices(): string[] {
    return Array.from(document.querySelectorAll<HTMLInputElement>('input[name="service"]:checked')).map(el => el.value);
  }

  document.querySelectorAll<HTMLInputElement>('input[name="service"]').forEach(input => {
    input.addEventListener('change', () => populatePackages(getSelectedServices()));
  });

  const initialServices = getSelectedServices();
  if (initialServices.length) {
    populatePackages(initialServices, preselect.package ? [preselect.package] : []);
    if (packageHint && preselect.package) {
      packageHint.innerHTML = 'Preseleccionado desde la página de precios. Cámbialo si hace falta.';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const data = new FormData(form);
    const invalid = validate(data);
    if (invalid) {
      focusInvalid(invalid);
      return;
    }

    if (submitBtn)     submitBtn.disabled = true;
    if (submitLabel)   submitLabel.textContent = 'Enviando tu mensaje…';
    if (submitSpinner) submitSpinner.style.display = 'inline-block';

    try {
      const res = await fetch('/api/contact', { method: 'POST', body: data });
      const json = await res.json();

      if (res.ok) {
        if (card)    card.style.display = 'none';
        if (success) success.classList.add('is-visible');
      } else {
        if (errorBanner)  errorBanner.classList.add('is-visible');
        if (errorMessage) errorMessage.textContent = json.error ?? 'El envío no se ha completado. Inténtalo de nuevo en un momento.';
      }
    } catch {
      if (errorBanner)  errorBanner.classList.add('is-visible');
      if (errorMessage) errorMessage.textContent = 'Parece un problema de conexión. Revisa tu red e inténtalo otra vez.';
    } finally {
      if (submitBtn)     submitBtn.disabled = false;
      if (submitLabel)   submitLabel.textContent = 'Enviar mi mensaje';
      if (submitSpinner) submitSpinner.style.display = 'none';
    }
  });
</script>
