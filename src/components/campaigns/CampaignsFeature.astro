---
/**
 * Campaigns, the Nuvora app's module that gathers the material of one
 * LinkedIn push under a name and a brief. Body of /campaigns and its twins,
 * /fr/campagnes and /zh/campaigns (English, French and Chinese only, the
 * languages of the app and of its captures; see CAMPAIGNS_LANGS in
 * src/i18n/index.ts).
 *
 * Every claim comes from the app (the Campaigns module of the Nuvora app)
 * and from this site's help article on campaigns (src/content/help/<lang>/
 * campaigns.md). The captures are the help center's, already in
 * public/images/help/, one per language. No price appears here: campaigns
 * themselves are free, and what reads them is billed as usual.
 *
 * Layout only: the copy comes from the locale page (see ./types.ts).
 */
import FAQ from '../FAQ.astro';
import type { CampaignsCopy } from './types';

interface Props {
  copy: CampaignsCopy;
  lang: 'en' | 'fr' | 'zh';
  guideHref: string;
}

const { copy, lang, guideHref } = Astro.props;

// The help center's captures, in the page's language.
const suffix = lang === 'en' ? '' : `.${lang}`;
const shot = (name: string) => `/images/help/${name}${suffix}.webp`;

const tileIcons = [
  // One file, several campaigns
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="1.6"/></svg>`,
  // Remove without risk
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke="currentColor" stroke-width="1.6"/><path d="M9 13.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
  // Delete without loss
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  // Always the latest version
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M21 4v5h-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
];

const readerIcons = [
  // Ask
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>`,
  // Agents
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="8" width="16" height="12" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M12 8V4M9 14h.01M15 14h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`,
  // Write from it
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
];

const check = `<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 5L6.5 11.5 3 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const arrow = `<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<!-- ═══════════════════════════════════════════════════════
     HERO: the promise, and the Campaigns page beside it
     ═══════════════════════════════════════════════════════ -->
<section class="cp-hero" aria-labelledby="cp-hero-h">
  <div class="cp-hero__glow" aria-hidden="true"></div>
  <div class="container cp-hero__layout">
    <div class="cp-hero__content">
      <p class="eyebrow eyebrow--light reveal">{copy.hero.eyebrow}</p>
      <h1 id="cp-hero-h" class="cp-hero__h1 reveal reveal-delay-1" set:html={copy.hero.h1Html} />
      <p class="cp-hero__lede reveal reveal-delay-2">{copy.hero.lede}</p>
      <div class="cp-hero__actions reveal reveal-delay-3">
        <a href="#cp-holds" class="btn btn--primary btn--lg">{copy.hero.primary}</a>
        <a href={guideHref} class="btn btn--outline-white btn--lg">{copy.hero.secondary}</a>
      </div>
    </div>

    <figure class="cp-shot cp-shot--hero reveal reveal-delay-2">
      <div class="cp-shot__bar" aria-hidden="true"><span></span><span></span><span></span></div>
      <img
        src={shot('campaigns-list')}
        alt={copy.hero.shotAlt}
        width="1440"
        height="900"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     WHAT GOES IN
     ═══════════════════════════════════════════════════════ -->
<section class="section cp-holds" id="cp-holds" aria-labelledby="cp-holds-h">
  <div class="container cp-two">
    <div class="reveal">
      <span class="cp-label">{copy.holds.label}</span>
      <h2 id="cp-holds-h" class="cp-h2" set:html={copy.holds.h2Html} />
      <div class="cp-body">
        {copy.holds.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="cp-panel reveal reveal-delay-2">
      <p class="cp-panel__title">{copy.holds.listTitle}</p>
      <ul class="cp-checks" role="list">
        {copy.holds.list.map((item) => (
          <li><span class="cp-checks__icon" set:html={check} />{item}</li>
        ))}
      </ul>
      <dl class="cp-facts">
        {copy.holds.facts.map(([label, value]) => (
          <div class="cp-facts__item">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     POINTERS, NOT COPIES
     ═══════════════════════════════════════════════════════ -->
<section class="section cp-pointers" aria-labelledby="cp-pointers-h">
  <div class="container">
    <div class="cp-head reveal">
      <span class="cp-label">{copy.pointers.label}</span>
      <h2 id="cp-pointers-h" class="cp-h2" set:html={copy.pointers.h2Html} />
      <p class="cp-intro">{copy.pointers.intro}</p>
    </div>
    <div class="cp-tiles">
      {copy.pointers.tiles.map((tile, i) => (
        <div class={`cp-tile reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
          <span class="cp-tile__icon" set:html={tileIcons[i]} />
          <strong class="cp-tile__title">{tile.title}</strong>
          <p class="cp-tile__body">{tile.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     WHO READS IT: Ask, agents, a post's brief
     ═══════════════════════════════════════════════════════ -->
<section class="section cp-readers" id="cp-readers" aria-labelledby="cp-readers-h">
  <div class="cp-readers__bg" aria-hidden="true"></div>
  <div class="container">
    <div class="cp-head reveal">
      <span class="cp-label cp-label--dark">{copy.readers.label}</span>
      <h2 id="cp-readers-h" class="cp-h2 cp-h2--dark" set:html={copy.readers.h2Html} />
      <p class="cp-intro cp-intro--dark">{copy.readers.intro}</p>
    </div>

    <figure class="cp-shot cp-shot--wide reveal">
      <div class="cp-shot__bar" aria-hidden="true"><span></span><span></span><span></span></div>
      <img src={shot('campaigns-page')} alt={copy.readers.shotAlt} width="1440" height="900" loading="lazy" decoding="async" />
    </figure>

    <div class="cp-readers__cards">
      {copy.readers.cards.map((card, i) => (
        <div class={`cp-reader reveal${i > 0 ? ` reveal-delay-${i}` : ''}`}>
          <span class="cp-reader__icon" set:html={readerIcons[i]} />
          <span class="cp-reader__tag">{card.tag}</span>
          <h3 class="cp-reader__title">{card.title}</h3>
          <p class="cp-reader__body">{card.body}</p>
        </div>
      ))}
    </div>

    <p class="cp-example reveal" set:html={copy.readers.exampleHtml} />
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     FILL IT AS YOU WORK
     ═══════════════════════════════════════════════════════ -->
<section class="section cp-filling" aria-labelledby="cp-filling-h">
  <div class="container">
    <div class="cp-head reveal">
      <span class="cp-label">{copy.filling.label}</span>
      <h2 id="cp-filling-h" class="cp-h2" set:html={copy.filling.h2Html} />
      <p class="cp-intro">{copy.filling.intro}</p>
    </div>
    <div class="cp-filling__grid">
      <ol class="cp-ways" role="list">
        {copy.filling.items.map((item, i) => (
          <li class={`cp-way reveal${i > 0 ? ` reveal-delay-${Math.min(i, 3)}` : ''}`}>
            <strong class="cp-way__title">{item.title}</strong>
            <p class="cp-way__body">{item.body}</p>
          </li>
        ))}
      </ol>
      <figure class="cp-shot cp-shot--light reveal reveal-delay-2">
        <div class="cp-shot__bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <img src={shot('assets-library-add-to-campaign')} alt={copy.filling.shotAlt} width="1440" height="900" loading="lazy" decoding="async" />
      </figure>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     NOT AN AD CAMPAIGN
     ═══════════════════════════════════════════════════════ -->
<section class="section section--sm cp-notads" aria-labelledby="cp-notads-h">
  <div class="container">
    <div class="cp-notads__card reveal">
      <span class="cp-notads__label">{copy.notAds.label}</span>
      <h2 id="cp-notads-h" class="cp-notads__h2" set:html={copy.notAds.h2Html} />
      <p class="cp-notads__body">{copy.notAds.body}</p>
      <a href={copy.notAds.link.href} class="cp-arrow-link">{copy.notAds.link.label}<Fragment set:html={arrow} /></a>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════════════════
     WHO DOES WHAT
     ═══════════════════════════════════════════════════════ -->
<section class="section cp-roles" aria-labelledby="cp-roles-h">
  <div class="container cp-two cp-two--top">
    <div class="reveal">
      <span class="cp-label">{copy.roles.label}</span>
      <h2 id="cp-roles-h" class="cp-h2" set:html={copy.roles.h2Html} />
      <p class="cp-intro">{copy.roles.intro}</p>
      <p class="cp-note" set:html={copy.roles.noteHtml} />
    </div>
    <dl class="cp-rolelist reveal reveal-delay-2">
      {copy.roles.rows.map((row) => (
        <div class="cp-rolelist__row">
          <dt>{row.role}</dt>
          <dd>{row.can}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>


<FAQ
  id="cp-faq"
  eyebrow={copy.faq.eyebrow}
  heading={copy.faq.heading}
  faqs={copy.faq.items}
  background="var(--off-white)"
/>


<!-- ═══════════════════════════════════════════════════════
     CLOSE
     ═══════════════════════════════════════════════════════ -->
<section class="section cp-close" aria-labelledby="cp-close-h">
  <div class="container">
    <div class="cp-close__inner reveal">
      <h2 id="cp-close-h" class="cp-close__h2" set:html={copy.close.h2Html} />
      <p class="cp-close__body">{copy.close.body}</p>
      <div class="cp-close__actions">
        <a href={copy.close.primary.href} class="btn btn--outline-white btn--lg">{copy.close.primary.label}</a>
        <a href={copy.close.secondary.href} class="btn btn--ghost cp-close__ghost">{copy.close.secondary.label}</a>
      </div>
    </div>
  </div>
</section>


<style>
  /* ╔═══════════════════════════════════════════╗
     ║  HERO                                     ║
     ╚═══════════════════════════════════════════╝ */
  .cp-hero {
    position: relative;
    overflow: hidden;
    background: var(--deep-navy);
    padding-block: var(--sp-24) var(--sp-20);
  }
  .cp-hero__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 70% at 100% 0%, rgba(6,182,212,.16) 0%, transparent 60%),
      radial-gradient(ellipse 45% 60% at 0% 100%, rgba(3,105,161,.18) 0%, transparent 60%);
  }
  .cp-hero__layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--sp-12);
    align-items: center;
  }
  .cp-hero__h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    font-weight: 700;
    color: var(--white);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-block: var(--sp-5) var(--sp-6);
  }
  .cp-hero__h1 :global(.text-gradient) {
    background: linear-gradient(135deg, var(--cyan) 0%, var(--sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .cp-hero__lede {
    font-size: var(--fs-md);
    color: rgba(255,255,255,0.72);
    line-height: 1.75;
    max-width: 560px;
    margin-bottom: var(--sp-10);
  }
  .cp-hero__actions { display: flex; flex-wrap: wrap; gap: var(--sp-4); }

  /* A capture in a browser frame */
  .cp-shot {
    margin: 0;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--white);
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: 0 30px 70px rgba(0,0,0,0.35);
  }
  .cp-shot img { display: block; width: 100%; height: auto; }
  .cp-shot__bar {
    display: flex;
    gap: 6px;
    padding: 10px 14px;
    background: #E8EDF3;
    border-bottom: 1px solid var(--border);
  }
  .cp-shot__bar span { width: 9px; height: 9px; border-radius: 50%; background: var(--border-2); }
  .cp-shot--hero { transform: perspective(1600px) rotateY(-4deg); transform-origin: left center; }
  .cp-shot--wide { max-width: 1040px; margin-inline: auto; margin-bottom: var(--sp-12); }
  .cp-shot--light { border-color: var(--border); box-shadow: var(--shadow-lg); }


  /* ╔═══════════════════════════════════════════╗
     ║  SHARED SECTION PARTS                     ║
     ╚═══════════════════════════════════════════╝ */
  .cp-label {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 600;
    color: var(--blue);
    letter-spacing: -0.01em;
    margin-bottom: var(--sp-3);
    padding-bottom: var(--sp-2);
    border-bottom: 3px solid var(--cyan);
  }
  .cp-label--dark { color: var(--cyan); border-bottom-color: rgba(6,182,212,.40); }

  .cp-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.18;
    letter-spacing: -0.01em;
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .cp-h2 :global(.text-gradient) {
    background: linear-gradient(135deg, var(--blue) 0%, var(--sky) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .cp-h2--dark { color: var(--white); }
  .cp-h2--dark :global(.text-gradient) {
    background: linear-gradient(135deg, var(--cyan) 0%, var(--sky) 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .cp-head { max-width: 760px; margin-bottom: var(--sp-12); }
  .cp-intro { font-size: var(--fs-md); color: var(--text-2); line-height: 1.75; }
  .cp-intro--dark { color: rgba(255,255,255,0.68); }

  .cp-body { display: flex; flex-direction: column; gap: var(--sp-4); }
  .cp-body p { font-size: var(--fs-md); color: var(--text-2); line-height: 1.75; }

  .cp-note { margin-top: var(--sp-6); font-size: var(--fs-sm); color: var(--text-2); line-height: 1.7; }
  .cp-note :global(a),
  .cp-example :global(a) {
    color: var(--blue);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .cp-note :global(a:hover) { color: var(--sky); }

  .cp-two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-16);
    align-items: center;
  }
  .cp-two--top { align-items: start; }

  .cp-panel {
    padding: var(--sp-8);
    background: var(--off-white);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
  }
  .cp-panel__title {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: var(--sp-5);
  }

  .cp-checks { display: flex; flex-direction: column; gap: var(--sp-3); }
  .cp-checks li {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    font-size: var(--fs-base);
    color: var(--text);
    line-height: 1.55;
  }
  .cp-checks__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px; height: 24px;
    margin-top: 1px;
    border-radius: var(--r-sm);
    background: rgba(6,182,212,0.10);
    color: var(--blue);
  }

  .cp-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4) var(--sp-6);
    margin-top: var(--sp-8);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
  }
  .cp-facts dt {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 2px;
  }
  .cp-facts dd { font-size: var(--fs-sm); color: var(--text); line-height: 1.5; }

  .cp-arrow-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--blue);
    transition: gap var(--t-fast), color var(--t-fast);
  }
  .cp-arrow-link:hover { gap: var(--sp-3); color: var(--sky); }


  /* ╔═══════════════════════════════════════════╗
     ║  SECTIONS                                 ║
     ╚═══════════════════════════════════════════╝ */
  .cp-holds { background: var(--white); }

  .cp-pointers { background: var(--off-white); }
  .cp-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-5);
  }
  .cp-tile {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-8) var(--sp-6);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    position: relative;
    overflow: hidden;
    transition: border-color var(--t-base), box-shadow var(--t-base), transform var(--t-base);
  }
  .cp-tile::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--sky), var(--cyan));
    opacity: 0;
    transition: opacity var(--t-base);
  }
  .cp-tile:hover { border-color: rgba(3,105,161,.18); box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .cp-tile:hover::before { opacity: 1; }
  .cp-tile__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px; height: 44px;
    margin-bottom: var(--sp-2);
    border-radius: var(--r-lg);
    background: linear-gradient(135deg, rgba(3,105,161,.08), rgba(6,182,212,.06));
    color: var(--sky);
  }
  .cp-tile__title { font-size: var(--fs-lg); font-weight: 600; color: var(--text); }
  .cp-tile__body { font-size: var(--fs-sm); color: var(--text-2); line-height: 1.7; }

  .cp-readers { background: var(--deep-navy); position: relative; overflow: hidden; }
  .cp-readers__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 60% at 0% 100%, rgba(6,182,212,.12) 0%, transparent 60%),
      radial-gradient(ellipse 40% 50% at 100% 0%, rgba(3,105,161,.10) 0%, transparent 60%);
  }
  .cp-readers .container { position: relative; z-index: 1; }
  .cp-readers__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5);
  }
  .cp-reader {
    display: flex;
    flex-direction: column;
    padding: var(--sp-8) var(--sp-6);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: var(--r-xl);
  }
  .cp-reader__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px; height: 40px;
    border-radius: var(--r-lg);
    background: rgba(6,182,212,0.14);
    color: var(--cyan);
    margin-bottom: var(--sp-4);
  }
  .cp-reader__tag {
    align-self: flex-start;
    padding: 0.2rem 0.65rem;
    font-size: var(--fs-xs);
